{
	// Format and lint configuration for the hand-written TypeScript and JavaScript of
	// the TypeScript SDK (sdk/ts), the hand-written tests of the generated types export
	// (gen/ts/tests), and the repository's own scripts (scripts/). The version is pinned
	// in sdk/ts/package.json and its lockfile.
	//
	// Only those trees are included. The generated code under gen/ts (wire/schemas.ts,
	// vocab and strict, which scripts/gen-sdk-types.sh and `buf generate` write) is
	// outside them, and so are the hand-written gen/ts/wire/base.ts and names.ts beside
	// it. The documentation site (website/) has its own toolchain and is out of scope.
	// JSON is not included: the conformance corpora are byte-compared against their Go
	// emitters.
	"$schema": "./sdk/ts/node_modules/@biomejs/biome/configuration_schema.json",
	"root": true,
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"includes": ["sdk/ts/**/*.ts", "sdk/ts/**/*.mjs", "gen/ts/tests/**/*.ts", "scripts/**/*.ts", "scripts/**/*.mjs"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		// 120 is the width the existing code is closest to: of 80, 100, 120 and 140
		// it changes the fewest lines.
		"lineWidth": 120
	},
	"javascript": {
		"formatter": { "quoteStyle": "double" }
	},
	"assist": {
		"enabled": true,
		"actions": { "source": { "organizeImports": "on" } }
	},
	"linter": {
		"enabled": true,
		"rules": { "recommended": true }
	}
}
