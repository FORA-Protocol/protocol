{
	// Format and lint configuration for the hand-written TypeScript, JavaScript and
	// Astro: the TypeScript SDK (sdk/ts), the hand-written code and tests of the
	// generated types export (gen/ts), the repository's own scripts (scripts/) and
	// the documentation site (website/). The gates are scripts/gates/gate-ts-format.sh
	// and scripts/gates/gate-ts-lint.sh; the version is pinned in sdk/ts/package.json
	// and its lockfile.
	//
	// `includes` takes every TypeScript, JavaScript and Astro file and then removes
	// exactly the generated ones, so a hand-written file anywhere is formatted and
	// linted: gen/ts/wire/schemas.ts, gen/ts/vocab and gen/ts/strict, which
	// scripts/gen-sdk-types.sh and `buf generate` write. The hand-written
	// gen/ts/wire/base.ts and names.ts beside them are included. JSON is not
	// included: the conformance corpora are byte-compared against their Go emitters.
	//
	// `html.experimentalFullSupportEnabled` makes biome read an Astro component
	// whole: its frontmatter, its template and its styles. Without it biome reads
	// only the frontmatter, and reports every import and variable that only the
	// template uses as unused. The HTML formatter is enabled with it, so the
	// template is formatted too; no other HTML file is included. Its whitespace
	// sensitivity is strict: it adds no whitespace after `>` or before `<` where
	// there is none, and keeps some where there is. It still rewraps text, which
	// changes the whitespace of the built page, so compare the built site before
	// and after reformatting a component.
	"$schema": "./sdk/ts/node_modules/@biomejs/biome/configuration_schema.json",
	"root": true,
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"includes": [
			"**/*.ts",
			"**/*.mts",
			"**/*.js",
			"**/*.mjs",
			"**/*.astro",
			"!gen/ts/wire/schemas.ts",
			"!gen/ts/wire/version.ts",
			"!gen/ts/vocab",
			"!gen/ts/strict"
		]
	},
	"html": {
		"experimentalFullSupportEnabled": true,
		"formatter": { "enabled": true, "whitespaceSensitivity": "strict" }
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		// 120 is the width the existing code is closest to: of 80, 100, 120 and 140
		// it changes the fewest lines.
		"lineWidth": 120
	},
	"javascript": {
		"formatter": { "quoteStyle": "double" }
	},
	"assist": {
		"enabled": true,
		"actions": { "source": { "organizeImports": "on" } }
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			// Size and complexity limits. The parameter and function-length limits are
			// this repository's own choice, as AGENTS.md records; cognitive complexity
			// 15 is the default of the tools that measure it, and biome measures no
			// cyclomatic complexity. They apply to tests as to any other file: a test is
			// code that has to be read and kept. A file's length is checked by
			// scripts/gates/gate-file-length.sh, the one file-length check for every
			// language, so biome's noExcessiveLinesPerFile is not enabled.
			"complexity": {
				"noExcessiveCognitiveComplexity": { "level": "error", "options": { "maxAllowedComplexity": 15 } },
				"useMaxParams": { "level": "error", "options": { "max": 5 } },
				"noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 60 } }
			}
		}
	}
}
