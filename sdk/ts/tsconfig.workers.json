{
  // Typechecks every edge-safe module against the Cloudflare Workers runtime types
  // alone: no Node types and no DOM lib, so a DOM-only API, or a Web API the Workers
  // types declare differently, is a compile error here. Run by `npm test` before
  // vitest. The Workers types declare Buffer and process as `any` (for nodejs_compat),
  // so this check does not catch them; tests/edge-imports.guard.test.ts does, and also
  // walks the same entry points' import graphs and fails on a node: or undici import.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Same zod pin as tsconfig.json: the generated wire schemas live outside this
    // package tree and cannot reach its node_modules by walking up.
    "paths": {
      "zod": ["./node_modules/zod"]
    },
    "lib": ["ES2023"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src/**/*", "core/**/*", "hono/**/*", "resolvers/edge.ts"]
}
