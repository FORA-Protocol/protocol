const FORA_ANSWERS = [
  { title: 'Who it is.', text: h('Every FORA request is signed with Web Bot Auth, with a key the agent\'s own domain publishes [12].') },
  { title: 'Whom it acts for.', text: h('The buyer is the agent\'s own account. An agent can label the end customer it buys for, but FORA never treats that label as identity [12].') },
  { title: 'What it may do.', text: h('The license. The Exchange signs each offer, and its terms are those "the parties agree to when the agent accepts the offer" [11].') },
  { title: 'Who pays.', text: 'The agent\'s account, billed by the Exchange\'s operator, which pays you under its own rules.' },
];

const FAQ = [
  { q: 'How should I treat ChatGPT\'s agent when it acts for my subscriber?', a: h('As two things. Its signature tells you it\'s ChatGPT\'s agent [13]. Whether it may read your subscriber\'s articles takes the subscriber\'s own sign-in, through your login or Sign in with ChatGPT [5, 7].') },
  { q: 'Is OAuth a rival to Web Bot Auth?', a: h('No. OAuth carries permission, and Web Bot Auth carries identity. The Web Bot Auth registry draft even accepts an app\'s OAuth self-description as a valid "Signature Agent Card" [4].') },
  { q: 'Which of these can my CDN check?', a: h('Cloudflare and AWS WAF check Web Bot Auth signatures; Akamai, HUMAN and Vercel check those of ChatGPT\'s cloud browser [3, 13, 14]. Mastercard says its registry can be checked "through your edge provider" [16].') },
