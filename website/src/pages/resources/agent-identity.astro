  ['Decentralized identifiers (DIDs), did:web', h('The controller of an identifier controls it "without requiring permission from any other party" [30]. did:web keeps the keys on a website, as Web Bot Auth does [31]'), 'Identity and credential programs', 'Not for bot traffic'],
  ['Verifiable credentials', h('Claims an issuer signs about someone, "such as a driver\'s license or an education certificate" [32]'), 'Credential programs; a registry could vouch for an agent\'s operator this way', 'Not for bot traffic'],
