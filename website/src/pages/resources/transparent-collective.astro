  { title: 'A legal mandate, and enforcement.', text: `CLA, PLS, DPCMO and Kopinor are regulated: the law sets what they must disclose, and a supervisor oversees them. DPCMO is ${a(SRC.dpcmoOpenai, 'suing OpenAI')}, and ILC's participation agreement lets it sue unlicensed AI companies in a publisher's name. FORA is a protocol. It has no mandate, and it takes no one to court.` },
  { title: 'Copies AI companies already hold.', text: `ILC's license reaches content that AI companies already hold, "acquired before the RSL declaration was published", says ${a(SRC.ilcGuide, 'its guide')}. RSL is the format ILC uses for that declaration. CCC, CLA, Kopinor and NDP license training. A pool on FORA licenses what leaves a fetch record, and a model trained on a copy it already holds leaves none.` },
  { title: 'A vote.', text: `DPCMO's members vote in a general assembly, as its ${a(SRC.dpcmoReport, 'transparency report')} sets out. FORA leaves governance to each operator.` },
];

const FAQ = [
  { q: 'What does it cost to run a collective on FORA?', a: 'FORA is free. Each collective chooses how it prices its service.' },
  { q: 'Can I keep one AI company out?', a: 'Yes. Scope your terms to the AI companies you license. Any you leave out get no offer.' },
  { q: 'Does FORA hold the pool\'s money?', a: 'No. The operator collects the fees and pays publishers through its own payment provider. The protocol signs and records. It never moves money.' },
  { q: 'Can I stay in ILC and join a collective on FORA?', a: `ILC allows it. Its ${a(SRC.ilcFaq, 'FAQ')} says: "Participation is non-exclusive. You keep the right to license your content directly to anyone, and any existing licensing deals remain unchanged." If you want an ILC licensee to pay through a FORA collective, exclude it in ILC first.` },
  { q: 'Does a collective on FORA license training?', a: 'No. The pool licenses uses that start with a fetch, such as AI answers and search. A model that trains on a copy it holds fetches nothing, so no record exists to check its report against. You can still license training on your own priced term.' },
  { q: 'Why would an AI company join?', a: 'For one license to many publishers and one report format. It also gets licensed access to each member\'s pages, where an AI company outside the collective meets a per-fetch price or a block. No law makes it join.' },
];

const SOURCES = [
  {
    name: 'The Internet Licensing Collective',
    items: [
      { title: 'ILC launches with Yahoo Scout as first commercial partner', publisher: 'Internet Licensing Collective, press release', href: SRC.ilcPress },
      { title: 'For publishers', publisher: 'Internet Licensing Collective', href: SRC.ilcPublishers },
      { title: 'Frequently asked questions', publisher: 'Internet Licensing Collective', href: SRC.ilcFaq },
      { title: 'Publisher Onboarding Guide', publisher: 'Internet Licensing Collective', href: SRC.ilcGuide },
      { title: 'Publisher Participation Agreement, version 1.0', publisher: 'Internet Licensing Collective', where: 'No public URL: the agreement ILC\'s publisher portal asks publishers to accept' },
      { title: 'ILC Royalty Distribution Policy', publisher: 'Internet Licensing Collective', where: 'No public URL: shown to publishers in ILC\'s publisher portal' },
    ],
  },
  {
    name: 'ProRata and Perplexity',
    items: [
      { title: 'Partner agreement for Gist', publisher: 'ProRata.ai', href: SRC.prorataTerms },
      { title: 'For publishers and creators', publisher: 'ProRata.ai', href: SRC.prorataPublishers },
      { title: 'Introducing Comet Plus', publisher: 'Perplexity', href: SRC.cometPlus },
      { title: 'Announcing Comet Plus launch partners', publisher: 'Perplexity', href: SRC.cometPartners },
      { title: 'Pricing', publisher: 'Perplexity', href: SRC.pplxPricing },
      { title: 'How Perplexity\'s new revenue model works', publisher: 'Digiday', href: SRC.pplxDigiday },
      { title: 'CNN sues Perplexity', publisher: 'TheWrap', href: SRC.cnnSuit },
    ],
  },
  {
    name: 'CCC, CLA and PLS',
    items: [
      { title: 'AI Systems Training License: overview', publisher: 'Copyright Clearance Center', href: SRC.cccSheet },
      { title: 'PLS offers new collective AI licensing opportunity to publishers', publisher: 'Publishers\' Licensing Services', href: SRC.plsNews },
      { title: 'Distribution Charter', publisher: 'Publishers\' Licensing Services', href: SRC.plsCharter },
      { title: 'PLS opt-in licences: flyer', publisher: 'Publishers\' Licensing Services', href: SRC.plsFlyer },
    ],
  },
  {
    name: 'DPCMO and Kopinor',
    items: [
      { title: 'Transparency report 2025 (in Danish)', publisher: 'DPCMO', href: SRC.dpcmoReport },
      { title: 'ProRata partners with DPCMO', publisher: 'DPCMO', href: SRC.dpcmoProrata },
      { title: 'A united Danish media industry takes OpenAI to court', publisher: 'DPCMO', href: SRC.dpcmoOpenai },
      { title: 'Agreement on the use of copyright-protected material in the training of Norwegian language models', publisher: 'Kopinor and the National Library of Norway', href: SRC.kopinorAgreement },
      { title: 'Kopinor\'s largest payout ever (in Norwegian)', publisher: 'Kopinor, via NTB', href: SRC.kopinorPayout },
    ],
  },
  {
    name: 'NDP Nieuwsmedia and GPT-NL',
    items: [
      { title: 'Dutch news publishers contribute to developing GPT-NL', publisher: 'IO+', href: SRC.ndpNews },
      { title: 'Content Contributor Agreement (template)', publisher: 'TNO, GPT-NL', href: SRC.gptnlTemplate },
      { title: 'Annex 2: Training Content Protocol', publisher: 'TNO, GPT-NL', href: SRC.gptnlProtocol },
      { title: 'Annex 3: Governance Charter', publisher: 'TNO, GPT-NL', href: SRC.gptnlCharter },
      { title: 'Annex 6: Revenue Sharing Mechanism', publisher: 'TNO, GPT-NL', href: SRC.gptnlRevenue },
    ],
  },
  {
    name: 'FORA',
    items: [
      { title: 'Licensing terms', publisher: 'FORA documentation', href: '/protocol/licensing-terms/' },
      { title: 'Transaction flow', publisher: 'FORA documentation', href: '/protocol/transaction-flow/' },
      { title: 'How money flows', publisher: 'FORA documentation', href: '/getting-started/how-money-flows/' },
      { title: 'Protocol reference', publisher: 'FORA documentation', href: '/reference/proto-fora/' },
    ],
  },
];
---
<LandingLayout
  title="A fair licensing collective — FORA resources"
  description="What a fair AI licensing collective looks like for a web publisher: your own terms, a signed record of every fetch, a published formula, and a share you can recompute. With a scorecard of the eight schemes running or announced today."
>
  <AudienceHero
    current="resources"
    badge="Resource · For publishers"
    title="A fair<br><em>licensing collective.</em>"
    sub="One license, many publishers, one pool of money. A collective is fair when each member can see what the pool collects and check its own share. This page sets a collective on FORA beside the eight schemes running or announced today."
    updated={resourceUpdated('/resources/transparent-collective/')}
  >
    <a href="#how" class="btn btn-primary">How it works</a>
    <a href="#scorecard" class="btn btn-ghost">The scorecard</a>
  </AudienceHero>

  <div class="tc">
    <Band
      tone="light"
      id="how"
      label="Follow one article"
      title="Same money. Open boxes."
      lead="A trade group, a publisher alliance or a company working for one runs the collective as its operator. Follow one article through a pool today and through a collective on FORA."
    >
      <ArticleJourney {...JOURNEY} />
      <p class="keyline"><strong>{SELECTION}</strong> <a href="#selection">Who decides</a></p>
      <div class="formula">
        <div>
          <h3>The formula behind step 3</h3>
          <p>Each AI company pays the greater of a share of its own revenue and a floor per fetch, up to a cap, so the pool never falls below the floor. The formula and the per-fetch floor are published; each AI company's rate and cap are in its agreement with the operator.</p>
        </div>
        <div class="formula-card" role="figure" aria-label="The pool formula">
          <p class="formula-head"><span>The pool, each period</span><span>formula and floor published</span></p>
          <dl>
            {FORMULA.map((f) => (
              <>
                <dt>{f.label}</dt>
                <dd>{f.parts.map((part) => <><span>{part}</span>{' '}</>)}</dd>
              </>
            ))}
          </dl>
        </div>
      </div>
      <p class="evidence-line">Every claim on this page, with the quote and the source behind it: <a href={EVIDENCE}>the evidence</a>.</p>
    </Band>

    <Band
      tone="light"
      id="today"
      label="Today"
      title="How collectives run today"
      lead="Eight schemes pool publishers' content for AI companies, or pay publishers from a pool. Each is described here from its own documents."
    >
      <div class="schemes">
        {SCHEMES.map((s) => (
          <article class:list={['scheme', { wide: s.wide }]}>
            <p class="scheme-tag">{s.tag}</p>
            <h3>{s.name}</h3>
            <p set:html={s.text} />
          </article>
        ))}
      </div>
      <p class="aside-note">Music has run on pools for decades: a streaming service is a licensing collective with a player on top. <a href="/resources/music-dsp/">See how it maps onto FORA</a>.</p>
    </Band>

    <Band
      tone="light"
      id="world"
      label="Elsewhere"
      title="Around the world"
      lead="What publishers' bodies elsewhere are doing about AI licensing, one line each."
    >
      <div class="world">
        {WORLD.map((g) => (
          <section class="world-region">
            <h3>{g.region}</h3>
            <ul>
              {g.items.map((it) => (
                <li>
                  <span class="world-tag">{it.tag}</span>
                  <span><b>{it.who}</b> <Fragment set:html={it.text} /></span>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
      <p class="aside-note">Publishers' associations in Europe and Asia are asking AI platforms for transparency and equal treatment. The <a href={SRC.zurich}>Zurich declaration</a> of the German-speaking countries' publishers' associations says platforms "dürfen weder eigene Inhalte noch Inhalte einzelner Medien privilegieren": they may favor neither their own content nor that of individual outlets.</p>
    </Band>

    <Band
      tone="light"
      id="scorecard"
      label="The scorecard"
      title="Eight questions the collectives answer differently"
      lead="A question is in the table only if the eight schemes differ from each other on it. The last column describes a collective run on FORA."
    >
      <Scorecard label="Eight collective licensing schemes and a collective on FORA, compared on eight questions" columns={SCORE.columns} rows={SCORE.rows} />
      <p class="aside-note">"Not stated" and "not found" mean the scheme's public pages don't say. These schemes compete as ways to pool content, and they can run side by side: six of the eight say participation is non-exclusive.</p>
    </Band>

    <Band
      tone="light"
      id="adds"
      label="Beyond the table"
      title="What FORA adds"
      lead="No scheme's public documents offer these."
    >
      <ul class="points">
        {ADDS.map((it) => <li><span><b>{it.title}</b> {it.text}</span></li>)}
      </ul>
      <p class="aside-note">One limit holds everywhere, FORA included. A record proves the fetch. What a model did with the page afterward comes from the AI company's report, and an audit checks it.</p>
    </Band>

    <Band tone="light" id="selection" label="Selection" title="Who decides which publisher gets used">
      <div class="prose">
        <p><strong>No scheme publishes how an AI system picks whose content to use in an answer.</strong> An AI company pays the same fee whichever publisher its system picks, so the split between publishers follows the pick.</p>
        <p>Where the schemes say, the buyer decides. ProRata's and Perplexity's own engines choose the sources. ILC's public pages, its agreement and its policy don't say how a licensee chooses. GPT-NL comes closest, for training only: it publishes how TNO filters and weights each contributor's text. One contract names the picker:</p>
        <PullQuote
          quote="The National Library shall determine which publications are used in the training of the various language models."
          who="Kopinor and the National Library of Norway"
          source="training agreement"
          href={SRC.kopinorAgreement}
        />
        <p>On FORA, the operator runs the search, and licensing is per URL. The operator writes the ranking rule, so the collective holds it and can publish it. Gutefrage, which runs FORA on helpster.de, uses the Elasticsearch search engine. The search only proposes URLs: each fetch is licensed on its publisher's terms, and the AI company's model still decides what to cite.</p>
      </div>
    </Band>

    <Band tone="light" id="ahead" label="What FORA lacks" title="Where others are ahead of FORA">
      <ul class="points plain">
        {AHEAD.map((it) => <li><span><b>{it.title}</b> <Fragment set:html={it.text} /></span></li>)}
      </ul>
    </Band>

    <Band tone="light" id="faq" label="Questions" title="Questions publishers ask">
      <FaqGrid items={FAQ} />
    </Band>

    <Band tone="light" id="sources" label="Sources" title="Where each claim comes from">
      <p class="evidence-line first">The quote behind each claim is on <a href={EVIDENCE}>the evidence page</a>.</p>
      <details class="all-sources">
        <summary>All sources ({SOURCES.reduce((n, g) => n + g.items.length, 0)})</summary>
        <SourceList groups={SOURCES} compact />
      </details>
    </Band>
  </div>

  <ClosingCta
    title="Ask your collective <em>these questions.</em>"
    text="Take the scorecard's eight questions to any collective you're weighing. If you run a collective, see how one works on FORA."
  >
    <a href="#scorecard" class="btn btn-primary">The eight questions</a>
    <a href="/getting-started/how-money-flows/" class="btn btn-ghost">How money flows</a>
    <a href="/getting-started/for-exchange-operators/" class="btn btn-ghost">For Exchange operators</a>
  </ClosingCta>
</LandingLayout>

<style>
  /* Readability, scoped to this page: every content band is light, bands
     alternate between two light grounds, and body text is 18px. Band's own
     defaults are untouched; the overrides reach the components through .tc. */
  .tc :global(.band) { --lp-text: #2e2e3c; --lp-label: #55556a; --sc-bg: #fff; background: #fff; border-top: 1px solid #e4e4ec; }
  .tc :global(.band:nth-of-type(even)) { background: #f5f5f9; }
  .tc :global(.band-lead) { font-size: 1.25rem; line-height: 1.6; max-width: 42rem; }
  .tc :global(.faq) { gap: 2rem 3.5rem; }
  .tc :global(.faq h3) { font-size: 1.25rem; line-height: 1.35; }
  .tc :global(.faq p) { font-size: 1.125rem; line-height: 1.7; }
  .tc :global(.pq figcaption) { font-size: 1rem; }
  .tc :global(.src h3) { font-size: 0.875rem; }
  .tc :global(.src.compact a), .tc :global(.src.compact li > b) { font-size: 1.0625rem; }
  .tc :global(.src.compact .src-meta), .tc :global(.src .src-url) { font-size: 0.9375rem; }
  /* The scorecard has ten columns: on a wide screen the table runs wider than
     the text column, so its cells hold 15px text. */
  @media (min-width: 1101px) {
    .tc :global(#scorecard .sc-wrap) { margin-inline: min(0px, calc((1100px - min(100vw - 4rem, 1360px)) / 2)); }
  }

  h3 { font-size: 1.375rem; font-weight: 700; letter-spacing: -0.015em; line-height: 1.25; color: var(--lp-heading); margin: 0 0 0.75rem; }
  p { color: var(--lp-text); font-size: 1.125rem; line-height: 1.7; margin: 0 0 1.125rem; }
  p a, .scheme :global(a), .points :global(a) { color: var(--lp-link); }
  .prose { max-width: 42rem; }
  .prose p:last-child { margin-bottom: 0; }
  .prose strong, .keyline strong { color: var(--lp-strong); font-weight: 700; }
  .keyline { max-width: 46rem; margin: 2.5rem 0 0; padding: 1.25rem 1.5rem; border-left: 4px solid var(--lp-link); border-radius: 0 10px 10px 0; background: rgba(79, 109, 245, 0.08); font-size: 1.3125rem; line-height: 1.5; }
  .keyline a { font-size: 1.125rem; font-weight: 600; white-space: nowrap; }
  .keyline a::after { content: ' →'; }
  .aside-note { max-width: 44rem; margin: 2rem 0 0; font-size: 1.0625rem; color: var(--lp-label); }
  .evidence-line { margin: 2rem 0 0; font-size: 1.0625rem; color: var(--lp-label); }
  .evidence-line.first { margin-top: 0; }
  .all-sources { margin-top: 1.5rem; }
  .all-sources summary { display: inline-block; padding: 0.625rem 1rem; border: 1px solid var(--lp-rule); border-radius: 8px; background: #fff; font-size: 1.0625rem; font-weight: 600; color: var(--lp-heading); cursor: pointer; list-style: none; }
  .all-sources summary::-webkit-details-marker { display: none; }
  .all-sources summary::after { content: ' +'; color: var(--lp-link); }
  .all-sources[open] summary::after { content: ' −'; }
  .formula { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 3rem; align-items: center; margin-top: 3.5rem; }
  .formula p { margin: 0; }
  .formula-card { border: 1px solid var(--lp-rule); border-radius: 12px; background: #fff; overflow: hidden; }
  .formula-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.25rem 1rem; margin: 0; padding: 0.875rem 1.25rem; border-bottom: 1px solid var(--lp-rule); font: 500 0.875rem var(--mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--lp-label); }
  .formula-card dl { display: grid; gap: 0.375rem; margin: 0; padding: 1.25rem; font-family: var(--mono); }
  .formula-card dt { font-size: 0.9375rem; color: var(--lp-link); }
  .formula-card dd { margin: 0 0 0.875rem; font-size: 1rem; line-height: 1.6; color: var(--lp-heading); }
  .formula-card dd:last-child { margin-bottom: 0; }
  .formula-card dd span { white-space: nowrap; }
  .schemes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; margin-top: 2.5rem; }
  .scheme { padding: 1.75rem; border: 1px solid var(--lp-rule); border-radius: 12px; background: #fff; min-width: 0; }
  .scheme.wide, .scheme:last-child:nth-child(even) { grid-column: 1 / -1; }
  .scheme p { margin: 0; overflow-wrap: break-word; }
  .scheme .scheme-tag { font: 500 0.875rem var(--mono); letter-spacing: 0.06em; text-transform: uppercase; line-height: 1.4; color: var(--lp-link); margin-bottom: 0.625rem; }
  .scheme.wide p:not(.scheme-tag), .scheme:last-child:nth-child(even) p:not(.scheme-tag) { max-width: 46rem; }
  .world { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; align-items: start; margin-top: 2.5rem; }
  .world-region { padding: 1.5rem 1.75rem; border: 1px solid var(--lp-rule); border-radius: 12px; background: #fff; min-width: 0; }
  .world-region:first-child { grid-row: span 3; }
  .world-region h3 { font-size: 1.25rem; margin-bottom: 1rem; }
  .world-region ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.125rem; }
  .world-region li { display: grid; gap: 0.25rem; color: var(--lp-text); font-size: 1.0625rem; line-height: 1.6; overflow-wrap: break-word; }
  .world-region b { color: var(--lp-strong); font-weight: 700; }
  .world-region :global(a) { color: var(--lp-link); }
  .world-tag { font: 500 0.875rem var(--mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--lp-link); }
  /* The same look as PointList, for lists whose text carries links. */
  .points { list-style: none; margin: 2rem 0 0; padding: 0; display: grid; gap: 1.25rem; max-width: 44rem; }
  .points li { display: grid; grid-template-columns: auto 1fr; gap: 0.75rem; color: var(--lp-text); font-size: 1.125rem; line-height: 1.7; }
  .points li::before { content: '✓'; color: var(--lp-link); font-weight: 700; }
  .points.plain li::before { content: '→'; color: var(--lp-label); font-weight: 400; }
  .points b { color: var(--lp-strong); font-weight: 700; }
  @media (max-width: 900px) {
    .formula { grid-template-columns: 1fr; gap: 1.5rem; }
    .schemes, .world { grid-template-columns: 1fr; }
    .world-region:first-child { grid-row: auto; }
  }
  @media (max-width: 560px) {
    .keyline { padding: 1rem 1.125rem; font-size: 1.1875rem; }
    .scheme, .world-region { padding: 1.25rem; }
    /* One piece of the formula per line, the continuation lines indented. */
    .formula-card dd span { display: block; }
    .formula-card dd span + span { padding-left: 1.25rem; }
    .formula-card dd { font-size: 0.9375rem; }
  }
</style>
