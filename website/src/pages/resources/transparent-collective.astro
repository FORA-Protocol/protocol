// The page's main point, stated once here and once in the selection section.
const SELECTION = 'None of the eight schemes below publishes how an AI system picks whose content to use in an answer, and in a pool split by use that pick decides who gets paid.';

// The opening diagram: one article, followed through a pool today and through
// a collective on FORA. "A pool today" sums up the eight schemes, so each cell
// is worded to hold for all eight (scorecard.md, matrix rows 9, 13 to 17, 24).
const JOURNEY = {
  title: 'Your article is used in an AI answer',
  columns: ['A pool today', 'A collective on FORA'] as [string, string],
  input: {
    label: 'What you put in',
    today: { main: 'The uses the scheme defines: every AI use, or a fixed list.' },
    fora: { main: 'Your own terms, as simple or as detailed as you want.' },
  },
  steps: [
    {
      label: 'Picked',
      today: { main: 'The AI company\'s or the operator\'s own system', sub: 'No scheme publishes how it picks for an answer' },
      fora: { main: 'The operator\'s search', sub: 'The operator can publish the method' },
    },
    {
      label: 'Counted',
      today: { main: 'The payer\'s own report or engine', sub: 'Or no count at all' },
      fora: { main: 'A signed record of every fetch', sub: 'The payer didn\'t write it' },
    },
    {
      label: 'Split',
      today: { main: 'Undisclosed rules or weights', sub: 'In seven of the eight schemes' },
      fora: { main: 'A published formula and published weights' },
    },
    {
