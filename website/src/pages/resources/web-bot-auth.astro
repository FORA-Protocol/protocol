      src("Minutes, IETF 126 webbotauth session", "IETF", "https://datatracker.ietf.org/doc/minutes-126-webbotauth/"),
      src("Call for adoption of draft-meunier-webbotauth-httpsig-protocol, and the chairs' decision", "IETF web-bot-auth mailing list", "https://mailarchive.ietf.org/arch/msg/web-bot-auth/IHIsC9v_WDK_fv2SalA4KeMl8GI/"),
      src("Re: Harms", "Mark Nottingham, IETF web-bot-auth mailing list", "https://mailarchive.ietf.org/arch/msg/web-bot-auth/5wm6ZdVbl-hb48_GE7XCnJaRICE/"),
      src("The Free and Open Web Is Under Attack at the IETF", "EFF", "https://www.eff.org/deeplinks/2026/06/free-and-open-web-under-attack-ietf"),
