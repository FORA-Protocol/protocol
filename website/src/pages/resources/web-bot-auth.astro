const HOW = [
  { text: h('The agent\'s operator creates a key pair. The private key stays with the agent. The public key goes into the key directory, a small file on the operator\'s website [1].') },
  { text: h(`The agent signs each request and adds three headers. ${c('Signature-Agent')} names its website. ${c('Signature-Input')} lists what the signature covers, which key made it and when it expires. ${c('Signature')} carries the signature itself [1].`) },
  { text: h(`To cover the body, the agent also sends ${c('Content-Digest')}, a hash of the body, and signs it with the rest. A changed body no longer matches its hash, and a changed hash breaks the signature [1, 2].`) },
  { text: h(`Your site, or your CDN, fetches the key directory from the website ${c('Signature-Agent')} names, takes the key with the matching ID and checks the signature. If it verifies, a key that website publishes signed the request, and nothing the signature covers was changed on the way [1, 2].`) },
];

const KEY_DIRECTORY = {
  tag: 'What is a key directory?',
  text: h(`A small file on the agent's website, usually at ${c('/.well-known/http-message-signatures-directory')}, listing the public keys the agent signs with. Whoever controls the website controls the file, so the website stands behind the keys. The website's address is the agent's identity: the keys in the file can change, and sites still recognize the agent [1].`),
};

const TAKEAWAY = 'Web Bot Auth tells you which website an agent signs for, and only a holder of that website\'s keys can sign in its name. It\'s for agents that want to be known, and they\'re the ones you can sell to. A bot that wants to stay hidden simply doesn\'t sign.';

const WHY = [
  { title: 'You can set terms per agent.', text: h('Sell to it, slow it down, serve it differently or refuse it, by its website\'s address [1].') },
  { title: 'You know who you\'re dealing with.', text: h('Anyone can type a user agent, and a cloud IP address is shared by everyone who rents from that cloud [1]. A signature names the website behind the agent.') },
  { title: 'A leaked signature expires.', text: h('A signature works only at the site it was made for, and only until it expires: at most a day by the draft\'s advice, and often a minute [1, 12]. Cover the path and a hash of the body, and it fits one request. A leaked password or API key works wherever it\'s accepted until someone revokes it.') },
  { title: 'A page you sell stays sold to one buyer.', text: h('On FORA, the link to a sold page works only for the agent that holds the buyer\'s key, so a copied link fetches nothing [7].') },
  { title: 'No passwords or API keys to issue.', text: h('An agent can open an account on its first signed request, with no sign-up form. You keep only public keys, and a public key can\'t sign anything [1, 2]. The draft calls a secret shared with every site "impractical to scale" and "insecure, as key rotation is challenging" [1].') },
  { title: 'It doesn\'t cover the crawlers in your licensing talks.', text: h(`GPTBot, ClaudeBot, PerplexityBot and Googlebot don't sign [13, 14, 15, 16]. Hidden crawlers stay hidden too. For those, robots.txt, IP lists and contracts remain the tools. ${a('/resources/ai-crawlers/', 'How to control which bots get in →')}`) },
];

