      src("Identity Service", "FORA documentation", "/components/identity/overview/"),
    ],
  },
  {
    name: "Identity and authorization",
    items: [
      src("RFC 6749: The OAuth 2.0 Authorization Framework", "IETF", "https://www.rfc-editor.org/rfc/rfc6749"),
      src("RFC 9068: JSON Web Token (JWT) Profile for OAuth 2.0 Access Tokens", "IETF", "https://www.rfc-editor.org/rfc/rfc9068"),
      src("RFC 6750: The OAuth 2.0 Authorization Framework: Bearer Token Usage", "IETF", "https://www.rfc-editor.org/rfc/rfc6750"),
      src("RFC 9449: OAuth 2.0 Demonstrating Proof of Possession (DPoP)", "IETF", "https://www.rfc-editor.org/rfc/rfc9449"),
      src("RFC 7523: JWT Profile for OAuth 2.0 Client Authentication and Authorization Grants", "IETF", "https://www.rfc-editor.org/rfc/rfc7523"),
