const MORE = [
  { href: '/resources/standards-map/', text: 'The standards map' },
  { href: '/resources/ai-crawlers/', text: 'How to control which bots get in' },
  { href: '/resources/content-marketplaces/', text: 'Content marketplaces and FORA' },
];
---
<LandingLayout
  title="Web Bot Auth: how an AI agent proves who it is — FORA resources"
  description="An AI agent can sign every request with a key its own domain publishes. Who signs, what it lets your site decide, what changes in your stack, and how FORA uses it."
>
  <AudienceHero
    current="resources"
    badge="Resources · Identity"
    title="An AI agent can prove who it is. <em>No email, no password.</em>"
    sub="With Web Bot Auth, an AI agent proves who it is on its first request to a site, with no sign-up form and no password. A site that checks the signature can open an account for it right away. The agent signs every request with a key its own domain publishes, so there's no shared secret to phish or leak. You decide which domains you deal with."
    updated={resourceUpdated(HREF)}
  >
    <a href="#stack" class="btn btn-primary">What changes for your site</a>
    <a href="#fora" class="btn btn-ghost">How FORA uses it</a>
    <a href="#engineers" class="hero-eng">Building an agent? The detail for engineers &rarr;</a>
  </AudienceHero>

  <Band tone="near" title="Know which agent is asking, without a password">
    <Callout kind="takeaway" tag="Key takeaway">
      <p class="takeaway">{TAKEAWAY}</p>
    </Callout>
    <Split aside="400px">
      <div>
        <p class="prose" set:html={`An agent that needs an account at a site goes through what a person does. It fills in a sign-up form, gives an email address, clicks a confirmation link, sets a password, and often copies an API key into its configuration. Each site issues its own secret. Any of them can be phished, reused or leaked in a breach, and someone has to rotate it ${cite(1)}.`} />
        <p class="prose" set:html={`Web Bot Auth takes the shared secret away. The agent creates a key pair, publishes the public half in a key directory on its own domain, and signs each request with the private half. The draft from the IETF, the internet's standards body, makes this one of its two constraints: "Require no pre-established relationship between the two" ${cite(1)}.`} />
        <p class="prose" set:html={`A site that has never seen the agent reads the directory's address from the first request, fetches the key and checks the signature. It then knows which domain's key signed the request, and it can open an account right there. The site keeps only public keys, so a breach of its database gives nobody anything to sign with. Each signature carries its own expiry, and covering the method, path and body narrows it to one request ${cite(1)}.`} />
      </div>
      <Figure
        slot="aside"
        src={`${IMG}/wba-1.png`}
        title="Two ways to open an account."
        alt="Two ways for an agent to open an account at a site. With a password: a sign-up form, an email address, a confirmation link, a password and an API key, one after another. Each can be phished, reused or leaked, and someone has to rotate it. With Web Bot Auth: a key directory on the agent's domain holds its public key. A signed request goes to the site, which fetches the key from the directory and can open an account. To rotate, the agent publishes a new key beside the old one."
      />
    </Split>
    <Callout kind="define" {...KEY_DIRECTORY} />
  </Band>

  <Band tone="light" id="signers" label="Who signs" title="Some agents sign. The big crawlers don't." lead="Agent browsers, hosted browsers and a long tail of small operators' bots sign. The large training and search crawlers identify themselves by user agent, reverse DNS and published IP lists.">
    <ResourceTable label="Who signs with Web Bot Auth" cols={['Who', 'What signs, or doesn\'t', 'How you can tell']} rows={SIGNERS} />
    <p class="prose" set:html={`Radar also lists signing bots and agents from DuckDuckGo, You.com and Spotify, each with a key directory that answers ${cite(7)}.`} />
  </Band>

  <Band label="How much is signed" title="Few agent sessions are signed. ChatGPT agent signs at scale.">
    <KeyFacts items={KEY_FACTS} />
    <p class="prose">Radar is Cloudflare's directory of the bots it knows, so it shows who can sign. Arkose's report measures signed traffic, on its own network.</p>
  </Band>

  <Band tone="near" id="stack" label="What changes in your stack" title="Your CDN or bot vendor checks the signature">
    <p class="prose" set:html={`Your site signs nothing. It can check signatures itself or leave that to the CDN or proxy in front of it ${cite(1)}.`} />
    <PointList tone="neutral" items={STACK} />
    <Callout kind="define" {...DEFINITIONS.signedLink} />
  </Band>

  <Band tone="light" id="how" title="How it works: three headers and one file">
    <p class="prose" set:html={`A signed request carries three extra headers. One names the agent's key directory. One lists the parts of the request the signature covers, when it was made and when it expires. The third is the signature. The format comes from RFC 9421, the IETF standard for HTTP message signatures. Web Bot Auth adds which parts a bot must sign and how a site finds the key ${cite(1, 2)}.`} />
    <StepList items={HOW} />
    <p class="prose" set:html={`The address is the identity, and the key is replaceable. An agent rotates by publishing a new key beside the old one, signing with it, and removing the old one once it expires. Its name stays with the address, and so do its accounts at sites that key accounts on it ${cite(1)}.`} />
    <Callout kind="define" {...SIGNATURE_AGENT} />
  </Band>

  <Band id="proves" title="What a signature proves, and what stays with you">
    <Split aside="400px">
      <div>
        <p class="prose" set:html={`A valid signature proves one thing: a key from this directory signed these parts of this request, inside this time window. The draft says what it leaves out. The signature "says nothing about who operates the Agent, whether the Agent is benign, or whether the request is authorized. Those are origin policy" ${cite(1)}. The draft calls the site the origin.`} />
        <p class="prose" set:html={`The rest is the site's to answer. Which company runs the agent comes from a contract, a registry that reviews applicants, or the details a marketplace asks for at sign-up. The domain only shows who controls an address. A signed crawler can crawl too fast. The signature says which domain is asking, and your terms say what it may take. Inside its window, a signed request can be sent again unless the site remembers what it has seen ${cite(1)}.`} />
      </div>
      <Figure
        slot="aside"
        src={`${IMG}/wba-3.png`}
        title="What a valid signature proves."
        alt="What a valid Web Bot Auth signature proves, and what is left to the site. The signature proves that a key from this directory signed these parts of this request, inside this time window. The rest is the site's: which company runs the agent, whether the agent is benign, what it may take, and whether the request is sent again."
      />
    </Split>
    <Callout kind="caution" points={CAUTIONS} />
  </Band>

  <Band tone="near" id="authz" label="Identity and authorization" title="A signature says who is asking. What it may do comes on top.">
    <p class="prose" set:html={`Many systems hand out identity and permission in one token. An OAuth access token names the client and carries its scopes, the list of what it may do, and a JWT access token carries them as a claim ${cite(32, 33)}. So the two are easy to mix up. Web Bot Auth carries only the first: a signature has no scopes ${cite(1)}.`} />
    <p class="prose" set:html={`A token a site issues at sign-up mixes the two. "Any party in possession of the token" can use it "in any way that any other party in possession of it can" ${cite(34)}. Whoever copies it is the agent, with the agent's rights.`} />
    <ResourceTable label="Three kinds of credential compared" cols={['', 'A token issued at sign-up', 'OAuth or a JWT', 'Web Bot Auth']} rows={AUTHZ} labelAll />
    <p class="prose" set:html={`What the agent may do travels with the request or comes from an earlier step. An OAuth token carries scopes. A Biscuit token can be narrowed by whoever holds it, "without communicating with the service that created the token", and it "will never gain more rights", as with macaroons ${cite(37)}. OAuth's security best practice says servers "SHOULD use mechanisms for sender-constraining access tokens", such as DPoP, so a stolen token is useless without its key ${cite(35, 38)}.`} />
    <p class="prose" set:html={`On FORA the two are separate signed objects. The agent's signature says which domain is asking ${cite(25)}. What it may do with a page is the license: an offer the Exchange signs, whose terms "the parties agree to when the agent accepts the offer" ${cite(26)}. The signed link that follows carries the license to your CDN, bound to the buyer's key ${cite(24)}.`} />
  </Band>

  <Band tone="light" id="allow" label="If you know the bot, you choose whom you serve" title="Your allow list is the domains you want to deal with">
    <Split aside="400px">
      <div>
        <p class="prose">Your readers and search crawlers reach your open pages as before. The allow list is only for the pages you sell access to.</p>
        <p class="prose" set:html={`Once a domain is verified, anyone can base a decision on it. The draft says sites "can log, rate limit, allowlist, or block the URL the way they do IP addresses and User-Agent today" ${cite(1)}. Nobody can sign for the domain without one of its private keys. IP addresses are shared across cloud customers, and anyone can type a user agent ${cite(1)}.`} />
        <p class="prose">So keep a list of the domains you want to sell to. A request whose signature fails gets nothing on those pages, and so does a domain your list doesn't name.</p>
        <p class="prose" set:html={`You can keep the list yourself or start from a vendor's. In Cloudflare's dashboard you set an action for Search, Agent and Training traffic, and for "the top Personal Agents" ${cite(54)}. The bots come from Cloudflare's own reviewed registry ${cite(17)}. A registry draft from Cloudflare and Amazon also defines a shared list: plain text, one URL per line. Anyone can publish one, and a site "MAY manually add" its entries to its own ${cite(55)}.`} />
      </div>
      <Figure
        slot="aside"
        src={`${IMG}/wba-4.png`}
        title="The approved accounts."
        alt="An Exchange's accounts, each with a checkbox: one domain approved, one new domain held for approval. A signed request from the approved domain can buy. A request whose signature fails gets nothing. A signed request from the new domain can't buy until it's approved. Beside them, a deny list: domains are cheap. Readers and search crawlers reach your open pages as before."
      />
    </Split>
    <p class="prose" set:html={`On FORA, the list is an Exchange's accounts, and each account belongs to a domain. The Exchange's operator can open new accounts at once or hold them for approval, and can switch any account off ${cite(27, 28)}. You choose the Exchanges that sell your pages and set your terms there. If you run your own Exchange, as Gutefrage does, the approval is yours.`} />
    <Callout kind="define" {...DEFINITIONS.exchange} />
    <p class="prose">A deny list is weaker: it stops one domain, and domains are cheap. The draft agrees:</p>
    <PullQuote
      quote="Nothing stops an Agent from abandoning a URL and standing up another one, and the protocol does not try to prevent this. It targets honest clients that want to be recognised across requests."
      who="IETF webbotauth working group"
      source="draft-ietf-webbotauth-httpsig-protocol-01, §4.1"
      href={S.draft01}
    />
    <p class="prose" set:html={`An agent that registers again under the same domain gets back the same account, in the same state. A new domain is a new identity. Where the operator holds new accounts for approval, it can't buy anything until it's approved. The approval can ask for what a domain doesn't prove, such as a legal name and a VAT number ${cite(27, 29)}.`} />
    <Callout kind="search" id="search-traffic" text={SEARCH_FORA.text} links={SEARCH_FORA.links} />
  </Band>

  <Band id="debate" label="The argument over who gets in" title="Engineers agree on signing and argue about who gets in">
    <p class="prose" set:html={`The working group has chosen its technical starting point. In May 2026 it decided to work on anonymous approaches in parallel with identity ${cite(56)}. At IETF 126 in July, the room backed the signing draft as the starting direction, 22 to 6 ${cite(57)}. The group adopted it on September 1, 2026 ${cite(58)}.`} />
    <p class="prose" set:html={`The supporters are the companies that handle bot traffic at scale. Engineers from Google, Anthropic, Shopify, Amazon, Stytch and the BBC backed adoption on the list, and the draft's authors work at Cloudflare and Google ${cite(1, 58)}. Their case is cheap, certain checks and less blocking of innocent traffic by IP. Mark Nottingham, who wrote a use-cases draft for the group, says IP-based arrangements are opaque, and an authentication infrastructure can "put some daylight on those arrangements" ${cite(59)}.`} />
    <p class="prose" set:html={`The critics are civil-society groups and the research and scraping side. They fear sites will pick whom to let in by name, whatever a bot does. The EFF wrote in June 2026 ${cite(60)}:`} />
    <PullQuote
      quote="If sites restrict crawling to a preapproved list of cryptographically authenticated bots, they could require licensing payments from those wishing to crawl their sites. This would close off the open web to researchers, archivists, and startups without the ability to pay for automated access."
      who="EFF"
      source="The Free and Open Web Is Under Attack at the IETF, June 2026"
      href={S.eff}
    />
    <p class="prose" set:html={`Writing on the working group's list, Mirja Kühlewind warned that once enough sites block everything unsigned, "at some point there might not be a choice anymore" ${cite(61)}. A domain key is also a stable identifier: the draft says it lets sites correlate requests "including across origins" ${cite(1)}. Cloudflare, whose engineer is the draft's first author, wrote that "Infrastructure for proving properties can become infrastructure for requiring properties" ${cite(62)}.`} />
    <p class="prose" set:html={`Signing can't name a bot that won't sign, so publishers who want hidden crawlers named are turning to law. New York's legislature passed a Stealth Crawler Prohibition Act in June 2026 with the News/Media Alliance's support ${cite(63, 64)}. In August, the EFF and 18 groups asked the governor to veto it ${cite(65)}.`} />
    <p class="prose" set:html={`On FORA, an agent signs when it uses FORA to find or buy licensed content ${cite(25)}. Reading and search stay open, and nobody signs to read a public page. A buying agent is recognizable at every Exchange it uses ${cite(1)}.`} />
  </Band>

  <Band tone="near" id="layers" label="Other ways to identify an agent, and where Web Bot Auth fits" title="Other schemes answer the other questions">
    <Split aside="400px">
      <div>
        <p class="prose">Web Bot Auth answers one question: which domain's key signed this request? An agent that buys also has to show whom it acts for, what it may do and who pays. Some sites ask whether a real person stands behind it. Different schemes answer each, and they stack.</p>
        <details class="more">
          <summary>Eleven other schemes</summary>
          <PointList tone="neutral" items={LAYERS} />
        </details>
        <p class="prose">Web Bot Auth fits at the bottom: one identity per key directory, on the operator's own domain, that anyone can check.</p>
      </div>
      <Figure
        slot="aside"
        src={`${IMG}/wba-5.png`}
        title="The identity layers."
        alt="Five layers of agent identity, bottom to top. Network hints: user agents, IP lists and reverse DNS, drawn dashed. Which domain's key signed it: Web Bot Auth, drawn heaviest, with Client ID Metadata Document, and also mTLS and AAuth. Whom it acts for, and whether a real person stands behind it: Sign in with ChatGPT, World ID. What it may do: MCP, Okta Cross App Access, Entra Agent ID. Who pays: Visa Trusted Agent Protocol and Mastercard Agent Pay, on the same signatures as Web Bot Auth. Anonymous credentials sit beside the identity and real-person layers."
      />
    </Split>
  </Band>

  <Band tone="light" id="fora" label="How FORA uses Web Bot Auth" title="Every FORA request is signed. An agent's domain is its account.">
    <Split aside="400px">
      <div>
        <p class="prose" set:html={`Every party in FORA signs its requests with a key its own domain publishes ${cite(25)}. For an agent that buys content:`} />
        <StepList fora items={FORA_STEPS} />
      </div>
      <Figure
        slot="aside"
        src={`${IMG}/wba-6.png`}
        title="How a FORA agent registers and buys."
        alt="How a FORA agent registers and buys, across the key directory on the agent's domain, the agent, the Exchange, FORA's edge function on your CDN (Workers, Fastly Compute or Lambda@Edge) and your site. The agent sends a signed registration to the Exchange, which fetches the key from the key directory; the account belongs to the domain. The agent sends a signed purchase, and the Exchange returns a signed link that names the buyer's key. The agent sends the signed link and its public key to the edge function, which checks that it holds that key, and your site serves the page. A copied link fetches nothing."
      />
    </Split>
    <p class="prose" set:html={`The draft defines no revocation, so FORA adds a revocation list. A directory can name one, FORA verifiers check it every five minutes, and each party's list revokes only its own keys ${cite(25)}.`} />
    <p class="prose" set:html={`An agent without a domain of its own can use FORA's Identity Service. It gives the agent its own subdomain, publishes the agent's key directory, keeps the private key and signs for the agent ${cite(31)}.`} />
  </Band>

  <Band id="engineers" title="The detail, for engineers">
    <Callout kind="engineers" collapse="Show the detail">
      <div class="eng">
        <h3>If you sign</h3>
        <ul>{ENG_SIGN.map((t) => <li set:html={t} />)}</ul>
        <p set:html={`A signed request, from draft -01's Ed25519 test vector (Appendix E.2.1) ${cite(1)}:`} />
        <pre><code>{SIGNED_REQUEST}</code></pre>
        <p set:html={`A directory request and response, from draft -01, Section 5.5.1 ${cite(1)}:`} />
        <pre><code>{DIRECTORY}</code></pre>
        <h3>If you verify</h3>
        <ul>{ENG_VERIFY.map((t) => <li set:html={t} />)}</ul>
        <h3>What FORA signs</h3>
        <ul>{ENG_FORA.map((t) => <li set:html={t} />)}</ul>
      </div>
    </Callout>
  </Band>

  <Band tone="near" title="Questions">
    <FaqGrid items={FAQ} />
  </Band>

  <Band tone="light" id="about">
    <Callout kind="about" points={ABOUT_FORA} columns />
    <section class="sources" id="sources" aria-labelledby="sources-label">
      <h2 class="end-label" id="sources-label">Sources</h2>
      <details class="all-sources" id="all-sources">
        <summary>All sources</summary>
        <SourceList groups={SOURCES} compact numbered />
      </details>
      <p class="note">Sources are checked on the date of publication.</p>
    </section>
    <section class="more-in" aria-labelledby="more-label">
      <h2 class="end-label" id="more-label">More in Resources</h2>
      <LinkRow links={MORE} stacked />
    </section>
  </Band>

  <ClosingCta
    title={TAGLINE}
    text="See what an agent would be offered for one of your pages through a FORA marketplace, which any company can run, or read how FORA agents sign."
  >
    <a href="/publishers/" class="btn btn-primary">See your offers</a>
    <a href="/protocol/authentication/" class="btn btn-ghost">How FORA agents sign</a>
  </ClosingCta>
</LandingLayout>

<script is:inline>
  // The sources sit in a closed <details>: a citation marker, or a link to
  // #src-N, opens it before the browser scrolls to the entry. The same script
  // as the standards map's.
  (function () {
    var box = document.getElementById('all-sources');
    if (!box) return;
    function open() {
      if (/^#src-\d+$/.test(location.hash) && !box.open) {
        box.open = true;
        var el = document.getElementById(location.hash.slice(1));
        if (el) el.scrollIntoView();
      }
    }
    window.addEventListener('hashchange', open);
    // A second click on the same marker fires no hashchange.
    document.addEventListener('click', function (e) {
      var link = e.target.closest && e.target.closest('a[href^="#src-"]');
      if (link) box.open = true;
    });
    open();
  })();
</script>

<style>
  /* Prose between components. The same few lines as on the TollBit page. */
  .prose { color: var(--lp-text); line-height: 1.65; max-width: 44rem; }
  .prose + .prose { margin-top: 1rem; }
  :global(*) + .prose { margin-top: 1.25rem; }
  .prose :global(a) { color: var(--lp-link); }
  .prose :global(b) { color: var(--lp-strong); font-weight: 600; }
