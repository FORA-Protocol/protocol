      src("Agentic Checkout RFC", "Agentic Commerce Protocol, on GitHub", "https://github.com/agentic-commerce-protocol/agentic-commerce-protocol/blob/7fdd78df677a94dce04c770644b0fbbb1401272b/rfcs/rfc.agentic_checkout.md"),
      src("Forget IPs: using cryptography to verify bot and agent traffic", "Cloudflare blog", "https://blog.cloudflare.com/web-bot-auth/"),
      src("Decentralized Identifiers (DIDs) v1.0", "W3C Recommendation", "https://www.w3.org/TR/did-1.0/"),
      src("did:web Method Specification", "W3C Credentials Community Group", "https://w3c-ccg.github.io/did-method-web/"),
      src("Authorization, revision 2026-07-28", "Model Context Protocol", "https://modelcontextprotocol.io/specification/2026-07-28/basic/authorization"),
      src("Integrate Sign in with ChatGPT", "OpenAI for developers", "https://developers.openai.com/commerce/guides/integrate-sign-in-with-chatgpt"),
      src("Agent Pass quickstart", "World", "https://docs.world.org/agent-pass/quickstart"),
