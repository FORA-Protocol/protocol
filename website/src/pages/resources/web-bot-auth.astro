const MORE = [
  { href: ID, text: 'How AI agents prove who they are, and what they may do' },
  { href: '/resources/standards-map/', text: 'The standards map' },
  { href: '/resources/ai-crawlers/', text: 'How to control which bots get in' },
  { href: '/resources/content-marketplaces/', text: 'Content marketplaces and FORA' },
];
---
<LandingLayout
  title="Web Bot Auth: a passwordless, cryptographic identity for AI agents — FORA resources"
  description="Web Bot Auth (WBA) gives an AI agent a passwordless identity: it signs every request, and your site checks the signature against a key on the agent's own website. How it works, who signs, how keys rotate, and what it changes for a publisher."
>
  <AudienceHero
    current="resources"
    badge="Resources · Identity"
    title="Web Bot Auth (WBA) is a passwordless, <em>cryptographically proven identity for AI agents.</em>"
    sub="The key idea: the agent signs every request with a private key that never leaves it, and your site checks the signature against the public key the agent publishes on its own website. A valid signature proves which website's key signed the request, and that the parts it covers weren't changed on the way. A password or API key proves only that the sender has a copy."
    updated={resourceUpdated(HREF)}
  >
    <a href="#how" class="btn btn-primary">How it works</a>
    <a href="#why" class="btn btn-ghost">What it changes for you</a>
    <a href="#engineers" class="hero-eng">Building an agent? The detail for engineers &rarr;</a>
    <Figure
      slot="aside"
      src={`${IMG}/wba-10.png`}
      title="A signed request."
      alt="A signed request, read top to bottom. The agent, which keeps its private key, sends a request: POST /buy, with four headers. Content-Digest: a hash of the body. Signature-Agent: agent.example. Signature-Input: what is signed, the key ID and the expiry. Signature: the signature. The request reaches your site, which fetches the public key from the key directory at agent.example/.well-known/ and checks that the public key verifies the signature."
    />
  </AudienceHero>

  <Band tone="near" id="how" label="How it works" title="How Web Bot Auth works">
    <Split aside="360px">
      <StepList items={HOW} />
      <div slot="aside"><Callout kind="define" {...KEY_DIRECTORY} /></div>
    </Split>
    <p class="prose" set:html={h('Only requests are signed. Your site answers as usual, and the one reply Web Bot Auth signs is the key directory itself [1]. FORA uses the same keys for two more signatures: the Exchange signs each offer, and the agent signs the offer it accepts, so neither the price nor the acceptance can change on the way [5, 6].')} />
    <p class="prose" set:html={h('A valid signature proves that much. In the draft\'s words, it "says nothing about who operates the Agent, whether the Agent is benign, or whether the request is authorized" [1]. Those are yours to decide.')} />
    <p class="prose" set:html={h('The draft comes from the IETF, the body that writes the internet\'s protocols. Its working group adopted it as the starting point on September 1, 2026, and it stays a draft until the group finishes it [3].')} />
  </Band>

  <Band tone="light" id="why" label="Why it matters" title="What it changes for a publisher">
    <Callout kind="takeaway" tag="Key takeaway">
      <p class="takeaway">{TAKEAWAY}</p>
    </Callout>
    <Split aside="400px">
      <PointList tone="neutral" items={WHY} />
      <Figure
        slot="aside"
        src={`${IMG}/wba-1.png`}
        title="Two ways to open an account."
        alt="Two ways for an agent to open an account at a site. With a password: a sign-up form, an email address, a confirmation link, a password and an API key, one after another. Each can be phished, reused or leaked, and someone has to rotate it. With Web Bot Auth: a key directory on the agent's domain holds its public key. A signed request goes to the site, which fetches the key from the directory and can open an account. To rotate, the agent publishes a new key beside the old one."
      />
    </Split>
  </Band>

  <Band id="signers" label="Who signs" title="Which agents sign" lead="Little agent traffic is signed yet, and most of what is comes from ChatGPT's agent. These agents sign, those still testing it included:">
    <ResourceTable label="Agents that sign with Web Bot Auth" cols={['Who', 'What signs', 'Status', 'How you can tell']} rows={SIGNERS} />
    <p class="prose" set:html={NON_SIGNERS} />
    <div class="facts"><KeyFacts items={KEY_FACTS} /></div>
  </Band>

  <Band tone="near" id="keys" label="Keys" title="Key directories, rotation and revocation">
    <Split aside="400px">
      <div>
        <p class="prose" set:html={h('The key directory itself is signed, once with each key it lists. Cloudflare\'s reason: it "ensures no one else can mirror your directory and attempt to register on your behalf". Cloudflare requires it before it registers a directory, and so does FORA [5, 12].')} />
        <p class="prose" set:html={h('Verifiers differ on when they read the directory. Cloudflare checks signatures only against keys registered with it in advance: the operator submits its directory through Cloudflare\'s bot submission form, and a signature from a key Cloudflare doesn\'t know gets a 401 [12]. Holding the keys beforehand means nothing is fetched while a request waits. The draft also lets a verifier fetch the directory when a signature arrives, and FORA does: an agent registers with no one, and FORA caches the keys it fetches [1, 5].')} />
        <p class="prose" set:html={h('Rotation is built in. The agent adds a new key next to the old one, starts signing with it, and removes the old key once it expires. Sites that knew the agent before still recognize it, with no third party involved [1].')} />
        <p class="prose" set:html={h('Revocation is not: "This document defines no revocation" [1]. If a key is stolen, whoever holds it can pass as the agent and buy or read whatever you allow it. The agent removes the key from its directory, but your CDN keeps trusting its cached copy until that expires, a day in the draft\'s example, and the standard has no faster way to tell you [1]. FORA adds one: a directory can name a revocation list, and FORA\'s checks read it every five minutes [5].')} />
      </div>
      <Figure
        slot="aside"
        src={`${IMG}/wba-8.png`}
        title="Rotation and removal."
        alt="The life of a key in a key directory. Over time the directory holds key A, then key A and key B ('add the new key'), then key B ('remove the old key'): same website, same identity. Below the timeline, a stolen key is removed but still verifies until each site's copy of the directory expires. FORA adds a revocation list, checked every five minutes."
      />
    </Split>
    <Callout kind="caution" points={CAUTIONS} />
  </Band>

  <Band tone="light" id="ask" label="What to ask" title="What to ask your CDN and your team">
    <p class="prose" set:html={h('Your site doesn\'t have to sign anything. It can check signatures itself or leave that to the CDN or bot vendor in front of it [1].')} />
    <h3 class="sub-h">Ask your CDN or bot vendor</h3>
    <PointList tone="neutral" items={ASK_CDN} />
    <h3 class="sub-h">Ask your engineers</h3>
    <PointList tone="neutral" items={ASK_TEAM} />
    <Callout kind="define" {...DEFINITIONS.signedLink} />
  </Band>

  <Band id="allow" label="Access" title="Choosing which agents you sell to">
    <Split aside="400px">
      <div>
        <p class="prose">Your readers and search crawlers reach your open pages as before. What follows is only for the pages you sell access to.</p>
        <p class="prose" set:html={h('Once a domain is verified, you can decide by it. The draft says sites "can log, rate limit, allowlist, or block the URL the way they do IP addresses and User-Agent today" [1]. So keep a list of the domains you want to sell to. A request whose signature fails gets nothing on those pages, and so does a domain your list doesn\'t name.')} />
        <p class="prose" set:html={h('You can keep the list yourself or start from a vendor\'s. In Cloudflare\'s dashboard you set an action for Search, Agent and Training traffic, and for "the top Personal Agents" [32]. The bots come from Cloudflare\'s own reviewed registry [25]. A registry draft from Cloudflare and Amazon also defines a shared list, plain text with one URL per line, that a site "MAY manually add" to its own [33].')} />
      </div>
      <Figure
        slot="aside"
        src={`${IMG}/wba-4.png`}
        title="The approved accounts."
        alt="An Exchange's accounts, each with a checkbox: one domain approved, one new domain held for approval. A signed request from the approved domain can buy. A request whose signature fails gets nothing. A signed request from the new domain can't buy until it's approved. Beside them, a deny list: domains are cheap. Readers and search crawlers reach your open pages as before."
      />
    </Split>
    <p class="prose" set:html={h('On FORA, the list is an Exchange\'s accounts, and each account belongs to a domain. The Exchange\'s operator can open new accounts at once or hold them for approval, and can switch any account off [5, 9]. The approval can ask for what a domain doesn\'t prove, such as a legal name and a VAT number [9, 10]. If you run your own Exchange, as Gutefrage does, the approval is yours.')} />
    <Callout kind="define" {...DEFINITIONS.exchange} />
    <p class="prose">A deny list is weaker: it stops one domain, and domains are cheap. The draft agrees:</p>
    <PullQuote
      quote="Nothing stops an Agent from abandoning a URL and standing up another one, and the protocol does not try to prevent this. It targets honest clients that want to be recognised across requests."
      who="IETF webbotauth working group"
      source="draft-ietf-webbotauth-httpsig-protocol-01, §4.1"
      href={S.draft01}
    />
    <Callout kind="search" id="search-traffic" text={SEARCH_FORA.text} links={SEARCH_FORA.links} />
  </Band>

  <Band tone="near" id="permissions" label="Permissions" title="Where an agent's permissions come from">
    <p class="prose" set:html={h('A Web Bot Auth signature carries no permissions [1]. What an agent may do comes from your rules for its domain, an OAuth token it sends with the request, or a license; on FORA, the license, whose terms "the parties agree to when the agent accepts the offer" [6].')} />
    <LinkRow links={[{ href: ID, text: 'How OAuth, MCP, card networks and other schemes fit with Web Bot Auth' }]} />
  </Band>

  <Band tone="light" id="debate" label="The debate" title="The debate over Web Bot Auth">
    <p class="prose" set:html={h(`The working group has chosen its technical starting point. In May 2026 it decided to work on ${a(`${ID}#anonymous`, 'anonymous approaches')} in parallel with identity [34]. At IETF 126 in July, the room backed the signing draft as the starting direction, 22 to 6 [35]. The group adopted it on September 1, 2026 [3].`)} />
    <p class="prose" set:html={h('The supporters are the companies that handle bot traffic at scale. Engineers from Google, Anthropic, Shopify, Amazon, Stytch and the BBC backed adoption on the list, and the draft\'s authors work at Cloudflare and Google [1, 3]. Their case is cheap, certain checks and less blocking of innocent traffic by IP. Mark Nottingham, who wrote a use-cases draft for the group, says IP-based arrangements are opaque, and an authentication infrastructure can "put some daylight on those arrangements" [36].')} />
    <p class="prose" set:html={h('The critics are civil-society groups and the research and scraping side. They fear sites will pick whom to let in by name, whatever a bot does. The EFF wrote in June 2026 [37]:')} />
    <PullQuote
      quote="If sites restrict crawling to a preapproved list of cryptographically authenticated bots, they could require licensing payments from those wishing to crawl their sites. This would close off the open web to researchers, archivists, and startups without the ability to pay for automated access."
      who="EFF"
      source="The Free and Open Web Is Under Attack at the IETF, June 2026"
      href={S.eff}
    />
    <p class="prose" set:html={h('Writing on the working group\'s list, Mirja Kühlewind warned that once enough sites block everything unsigned, "at some point there might not be a choice anymore" [38]. A domain key is also a stable identifier: the draft says it lets sites correlate requests "including across origins" [1]. Cloudflare, whose engineer is the draft\'s first author, wrote that "Infrastructure for proving properties can become infrastructure for requiring properties" [39].')} />
    <p class="prose" set:html={h('Signing can\'t name a bot that won\'t sign, so publishers who want hidden crawlers named are turning to law. New York\'s legislature passed a Stealth Crawler Prohibition Act in June 2026 with the News/Media Alliance\'s support [40, 41]. In August, the EFF and 18 groups asked the governor to veto it [42].')} />
    <p class="prose" set:html={h('On FORA, an agent signs when it uses FORA to find or buy licensed content [5]. Reading and search stay open, and nobody signs to read a public page. A buying agent is recognizable at every Exchange it uses [1]. Requiring signatures only on the pages you sell keeps your open pages out of this fight.')} />
  </Band>

  <Band id="fora" label="FORA" title="How FORA uses Web Bot Auth">
    <Split aside="400px">
      <div>
        <p class="prose" set:html={h('Every party in FORA signs its requests with a key its own domain publishes [5]. For an agent that buys content:')} />
        <StepList fora items={FORA_STEPS} />
      </div>
      <Figure
        slot="aside"
        src={`${IMG}/wba-6.png`}
        title="How a FORA agent registers and buys."
        alt="How a FORA agent registers and buys, across the key directory on the agent's domain, the agent, the Exchange, FORA's edge function on your CDN (Workers, Fastly Compute or Lambda@Edge) and your site. The agent sends a signed registration to the Exchange, which fetches the key from the key directory; the account belongs to the domain. The agent sends a signed purchase, and the Exchange returns a signed link that names the buyer's key. The agent sends the signed link and its public key to the edge function, which checks that it holds that key, and your site serves the page. A copied link fetches nothing."
      />
    </Split>
    <p class="prose" set:html={h('An agent without a domain of its own can use FORA\'s Identity Service. It gives each agent its own subdomain, so each is a separate party at every Exchange, publishes the agent\'s key directory, keeps the private key and signs for the agent [8].')} />
  </Band>

  <Band tone="near" id="engineers" title="The detail, for engineers">
    <Callout kind="engineers" collapse="Show the detail">
      <div class="eng">
        <h3>If you sign</h3>
        <ul>{ENG_SIGN.map((t) => <li set:html={t} />)}</ul>
        <p set:html={h('A signed request, from draft -01\'s Ed25519 test vector (Appendix E.2.1) [1]:')} />
        <pre><code>{SIGNED_REQUEST}</code></pre>
        <p set:html={h('A directory request and response, from draft -01, Section 5.5.1 [1]:')} />
        <pre><code>{DIRECTORY}</code></pre>
        <h3>If you verify</h3>
        <ul>{ENG_VERIFY.map((t) => <li set:html={t} />)}</ul>
        <h3>What FORA signs</h3>
        <ul>{ENG_FORA.map((t) => <li set:html={t} />)}</ul>
      </div>
    </Callout>
  </Band>

  <Band tone="light" title="Questions">
    <FaqGrid items={FAQ} />
  </Band>

  <Band id="about">
    <Callout kind="about" points={ABOUT_FORA} columns />
    <section class="sources" id="sources" aria-labelledby="sources-label">
      <h2 class="end-label" id="sources-label">Sources</h2>
      <details class="all-sources" id="all-sources">
        <summary>All sources</summary>
        <SourceList groups={SOURCES} compact numbered />
      </details>
      <p class="note">Sources are checked on the date of publication.</p>
    </section>
    <section class="more-in" aria-labelledby="more-label">
      <h2 class="end-label" id="more-label">More in Resources</h2>
      <LinkRow links={MORE} stacked />
    </section>
  </Band>

  <ClosingCta
    title={TAGLINE}
    text="See what an agent would be offered for one of your pages through a FORA marketplace, which any company can run, or read how FORA agents sign."
  >
    <a href="/publishers/" class="btn btn-primary">See your offers</a>
    <a href="/protocol/authentication/" class="btn btn-ghost">How FORA agents sign</a>
  </ClosingCta>
</LandingLayout>

<script is:inline>
  // The sources sit in a closed <details>: a citation marker, or a link to
  // #src-N, opens it before the browser scrolls to the entry. The same script
  // as the standards map's.
  (function () {
    var box = document.getElementById('all-sources');
    if (!box) return;
    function open() {
      if (/^#src-\d+$/.test(location.hash) && !box.open) {
        box.open = true;
        var el = document.getElementById(location.hash.slice(1));
        if (el) el.scrollIntoView();
      }
    }
    window.addEventListener('hashchange', open);
    // A second click on the same marker fires no hashchange.
    document.addEventListener('click', function (e) {
      var link = e.target.closest && e.target.closest('a[href^="#src-"]');
      if (link) box.open = true;
    });
    open();
  })();
</script>

<style>
  /* Prose between components. The same few lines as on the TollBit page. */
  .prose { color: var(--lp-text); line-height: 1.65; max-width: 44rem; }
  .prose + .prose { margin-top: 1rem; }
  :global(*) + .prose { margin-top: 1.25rem; }
  .prose :global(a) { color: var(--lp-link); }
  .prose :global(b) { color: var(--lp-strong); font-weight: 600; }
  .prose :global(code) { font-family: var(--mono); font-size: 0.875em; color: var(--lp-heading); }

  /* The hero's text link to the engineers' band, on its own line under the buttons. */
  .hero-eng { flex-basis: 100%; text-align: left; margin-top: 0.25rem; color: var(--light-gray, #c8c8d4); font-size: 0.9375rem; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .hero-eng:hover { color: var(--white, #fff); }

  /* The key takeaway, drawn large like a pull quote, in FORA's voice. */
  .takeaway { font-size: clamp(1.25rem, 2.2vw, 1.5rem) !important; line-height: 1.45; color: var(--lp-heading); font-weight: 500; letter-spacing: -0.01em; }


  /* The engineers' detail: three groups inside the callout, two code blocks. */
  .eng h3 { margin: 2rem 0 0.75rem; color: var(--lp-heading); font-size: 1.0625rem; font-weight: 600; }
  .eng h3:first-child { margin-top: 0; }
  .eng ul { display: grid; gap: 0.5rem; margin: 0; padding-left: 1.25rem; }
  .eng li, .eng p { color: var(--lp-text); line-height: 1.6; }
  .eng p { margin: 1.25rem 0 0.5rem; }
  .eng :global(code) { font-family: var(--mono); font-size: 0.8125em; color: var(--lp-heading); overflow-wrap: anywhere; }
  .eng pre { margin: 0; padding: 1rem; overflow-x: auto; border: 1px solid var(--lp-rule); border-radius: 6px; background: var(--lp-bg); font-size: 0.8125rem; line-height: 1.5; }
  .eng pre code { overflow-wrap: normal; white-space: pre; font-size: inherit; }
  .eng :global(a) { color: var(--lp-link); }

  /* The sub-headings of "What to ask your CDN and your team". */
  .sub-h { margin: 2.5rem 0 0; color: var(--lp-heading); font-size: 1.125rem; font-weight: 600; letter-spacing: -0.01em; }
  .facts { margin-top: 3rem; }

  .sources { margin-top: 4rem; scroll-margin-top: 5rem; }
  .more-in { margin-top: 3rem; }
  .end-label { font-size: 0.875rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--lp-label); margin: 0 0 0.75rem; }
  .all-sources > summary { cursor: pointer; color: var(--lp-link); font-weight: 600; }
  .note { max-width: 52rem; margin-top: 1.25rem; color: var(--lp-muted); font-size: 0.9375rem; line-height: 1.6; }
</style>
