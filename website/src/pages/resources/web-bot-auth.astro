    items: [
      src("Client registration, revision 2026-07-28", "Model Context Protocol", "https://modelcontextprotocol.io/specification/2026-07-28/basic/authorization/client-registration"),
      src("Cross App Access", "Okta developer docs", "https://developer.okta.com/docs/concepts/xaa/"),
