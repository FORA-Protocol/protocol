<LandingLayout
  title="TollBit and FORA — FORA resources"
  description="How TollBit charges AI bots for your pages and pays you, what your engineers set up for it, where it is ahead of FORA, and how a publisher can run both on the same site."
>
  <AudienceHero
    current="resources"
    badge={`Resources · ${a('/resources/content-marketplaces/', 'Content marketplaces')} · TollBit`}
    title="TollBit charges AI bots at your door. <em>FORA lets agents buy each page on your terms.</em>"
    sub="TollBit runs a paywall for AI bots on a subdomain of your site, and your CDN sends known AI bots there. FORA lets an AI agent buy each page under an offer your Exchange signs, and fetch it from your own CDN."
    updated={resourceUpdated(HREF)}
  >
    <a href="#ahead" class="btn btn-primary">Where TollBit is ahead</a>
    <a href="#together" class="btn btn-ghost">Run both</a>
  </AudienceHero>

  <Band tone="near" id="glance" label="At a glance" title="TollBit and FORA, side by side" lead="The facts a revenue team and an engineering lead act on.">
    <GlanceCard vendor="TollBit" groups={GLANCE} />
  </Band>

  <Band label="The short answer" title="Bots that never asked, and agents that do">
    <CardGrid items={SHORT_ANSWER} />
    <Callout kind="define" {...DEFINITIONS.exchange} />
    <Callout kind="define" {...DEFINITIONS.broker} />
  </Band>

  <Band tone="light" label="How you're paid" title="TollBit bills the buyer on delivery and pays you monthly" asideWidth="440px" asideAlign="start">
    <StepList slot="intro" items={PAID_STEPS} />
    <Figure
      slot="aside"
      src={`${IMG}/tollbit-3.png`}
      title="Where the money goes, and who signs the license."
      caption="TollBit pays you; the license is between you and the buyer."
      alt="The buyer asks TollBit for a pass for one URL; TollBit fetches your page and delivers it with 200 OK, and nobody is billed before that. The buyer then pays your rate plus TollBit's fee, whose size isn't published, and TollBit pays you your full rate monthly; the license is a contract between you and the buyer, and TollBit is not a party."
    />
  </Band>

  <Band tone="near" compact label="TollBit in four numbers">
    <KeyFacts items={KEY_FACTS} />
  </Band>

  <Band label="Who has been paid so far" title="Publishers report revenue. TollBit names no buyer.">
    <PullQuote
      quote="[TNL Mediagene] has begun generating initial revenue from AI buyers."
      who="TNL Mediagene, 15 brands on TollBit, December 2025"
      source="PR Newswire"
      href={T.tnl}
    />
    <Split>
      <p class="prose" set:html={`TollBit counts sites that use it, whether or not they have rates switched on. The count rose from "over 200 publisher sites" in October 2024 (${a(T.seriesA, 'Series A')}) to the CEO's nearly 7,000 in April 2026. The homepage says "Trusted by over 10,000 sites" (vendor's figure, ${a(T.home, 'TollBit')}).`} />
      <p slot="aside" class="prose" set:html={`TollBit's 2024 funding post says it "has secured partnerships with the first AI companies", without naming them ${cite(14)}. No TollBit page or release names OpenAI, Google, Microsoft, Meta, Amazon, Anthropic or Perplexity as a buyer.`} />
    </Split>
  </Band>

  <Band tone="light" label="What it takes on your site" title="Only bots on TollBit's list go to TollBit" lead="Readers and search crawlers reach your site as today. The setup is five steps on your DNS, CDN and security layers, and nothing in your CMS.">
    <Split aside="380px">
      <Callout kind="engineers" collapse="Show the five steps">
        <StepList items={SETUP_STEPS} />
      </Callout>
      <Figure
        slot="aside"
        src={`${IMG}/tollbit-1.png`}
        title="Who gets what when a request reaches your CDN."
        alt="Readers, search crawlers, unlisted bots and listed AI bots all reach your CDN, where a forwarding rule sends only the bots on TollBit's list to TollBit's Agent Site; that site gives a free copy (Open Access), blocks the bot, or by default answers 402 without a pass, and everything not on the list reaches your origin. TollBit's fetcher (tollbot/1.0) then pulls the page for a buyer with a pass through your CDN to your origin, and it gets through your WAF and bot shield only by an allow rule for TollBit's fetcher."
      />
    </Split>
  </Band>

  <Band tone="near" label="What can go wrong" title="What TollBit's own guides warn about">
    <Callout kind="caution" points={CAUTIONS}>
      <PullQuote
        small
        quote="Agent Site responses can be cached and then served to human visitors."
        who="TollBit, on CloudFront with the cache key in the wrong order"
        source="AWS guide"
        href={T.aws}
      />
    </Callout>
    <Callout kind="search" id="search-traffic" text={SEARCH_FORA.text} links={SEARCH_FORA.links}>
      <p>TollBit's rule forwards only the AI bots on its list. Googlebot and Bingbot aren't on it, so they reach your site as today.</p>
    </Callout>
  </Band>

  <Band id="ahead" label="Where TollBit is ahead" title="What TollBit does that FORA doesn't">
