const SETUP_STEPS = [
  { title: 'Hand TollBit a subdomain.', text: `A TXT record proves you own the domain. An NS record delegates <code>tollbit.news.example.com</code> to TollBit's nameservers, so TollBit answers for that host under your name (${a(T.verifying, 'Verifying a property')}). TollBit's paywall for bots runs there, as your "Agent Site".` },
  { title: 'Let TollBit\'s fetcher through.', text: `TollBit pulls your pages from your public site, through your CDN, and reads your sitemap from <code>robots.txt</code> when you add the site. The fetcher sends <code>tollbot/1.0</code> from two ${a(T.staticIps, 'published addresses')}. Every firewall, rate limit and bot shield in front of your origin has to let it in.` },
  { title: 'Stream your logs.', text: `The Platform overview requires them: "Every site that onboards to TollBit is required to send us their HTTP logs" (${a(T.overview, 'Platform overview')}, §1.3). Your CDN streams them with a secret key, or TollBit reads a storage bucket, which "takes up to 24 hours" to verify (${a(T.architecture, 'Platform architecture')}). TollBit's Cloudflare guide says the paywall works without them (${a(T.cloudflare, 'Cloudflare')}).` },
  { title: 'Add one forwarding rule at your CDN.', text: `It tests the <code>User-Agent</code> header, the name a bot sends, against 69 AI user agents (${a(T.cloudflare, 'Cloudflare')}). On Cloudflare and Fastly the rule proxies the request, so the bot gets TollBit's answer at your URL. On CloudFront it switches the origin. On Vercel, Imperva, Google Cloud and Azure it redirects, and TollBit advises "a 302 (temporary) redirect" (${a(T.other, 'Other')}). TollBit has guides for 12 platforms (${a(T.integrations, 'Integrations')}).` },
  { title: 'Decide what each bot gets.', text: `Your copy of the list decides which bots are forwarded at all. On Fastly, DataDome and Netacea you can pick agents one by one in a console instead. In TollBit's dashboard you "define which agents are allowed in, which are blocked, and which are subject to your paywall" (${a(T.configure, 'Configure Agent Site')}). Open Access serves bots or paths you choose a cached copy for free (${a(T.cache, 'Content cache')}). By default, any other forwarded bot without a pass gets a short message with HTTP 402, "payment required", and no price in it (${a(T.defaults, 'Default settings')}).` },
];

const CAUTIONS = [
  { title: 'A blocked fetcher breaks the paywall.', text: `"If our requests are blocked, challenged, or rate-limited, your Agent Site will not work correctly" (${a(T.verifying, 'Verifying a property')}).` },
