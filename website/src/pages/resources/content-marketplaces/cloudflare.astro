const SHORT_ANSWER = [
  { title: 'Cloudflare charges at the door.', text: 'Pay Per Crawl charges a crawler one price per page, and Cloudflare collects and pays out. In Pay Per Use, an AI company proposes a price for a use, and you accept or decline. Both are in beta. Pay Per Crawl needs your site\'s traffic to run through Cloudflare.' },
  { title: 'FORA sells the license.', text: 'You set the uses, buyers, caps and price for each resource, and can offer one article on several terms. An AI agent (software that acts for a user, one task at a time) buys under an offer your Exchange signs. Pay Per Crawl needs no Exchange of yours, because Cloudflare is one.' },
  { status: 'closed-beta' as const, title: 'Pay Per Crawl is by admission only.', text: 'Cloudflare\'s plan table lists charging under Enterprise plans with Bot Management. You need a new Stripe account, and your balance isn\'t in the dashboard. Cloudflare names no AI company paying through it.' },
];

const PPC_STEPS = [
  { title: 'Your site runs through Cloudflare, and is admitted.', text: `"Your domain must be using Cloudflare's nameservers, or have DNS records managed by Cloudflare" (${a(C.enable, 'Enable in account settings')}). The program is a closed beta (${a(C.whatIs, 'What is Pay Per Crawl')}). The plan table lists charging under Enterprise plans with Bot Management (${a(C.getStarted, 'Get started')}).` },
  { title: 'You set one price and pick who pays it.', text: `Cloudflare lists the AI crawlers it knows, and you set each one to Charge, Allow or Block. Cloudflare says "you can only set a single price" for every crawler set to Charge (${a(C.faq, 'FAQ')}), and "The minimum price is $0.001 USD per crawl" (${a(C.setPrice, 'Set a price')}).` },
  { title: 'The crawler registers.', text: `It signs its requests with Web Bot Auth, an IETF draft for signing bot requests. It passes Cloudflare's review and connects Stripe (${a(C.crawlPages, 'Crawl pages')}).` },
  { title: 'Cloudflare quotes.', text: 'An unpaid request gets HTTP 402, Payment Required, with the price. The crawler retries with a signed agreement to it, or states a maximum up front.' },
