    <PointList slot="intro" items={TIMELINE} />
    <Figure
      slot="aside"
      src={`${IMG}/perplexity-3.png`}
      title="Perplexity's programs and CNN's case, 2024 to today."
      alt="Perplexity's Publishers' Program shared ad revenue from July 2024, Comet Plus ($5, or in Pro and Max) followed in 2025, the FT reported that ads would be phased out from the end of 2025, and in November 2026 Comet Plus is not on the pricing page. CNN was listed as a launch partner from October 2, 2025, the term sheet ended on November 24, 2025, and CNN sued Perplexity on May 28, 2026."
    />
  </Band>

