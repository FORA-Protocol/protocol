};
const a = (href: string, text: string) => `<a href="${href}">${text}</a>`;

const GLANCE = glanceGroups({
  payer: [`Perplexity says it pays, from a pool of Comet Plus revenue, by its own counts. Schedule, threshold and currency: Not public ${cite(1)}.`, FORA_CELLS.payer],
  fees: [`Perplexity keeps "a small portion" for compute; 20% in press reports ${cite(1, 12)}.`, FORA_CELLS.fees],
  reporting: [
    `No Comet Plus statement format is published ${cite(1, 2)}. 2024 partners got analytics on how Perplexity cites them ${cite(3)}.`,
    `Each sale, in your operator's publisher console, with gross, the Exchange fee and net (${a('/getting-started/publisher-onboarding/', 'Publisher onboarding')}).`,
  ],
  contract: [
    `A private contract, after an email to Perplexity. No standard agreement is published ${cite(1)}.`,
    `Your agreement with your Exchange operator; your terms go into each offer it signs ${cite(20)}.`,
  ],
  status: [
    `${statusTag('not-public')} Comet Plus isn't on Perplexity's ${a(X.pricing, 'pricing page')} as of 2026-11-15. Whether it still pays out isn't public.`,
    `${statusTag('live')} ${SEE_ABOUT}`,
  ],
  dns: [`No change in Perplexity's docs ${cite(5)}.`, `No record to add ${cite(19)}.`],
  cdn: [
    `No code in Perplexity's docs ${cite(5)}.`,
    'FORA\'s edge function, a drop-in: about 10 minutes on a CDN, about 30 minutes with AWS Amplify. The rest depends on your own setup; FORA adds to what you run rather than replacing it.',
  ],
  firewall: [
    `An allow rule that matches each Perplexity crawler to its own IP ranges ${cite(5)}.`,
    `Keep your bot protection, and let AI agents that name themselves reach the edge function. Or let signed requests and your discovery file through (${a('/components/edge-function/bot-detection/', 'Bot detection')}).`,
  ],
  site: [
    `No feed, file or API. How your paywall lets a Comet Plus subscriber in: Not public ${cite(5, 6)}.`,
    `One file that names your Exchanges, and a sitemap the operator imports your pages from ${cite(19)}.`,
  ],
  search: [
    `PerplexityBot builds Perplexity's search index and follows robots.txt ${cite(5, 6)}.`,
    `Googlebot, Bingbot and Applebot always pass ${cite(21)}. PerplexityBot is refused on licensed paths by default. See <a href="#search-traffic">Search traffic</a>, below.`,
  ],
  upkeep: [
    `A scheduled job to refresh Perplexity's IP ranges, which Perplexity updates regularly ${cite(5)}.`,
    `Two breaking wire-format releases in October 2026 (${a('/reference/changelog/', 'Changelog')}). Editing your discovery file needs no redeploy ${cite(19)}.`,
  ],
  leaving: ['Not public.', FORA_CELLS.leaving],
});

const SHORT_ANSWER = [
  { title: 'Perplexity is the buyer.', text: 'Comet Plus is meant to share Perplexity\'s own revenue with the publishers it signs, for use in its answer engine, its Comet browser and Comet Assistant. No other AI company buys publisher content through its programs.' },
  { status: 'not-public' as const, title: 'Whether Comet Plus still pays isn\'t public.', text: 'On 2026-11-15 Comet Plus isn\'t on Perplexity\'s pricing page or plan guide. CNN, a launch partner, never got from its term sheet to a contract, its complaint says. CNN sued Perplexity on 2026-05-28.' },
  { title: 'FORA prices the access, on the same site.', text: 'You set the price, the unit and the terms for each page. Any agent can buy, and each purchase is a signed record. You can let Perplexity\'s search crawler in and sell to other agents through FORA on one site today.' },
];

const PAY_STEPS = [
  { title: 'You email and sign.', text: `"Publishers interested in participating can join the program by emailing us via publishers@perplexity.ai" (${a(X.comet, 'Introducing Comet Plus')}). No standard agreement is published.` },
  { title: 'Subscribers pay Perplexity.', text: `"Comet Plus will be a $5 standalone subscription. Pro and Max subscribers get Comet Plus included in their memberships" ${cite(1)}.` },
  { title: 'Subscribers reach your site.', text: `They get "direct access to the sites and content of participating publishers", and their assistants can "complete tasks on those sites" ${cite(1)}. How your paywall recognizes a subscriber isn't public.` },
  { title: 'Perplexity counts three kinds of traffic.', text: `Comet Plus "allocates revenue to our partners based on three types of internet traffic: human visits, search citations, and agent actions" ${cite(1)}. Digiday describes the visits as "direct visits to publisher's sites by people browsing using Comet". It describes agent actions as content "used to complete tasks by Comet's AI assistant" (${a(X.digiday, 'Digiday')}, published 2025-08-26). Perplexity counts all three in its own products, with no independent count described.` },
  { title: 'The revenue becomes a pool.', text: `"We're distributing all of that revenue to participating publishers, minus a small portion for Perplexity's compute costs" ${cite(1)}. Digiday reported that "Perplexity keeps 20% of it" and that Perplexity is "opening up a pool of $42.5 million to publishers". Perplexity's own pages give neither figure.` },
  { title: 'The pool is split by weights you don\'t see.', text: 'Asked whether one kind of use weighs more, Jessica Chan, Perplexity\'s head of publisher partnerships, told Digiday: "The details will be very specific to our partners, but you are thinking about it correctly." The weights aren\'t published.' },
  { title: 'Perplexity says it pays.', text: 'No schedule, threshold, currency or statement format is published. What Perplexity has said about payment is under "<a href="#paid-so-far">Who has been paid so far</a>".' },
];

const KEY_FACTS = [
  { value: '$5', text: `Comet Plus on its own; Pro and Max subscribers get it included ${cite(1)}` },
  { value: '3', text: `Kinds of traffic Perplexity counts: human visits, search citations and agent actions ${cite(1)}` },
  { value: '$42.5 million', text: `The pool Digiday reported; Perplexity's own pages don't give it ${cite(1, 12)}` },
  { value: 'Not public', text: `The weight on each kind of traffic, per partner ${cite(12)}` },
];

const ENGINEERS = [
  { title: 'How your content reaches Perplexity.', text: 'PerplexityBot crawls your pages for Perplexity\'s search index, and "Perplexity partners with third-party crawlers to help build our search index". Perplexity-User fetches a page when a user\'s question needs it. You publish no feed, file or API.' },
  { title: 'The allow rule.', text: 'If your firewall screens bots, Perplexity asks for an allow rule that matches each crawler\'s user agent to its own published IP ranges. It advises an automated job to keep them current, so budget for a scheduled job that refreshes the ranges.' },
  { title: 'On Cloudflare.', text: 'A custom rule set to Skip, placed above the rules that block or challenge, lets both crawlers past them.' },
  { title: 'With FORA on the same site.', text: `Apply Perplexity's IP-range rules in your CDN's firewall, which runs before FORA's edge function. The edge function knows both crawlers by the names they send, and a name can be copied (${a('/components/edge-function/bot-detection/', 'Bot detection')}).` },
  { title: 'Nothing is metered at your site.', text: 'Perplexity\'s docs describe no payment response, no redirect and no signed link. It counts visits, citations and agent actions in its own products, and describes no log feed in either direction. Its one word on logs is to "Monitor your logs" to see that its crawlers get through.' },
];

const CAUTIONS = [
  { title: 'A blocked page can still show.', text: `If robots.txt blocks a page, Perplexity "may still index the domain, headline, and a brief factual summary" ${cite(6)}.` },
