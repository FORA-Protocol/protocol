---
// Resource: Microsoft Publisher Content Marketplace (PCM) and FORA, one of the
// deep pages of the content-marketplaces series (hub:
// /resources/content-marketplaces/). Laid out in the vendor page template, as
// the TollBit page: hero, at a glance, the short answer, how you're paid, key
// facts, who has signed and been paid, what it takes on your site, search
// traffic, where PCM is ahead, the eight questions, running both, what to do,
// and About FORA with the sources and the series navigation.
//
// Shared texts (About FORA, the definitions, the search callout, the table
// questions, the GlanceCard rows and FORA's fixed cells) come from
// src/data/content-marketplaces.ts. A claim cites its source inline, as a
// link, or with cite(N), which links to entry N of the numbered SourceList at
// the foot; SOURCES below is numbered as the copy numbers it, so an entry's
// position is its number. Text with links is HTML and goes through set:html.
import LandingLayout from '../../../layouts/LandingLayout.astro';
import AudienceHero from '../../../components/landing/AudienceHero.astro';
import Band from '../../../components/landing/Band.astro';
import GlanceCard from '../../../components/landing/GlanceCard.astro';
import CardGrid from '../../../components/landing/CardGrid.astro';
import Callout from '../../../components/landing/Callout.astro';
import StepList from '../../../components/landing/StepList.astro';
import Figure from '../../../components/landing/Figure.astro';
import KeyFacts from '../../../components/landing/KeyFacts.astro';
import PullQuote from '../../../components/landing/PullQuote.astro';
import Split from '../../../components/landing/Split.astro';
import PointList from '../../../components/landing/PointList.astro';
import CompareTable from '../../../components/landing/CompareTable.astro';
import CodeCard from '../../../components/landing/CodeCard.astro';
import SourceList from '../../../components/landing/SourceList.astro';
import SeriesNav from '../../../components/landing/SeriesNav.astro';
import ClosingCta from '../../../components/landing/ClosingCta.astro';
import { resourceUpdated } from '../../../data/resources';
import {
  ABOUT_FORA, DEFINITIONS, SEARCH_FORA, FORA_CELLS, SEE_ABOUT, compareRows, glanceGroups,
} from '../../../data/content-marketplaces';
import { cite, statusTag } from '../../../lib/resource-markup';

const HREF = '/resources/content-marketplaces/microsoft-pcm/';
const IMG = '/resources/content-marketplaces/microsoft-pcm';

// Every external source the page links.
const M = {
  launch: 'https://about.ads.microsoft.com/en/blog/post/february-2026/building-toward-a-sustainable-content-economy-for-the-agentic-web',
  product: 'https://preview-about.ads.microsoft.com/en/solutions/technology/publisher-content-marketplace',
  bing: 'https://blogs.bing.com/search/2026/10/your-content-your-choice-clearer-preferences-for-training-and-grounding/',
  kolar: 'https://digiday.com/media/qa-nikhil-kolar-vp-microsoft-ai-scales-its-click-to-sign-ai-content-marketplace/',
  yahoo: 'https://www.yahooinc.com/press/introducing-yahoo-scout-a-new-ai-answer-engine',
  sej: 'https://www.searchenginejournal.com/googles-ai-payment-pilot-vs-cloudflare-and-microsoft-models/589636/',
  gannett: 'https://www.editorandpublisher.com/stories/gannett-announces-third-quarter-2025-results-new-ai-licensing-deal-with-microsoft-and-updated,258540',
  iac: 'https://ir.iac.com/static-files/e2666073-0141-41f8-a45d-77ea800a65be',
  ap: 'https://digiday.com/media/media-briefing-associated-press-deal-cements-microsofts-quiet-rise-in-ai-licensing',
  bi: 'https://talkingbiznews.com/media-news/business-insider-joining-microsoft-content-marketplace/',
  verge: 'https://www.theverge.com/news/873296/microsoft-publisher-content-marketplace-ai-licensing',
};
// FORA's docs, as the copy links them.
const D = {
  onboarding: '/getting-started/publisher-onboarding/',
  afterSetup: '/getting-started/publisher-onboarding/#after-setup',
  serveFile: '/getting-started/publisher-onboarding/#serve-your-discovery-file',
  deployment: '/components/edge-function/deployment/',
  providersDocs: '/components/edge-function/deployment/#the-providers-own-documents',
  botDetection: '/components/edge-function/bot-detection/',
  keepBotProtection: '/components/edge-function/bot-detection/#keeping-cdn-bot-protection-on',
  whatIsFora: '/getting-started/what-is-fora/',
  howItWorks: '/getting-started/what-is-fora/#how-it-works',
  edgeOverview: '/components/edge-function/overview/',
  terms: '/protocol/licensing-terms/',
  metering: '/protocol/licensing-terms/#metering-modes',
  revenueShare: '/protocol/licensing-terms/#revenue-share-arrangements',
  broker: '/components/broker/overview/',
  auth: '/protocol/authentication/',
};
const a = (href: string, text: string) => `<a href="${href}">${text}</a>`;
const NP = statusTag('not-public');

const GLANCE = glanceGroups({
  payer: [`Microsoft, for Copilot's use: "paid on delivered value" ${cite(1)}. When, and who pays for other buyers' use: ${NP}`, FORA_CELLS.payer],
  fees: [`For Copilot's use, Microsoft is the buyer ${cite(1)}.`, FORA_CELLS.fees],
  reporting: [
    `"Usage-based reporting" ${cite(1)}. What a report contains: ${NP}`,
    `Each sale, with gross, the Exchange fee and net, in your operator's publisher console (${a(D.afterSetup, 'Publisher onboarding')}).`,
  ],
  contract: [
    `With Microsoft, negotiated one by one in the pilot. The standard contract wasn't final in February 2026 ${cite(12)}.`,
    `Your agreement with your Exchange operator (${a(D.deployment, 'Deployment')}). Your terms go into each offer the Exchange signs.`,
  ],
  status: [`${statusTag('pilot')} No payment is public ${cite(1)}.`, `${statusTag('live')} ${SEE_ABOUT}`],
  dns: [`No change documented ${cite(1, 2)}.`, `No record to add (${a(D.deployment, 'Deployment')}).`],
  cdn: [
    `No change documented ${cite(1, 2)}.`,
    'A drop-in edge function. The rest depends on your own setup; FORA adds to what you run rather than replacing it.',
  ],
  firewall: [
    `No bot rule documented. What your CDN blocks stays your decision ${cite(1, 2)}.`,
    `Your firewall and bot product run first. They must let signed requests and your FORA file through (${a(D.keepBotProtection, 'Bot detection')}).`,
  ],
  site: [
    `You hand over content through "the pipes" Microsoft built ${cite(12)}. Feed, API or crawl: ${NP}`,
    `One file on your site, <code>fora.json</code>, naming your Exchanges. The operator imports your pages from your sitemap (${a(D.afterSetup, 'Publisher onboarding')}).`,
  ],
  search: [
    `Bing's crawl is separate from PCM ${cite(3)}. How Bing's settings affect a PCM license: ${NP} See <a href="#search-traffic">Search traffic</a>, below.`,
    `Googlebot, Bingbot and Applebot always pass ${cite(6)}. See <a href="#search-traffic">Search traffic</a>, below.`,
  ],
  upkeep: [
    `How often you send content, and who keeps it current: ${NP}`,
    `A change to your FORA file takes effect with nothing to redeploy (${a(D.providersDocs, 'Deployment')}).`,
  ],
  leaving: [`"Participation is voluntary" ${cite(1)}. How you leave: ${NP}`, FORA_CELLS.leaving],
});

const SHORT_ANSWER = [
  { title: 'PCM brings a buyer.', text: `Microsoft runs the marketplace and buys through Copilot, and says it is "beginning to onboard" Yahoo ${cite(1)}. You sign a contract and hand over your content. Microsoft documents no change to your site.` },
  { title: 'FORA brings an open interface.', text: 'Any agent finds your offers, signs for the terms it picks and gets an expiring link for that purchase. You serve one file and install the edge function on your CDN.' },
  { title: 'They run side by side.', text: 'PCM publishes no API for outside software, so FORA can\'t connect to it without Microsoft. Both can run on one site, if your PCM contract allows it.' },
];

const PAID_STEPS = [
  { title: 'You register interest.', text: `Microsoft's product page says: "Register your interest in the Publisher Content Marketplace to receive updates as our work progresses" (${a(M.product, 'product page')}). How publishers are selected: ${NP}` },
  { title: 'You sign a contract.', text: `"With the pilot, we did individual negotiations with the publishers," Microsoft's Nikhil Kolar told Digiday in February 2026. A standard contract is planned, "but we’ve not finalized it yet" (${a(M.kolar, 'Digiday interview')}).` },
  { title: 'You hand over your content.', text: `Kolar describes the first phase as getting "the pipes working — how does the content come in". Publishers can "clean up the content", for example an image licensed from someone else ${cite(12)}. By feed, API or crawl: ${NP}` },
  { title: 'You set the terms.', text: `"Publishers define licensing and usage terms", with no published vocabulary ${cite(1)}. The primary use, in Microsoft's words, is "Grounding and Display": content grounds the answer to a single query, "and that same content is also displayed as a citation URL" in it. "PCM is for Grounding and Display use cases, not training" ${cite(2)}.` },
  { title: 'Copilot uses it.', text: `Microsoft "started with a focused set of scenarios in enterprise and consumer versions of Microsoft Copilot". It is "beginning to onboard demand partners, including Yahoo" ${cite(1)}. Yahoo said on January 27, 2026, that it "is also joining Microsoft’s Publisher Content Marketplace pilot" (${a(M.yahoo, 'Yahoo')}). Whether Yahoo buys through PCM yet: ${NP}` },
  { title: 'You\'re paid, and you get a report.', text: `PCM "provides usage-based reporting" ${cite(1)}. What a report contains: ${NP} Search Engine Journal noted the gap: the post "doesn’t say who sets the price or what the reports show" (${a(M.sej, 'SEJ')}).` },
];

const KEY_FACTS = [
  { value: '2', text: `versions of Copilot PCM started with, enterprise and consumer ${cite(1)}` },
  { value: '7', text: `US publishers Microsoft names as co-designers, "among others" ${cite(1)}` },
  { value: '4', text: `publishers that confirmed their deals in late 2025 ${cite(15, 16, 17, 18)}` },
  { value: '1', text: `buyer beyond Copilot that Microsoft names: Yahoo, which it is onboarding ${cite(1)}` },
];

const SITE_PCM = [
  { title: 'How content gets in:', text: `through "the pipes" Microsoft built ${cite(12)}. Feed format, ingestion API, CMS plugin or crawler: ${NP}` },
  { title: 'DNS and CDN:', text: `no change documented. The product page promises "a single, trusted path to make content available for AI use cases while preventing unwanted crawling" ${cite(2)}. It doesn't say how.` },
  { title: 'Who gets in:', text: `Microsoft onboards the other buyers, such as Yahoo ${cite(1)}. How your contract limits them: ${NP} PCM documents no bot rule, so what your CDN blocks stays your decision.` },
  { title: 'What a bot gets back:', text: 'PCM documents no answer to a bot, neither a redirect nor a payment-required response.' },
  { title: 'Logs:', text: `none documented. You get "usage-based reporting" ${cite(1)}.` },
];
const SITE_FORA = [
  { title: 'How content gets in:', text: `it stays on your site. The Exchange reads your sitemap, and you set terms in its operator's console. Or you push the catalog to it (${a(D.howItWorks, 'What is FORA?')}).` },
  { title: 'DNS and CDN:', text: `you serve one file that names your Exchanges, and install the edge function on your CDN (${a(D.deployment, 'Deployment')}).` },
  { title: 'Who gets in:', text: `you choose the paths you license. There, the edge function refuses AI bots that come without a signed link. Readers and search crawlers pass as before ${cite(6)}.` },
  { title: 'What a bot gets back:', text: `a refusal that tells the bot where to buy ${cite(8)}.` },
  { title: 'Logs:', text: `each refusal states its reason, the same reason the edge function logs ${cite(8)}. The Exchange records each sale.` },
];

const ENGINEER_STEPS = [
  { title: 'Serve the file.', text: `Your operator's console gives you the file that names your Exchanges. Serve it unchanged (${a(D.serveFile, 'Publisher onboarding')}).` },
  { title: 'Add the edge function.', text: `The console builds it for your domain, for Cloudflare or CloudFront, and it sits beside what your CDN already runs (${a(D.deployment, 'Deployment')}).` },
  { title: 'Let signed requests through.', text: `On most CDNs, the firewall and bot product run before the edge function, so a bot rule there can refuse an agent that has already bought. Let signed requests through it (${a(D.keepBotProtection, 'Bot detection')}).` },
  { title: 'How the edge function decides.', text: `On the paths you license, it matches the name each bot sends, its User-Agent, against FORA's published list of AI bots. It never matches Googlebot, Bingbot or Applebot ${cite(6)}.` },
  { title: 'What a refused bot gets.', text: `A 403, with a header that points it to the file naming your Exchanges ${cite(8)}. There is no 402: the agent buys at the Exchange, before it fetches.` },
];

const CAUTIONS = [
  { title: 'Blocking Bingbot takes you out of Bing search.', text: 'Bing\'s own grounding refusal doesn\'t.' },
  { title: 'Grounding is refused page by page.', text: 'You set it with a meta tag or a response header: "There is no site-wide robots.txt grounding preference." Training can be refused per site or path in <code>robots.txt</code>, with the shared AI-training group that other crawlers can honor too, or per page.' },
  { title: 'Bing has to crawl to see your choice.', text: '"Microsoft must crawl the page to discover the setting."' },
  { title: 'NoArchive and NoCache stop counting.', text: 'After March 1, 2027, Bing no longer reads these older tags for training and grounding. If you use them to stay out of AI answers, also set a temporary preference in Bing Webmaster Tools before that date.' },
];

const AHEAD = [
  { title: 'The buyer comes with the marketplace.', text: `PCM's operator is also its first buyer. Copilot comes in two versions, "the M365 copilot from the enterprise side, and the MAI copilot from the consumer side" ${cite(12)}. On FORA, any agent can buy.` },
  { title: 'No change to your site that Microsoft documents.', text: `PCM needs a contract and your content: "Instead of blocking bots or negotiating one-off deals, tap into a transparent marketplace" ${cite(2)}. FORA asks for a file and an edge function, as above.` },
  { title: 'A price set by what the answer needed.', text: `Kolar: "Sometimes, the value may be: ‘I just need to know the score.’" For a source that is "not substitutable", a buyer is "willing to pay a lot more" ${cite(12)}. PCM is designed to price a use by its worth in the answer. FORA can't: its price is fixed at the sale, and a usage report "never re-prices a purchase" (${a(D.metering, 'Licensing terms')}).` },
  { title: 'Reports from inside the AI product.', text: `Microsoft runs Copilot, so its reports can come from the answer itself. Kolar: "we wanted to build a feedback loop from the demand side on how the content was used" ${cite(12)}. FORA can't report that. It records each sale, and of the use in an answer it knows only what the agent reports (${a(D.howItWorks, 'What is FORA?')}, step 5).` },
  { title: 'A use that includes the citation.', text: `Grounding and Display ties one answer to one shown link. FORA can state the same duty in a term, as below, but nothing in FORA observes that the link was shown. For an outside buyer such as Yahoo, how PCM learns of the citation: ${NP}` },
  { title: 'Deals you\'ve already made.', text: `Kolar calls it "bring-your-own-license": PCM "can become the infrastructure to deliver any license that you have negotiated outside the marketplace". "Some of the larger partners we work with already have a licensing deal," he says ${cite(12)}. PCM is built to carry such deals, to buyers Microsoft contracts. FORA carries them as a deal term (${a(D.revenueShare, 'Licensing terms')}).` },
];

const COMPARE = compareRows([
  [
    `In your PCM contract: "publisher-defined content and license terms". Nothing on your site says so to anyone else ${cite(2)}.`,
    `Your FORA file names the Exchanges that sell your content, and you set terms per resource in your operator's publisher console ${cite(7)}.`,
  ],
  [
    `"AI builders discover and license content for specific grounding scenarios" ${cite(1)}. How: ${NP}`,
    `An agent asks your Exchange, or a Broker. Each Broker operator chooses its search, and each agent chooses its Broker ${cite(10)}.`,
  ],
  [
    `Copilot, Microsoft's own product. Microsoft is "beginning to onboard" Yahoo ${cite(1)}. Agent identification: ${NP}`,
    `Each request carries a signature, checked against the signer's published key (Web Bot Auth, the IETF working group's -00 draft) ${cite(11)}.`,
  ],
  [
    `The contract. Pilot contracts were negotiated one by one; the standard contract was not final in February 2026 ${cite(12)}.`,
    `A signed offer the agent accepts and signs, and a link that expires, checked at your CDN ${cite(7)}.`,
  ],
  [
    `Paid "on delivered value" ${cite(1)}. The unit and who sets the number: ${NP}`,
    `You: free, per unit (an access, a token, a page) or a flat fee, signed on each offer. Fixed at the sale, by design ${cite(9)}.`,
  ],
  [`For Copilot's use, Microsoft is the buyer ${cite(1)}. Who pays for any other partner's use, when, and any minimum: ${NP}`, FORA_CELLS.money],
  [
    `"usage-based reporting" on how content is "valued, cited, and used" ${cite(1, 2)}. What a report contains: ${NP}`,
    `The operator's console: your sales, with gross, fee and net. It is each operator's own; no protocol call returns your sales ${cite(4)}.`,
  ],
  [`No dispute process is described ${cite(1, 2, 12)}.`, FORA_CELLS.disputes],
]);

const WORKS = [
  { title: 'Run both.', text: `"Participation is voluntary," Microsoft says ${cite(1)}. For exclusivity, see For legal, below. PCM stays a contract, and the file on your site names your FORA Exchanges.` },
  { title: 'Sell the same use to every other agent.', text: 'Grounding and Display is one FORA term. In words: AI answers are allowed and training isn\'t, the article is shown as a cited link, and each access costs $0.05.' },
];

// The term as it reads on the wire: field, then value.
const TERM_LINES: [string, string][] = [
  ['restrictions:', 'FUNCTION  permitted: ai-input   prohibited: ai-train'],
  ['obligations:', 'ATTRIBUTION, on use:\n"Show the article as a cited link to news.example.com"'],
  ['pricing:', 'PER_UNIT  unit: accesses  rate: "0.05"  currency: USD'],
];

const TODO = [
  { title: 'Ask how you join.', text: 'Microsoft\'s product page has an interest form, and doesn\'t say how publishers are selected.' },
  { title: 'Ask for the unit and the price.', text: 'Microsoft hasn\'t published what it pays per use, or who sets the number. Ask both, in writing.' },
  { title: 'Ask how your content gets in.', text: 'Microsoft hasn\'t published the route: a feed, an API or a crawl. Ask what you send, how often, and who keeps it up to date.' },
  { title: 'Ask what the report shows.', text: `Microsoft promises insight into how content is "valued, cited, and used" ${cite(2)}. Ask for a sample report.` },
  { title: 'Ask how Bing\'s settings affect your license.', text: 'If you refuse grounding in Bing, do you lose PCM money? If you\'re in PCM, can you still refuse it? Ask before you choose a setting.' },
  { title: 'Sell to other agents too.', text: `Name your FORA Exchanges in <code>fora.json</code> and put a grounding term with a citation duty on your articles. FORA itself is free, open-source software. For the publisher console's fees, ${SEE_ABOUT.replace('See', 'see')}` },
];

const LEGAL = [
  { title: 'Who you sign with.', text: `Microsoft. Pilot contracts were "individual negotiations"; a standard contract is planned, "but we’ve not finalized it yet" ${cite(12)}.` },
  { title: 'What you license.', text: `"PCM is for Grounding and Display use cases, not training" ${cite(2)}. The terms are in your contract; Microsoft publishes no vocabulary for them.` },
  { title: 'Rights you may not hold.', text: `Agency photos and syndicated stories may not be yours to hand over. Kolar gives a licensed-in image as the example ${cite(12)}. List what you can't license before you sign.` },
  { title: 'Exclusivity.', text: `"Participation is voluntary" ${cite(1)}. Whether the contract lets you sell the same articles through FORA or anyone else: ${NP} Ask before you do.` },
  { title: 'Bing\'s settings aren\'t a license.', text: `Bing says its preferences "do not establish licensing or payment arrangements" ${cite(3)}. How they interact with a PCM license: ${NP}` },
  { title: 'Law, venue, disputes and exit.', text: `${NP} No dispute process is described.` },
  { title: 'Changes.', text: `PCM is a pilot. Kolar: "what we launch may not be what we end up with" ${cite(12)}.` },
];

// The SourceList, numbered as the copy numbers it: an entry's position,
// counted across the groups, is the N in cite(N).
const fora = (title: string, href: string) => ({ title, publisher: 'FORA documentation', href, checked: '2026-11-15' });
