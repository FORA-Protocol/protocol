---
// Landing page — overrides Starlight's default index
// Links into Starlight docs at /getting-started/what-is-fora/
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>FORA Protocol — Open Transaction Protocol for AI Content Access</title>
  <meta name="description" content="The open protocol that turns blocked bots into paying customers. Discover, price, transact, deliver, verify — one protocol for any content." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style is:global>
    :root {
      --accent: #4f6df5;
      --accent-text: #9aaeff;
      --accent-glow: #4f6df533;
      --accent-dark: #3d58d6;
      --black: #0a0a0f;
      --near-black: #12121a;
      --dark: #1a1a26;
      --mid: #2a2a3a;
      --gray: #a5a5b8;
      --light-gray: #c0c0d0;
      --off-white: #e8e8f0;
      --white: #f5f5fa;
      --bg-light: #fafafa;
      --mono: 'DM Mono', monospace;
      --sans: 'Instrument Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      font-family: var(--sans);
      color: var(--off-white);
      background: var(--black);
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    /* ========= HERO ========= */
    .hero {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      position: relative;
      overflow: hidden;
      background:
        radial-gradient(ellipse 80% 60% at 50% 0%, var(--accent-glow) 0%, transparent 70%),
        linear-gradient(180deg, var(--near-black) 0%, var(--black) 100%);
    }

    .hero-nav {
      position: relative;
      z-index: 10;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.5rem 2.5rem;
      max-width: 1280px;
      margin: 0 auto;
      width: 100%;
    }

    .logo {
      font-family: var(--sans);
      font-size: 1.125rem;
      font-weight: 600;
      letter-spacing: -0.03em;
      text-decoration: none;
      color: var(--off-white);
      text-transform: lowercase;
    }

    .nav-links {
      display: flex;
      gap: 2rem;
      list-style: none;
    }
    .nav-links a {
      color: var(--gray);
      text-decoration: none;
      font-size: 0.875rem;
      font-weight: 500;
      transition: color 0.2s;
    }
    .nav-links a:hover { color: var(--off-white); }

    .hero-content {
      position: relative;
      z-index: 10;
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 2rem 2rem 4rem;
      max-width: 900px;
      margin: 0 auto;
    }

    .hero-badge {
      font-family: var(--sans);
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--white);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      margin-bottom: 1.5rem;
      padding: 0.5rem 1.125rem;
      border: 1px solid #8192ca;
      background: transparent;
      border-radius: 999px;
    }

    .hero h1 {
      font-size: clamp(2.25rem, 5vw, 3.5rem);
      font-weight: 700;
      line-height: 1.1;
      letter-spacing: -0.03em;
      color: var(--white);
      margin-bottom: 1.25rem;
    }
    .hero h1 em {
      font-style: normal;
      color: var(--accent-text);
    }

    .hero-sub {
      font-size: 1.125rem;
      color: var(--gray);
      line-height: 1.6;
      max-width: 640px;
      margin-bottom: 2.5rem;
    }

    .hero-buttons {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.75rem 1.75rem;
      font-family: var(--sans);
      font-size: 0.9375rem;
      font-weight: 600;
      text-decoration: none;
      border-radius: 3px;
      transition: all 0.2s;
    }
    .btn-primary {
      background: var(--accent);
      color: #fff;
      border: 1px solid var(--accent);
    }
    .btn-primary:hover {
      background: var(--accent-dark);
      border-color: var(--accent-dark);
    }
    .btn-ghost {
      background: transparent;
      color: var(--off-white);
      border: 1px solid var(--mid);
    }
    .btn-ghost:hover {
      border-color: var(--gray);
      background: var(--dark);
    }

    /* ========= FLOW SECTION ========= */
    .flow-section {
      background: var(--black);
      padding: 5rem 2rem;
      position: relative;
    }

    .flow-section::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--mid), transparent);
    }

    .section-header {
      text-align: center;
      max-width: 640px;
      margin: 0 auto 3rem;
    }

    .section-label {
      font-family: var(--sans);
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--light-gray);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 0.75rem;
    }

    .section-header h2 {
      font-size: clamp(1.5rem, 3vw, 2.25rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--white);
      margin-bottom: 0.75rem;
    }

    .section-header p {
      color: var(--gray);
      font-size: 1rem;
      line-height: 1.6;
    }

    /* Flow Steps */
    .flow-container {
      max-width: 1000px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }

    .flow-steps {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .flow-step {
      display: flex;
      gap: 1rem;
      padding: 1rem 0;
      border-bottom: 1px solid var(--mid);
      transition: background 0.2s;
      position: relative;
      cursor: pointer;
    }
    .flow-step:hover {
      background: var(--near-black);
    }
    .flow-step.active {
      background: var(--near-black);
    }

    .step-indicator {
      display: flex;
      flex-direction: column;
      align-items: center;
      flex-shrink: 0;
      width: 2.5rem;
    }

    .step-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--mid);
      border: 2px solid var(--mid);
      transition: all 0.4s;
      flex-shrink: 0;
    }
    .flow-step.active .step-dot {
      background: var(--accent);
      border-color: var(--accent);
      box-shadow: 0 0 12px var(--accent-glow);
    }

    .step-line {
      width: 2px;
      flex: 1;
      background: var(--mid);
      transition: background 0.4s;
    }
    .flow-step.active .step-line { background: var(--accent); }
    .flow-step:last-child .step-line { display: none; }

    .step-content {
      padding-bottom: 0.5rem;
    }

    .step-num {
      font-family: var(--sans);
      font-size: 0.875rem;
      color: var(--accent-text);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 0.25rem;
    }

    .step-title {
      font-size: 1.125rem;
      font-family: inherit;
      text-align: left;
      background: none;
      border: 0;
      cursor: pointer;
      padding: 0.25rem 0;
      font-weight: 600;
      color: var(--white);
      margin-bottom: 0.25rem;
    }

    .step-desc {
      font-size: 1rem;
      overflow-wrap: anywhere;
      color: var(--gray);
      line-height: 1.5;
    }

    .step-desc code {
      font-family: var(--mono);
      font-size: 0.8125rem;
      color: #7ec8a0;
      background: rgba(126, 200, 160, 0.1);
      padding: 0.125rem 0.375rem;
      border-radius: 2px;
    }

    .step-link {
      display: inline-block;
      margin-top: 0.375rem;
      font-family: var(--sans);
      font-size: 0.9375rem;
      color: var(--accent-text);
      text-decoration: none;
      line-height: 1.6;
    }
    .step-link:hover { text-decoration: underline; }

    /* Flow JSON preview */
    .flow-json {
      background: var(--near-black);
      border: 1px solid var(--mid);
      border-radius: 4px;
      padding: 1.5rem;
      font-family: var(--mono);
      font-size: 0.875rem;
      line-height: 1.7;
      color: var(--gray);
      overflow: hidden;
      position: sticky;
      top: 2rem;
      align-self: start;
    }

    /* ========= NxM SECTION ========= */
    .nxm-section {
      background: var(--bg-light);
      color: var(--near-black);
      padding: 6rem 2rem;
    }

    .nxm-grid {
      max-width: 1000px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }

    .nxm-panel {
      padding: 2rem;
      border-radius: 6px;
      position: relative;
    }
    .nxm-panel.without {
      background: #fff;
      border: 1px solid #e0e0e0;
    }
    .nxm-panel.with {
      background: #fff;
      border: 2px solid var(--accent);
    }

    .nxm-label {
      font-family: var(--mono);
      font-size: 0.6875rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      margin-bottom: 1.5rem;
      font-weight: 500;
    }
    .nxm-panel.without .nxm-label { color: #999; }
    .nxm-panel.with .nxm-label { color: var(--accent); }

    .nxm-diagram {
      position: relative;
      margin-bottom: 1.25rem;
    }
    .nxm-diagram canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
    }

    .nxm-nodes {
      position: absolute;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .nxm-nodes.left { left: 0; top: 50%; transform: translateY(-50%); }
    .nxm-nodes.right { right: 0; top: 50%; transform: translateY(-50%); }
    .nxm-nodes.center {
      left: 50%; top: 50%;
      transform: translate(-50%, -50%);
    }

    .nxm-node {
      font-family: var(--mono);
      font-size: 0.6875rem;
      padding: 0.375rem 0.75rem;
      border-radius: 3px;
      white-space: nowrap;
      font-weight: 500;
    }
    .nxm-node.agent {
      background: var(--near-black);
      color: var(--off-white);
    }
    .nxm-node.exchange {
      background: #e8e8e8;
      color: #444;
    }
    .nxm-node.fora-hub {
      background: var(--accent);
      color: #fff;
      padding: 0.75rem 1.25rem;
      font-size: 0.8125rem;
      font-weight: 600;
      font-family: var(--sans);
    }

    /* SVG lines removed — using canvas for accurate DOM-position lines */

    .nxm-stat {
      font-size: 2.5rem;
      font-weight: 700;
      letter-spacing: -0.03em;
      line-height: 1;
      margin-bottom: 0.375rem;
    }
    .nxm-panel.without .nxm-stat { color: #bbb; }
    .nxm-panel.with .nxm-stat { color: var(--accent); }

    .nxm-caption {
      font-size: 0.875rem;
      color: #777;
      line-height: 1.5;
    }

    /* ========= ARCHITECTURE FLOW ========= */
    .arch-section {
      background: var(--black);
      padding: 5rem 2rem;
      border-top: 1px solid var(--mid);
    }

    .arch-tabs {
      display: flex;
      justify-content: center;
      gap: 0.5rem;
      flex-wrap: wrap;
      margin-bottom: 2rem;
    }
    .arch-tab {
      font-family: var(--sans);
      font-size: 1rem;
      font-weight: 600;
      min-height: 44px;
      padding: 0.5rem 1.25rem;
      background: var(--dark);
      border: 1px solid var(--mid);
      color: var(--gray);
      border-radius: 3px;
      cursor: pointer;
      transition: all 0.2s;
    }
    .arch-tab:hover { border-color: var(--accent); color: var(--off-white); }
    .arch-tab.active { background: var(--accent); border-color: var(--accent); color: #fff; }

    .arch-story {
      max-width: 1000px;
      margin: 0 auto 1.5rem;
      padding: 1.25rem 1.5rem;
      background: var(--dark);
      border-radius: 4px;
      border-left: 3px solid var(--accent);
      font-size: 1rem;
      color: var(--light-gray);
      line-height: 1.7;
    }

    .arch-container {
      max-width: 1000px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: minmax(0, 1.8fr) minmax(0, 1fr);
      gap: 2rem;
    }

    .arch-steps-list {
      display: flex;
      flex-direction: column;
      gap: 0;
      min-width: 0;
    }

    /* Each step row: number | from → to | description */
    .arch-step-row {
      display: grid;
      grid-template-columns: 2rem 12rem minmax(0, 1fr);
      width: 100%;
      font: inherit;
      text-align: left;
      background: transparent;
      color: var(--off-white);
      align-items: center;
      gap: 0.75rem;
      padding: 0.625rem 0.75rem;
      cursor: pointer;
      border-radius: 4px;
      transition: all 0.2s;
      border: 1px solid transparent;
    }
    .arch-step-row:hover {
      background: var(--dark);
    }
    .arch-step-row.active {
      background: rgba(79, 109, 245, 0.08);
      border-color: rgba(79, 109, 245, 0.3);
    }

    .arch-step-num {
      width: 2rem;
      height: 2rem;
      border-radius: 50%;
      background: var(--mid);
      color: var(--gray);
      font-family: var(--sans);
      font-size: 0.875rem;
      font-weight: 500;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: all 0.3s;
    }
    .arch-step-row.active .arch-step-num {
      background: var(--accent);
      color: #fff;
      box-shadow: 0 0 10px var(--accent-glow);
    }

    .arch-step-parties {
      display: flex;
      align-items: center;
      gap: 0.25rem;
      flex-shrink: 0;
      flex-wrap: wrap;
      min-width: 0;
    }

    .arch-party {
      font-family: var(--sans);
      font-size: 0.875rem;
      padding: 0.2rem 0.4rem;
      border-radius: 2px;
      background: var(--dark);
      color: var(--light-gray);
      border: 1px solid var(--mid);
      white-space: nowrap;
    }
    .arch-party.exchange {
      background: var(--accent);
      border-color: var(--accent);
      color: #fff;
    }
    .arch-step-row.active .arch-party {
      border-color: var(--accent);
    }

    .arch-step-arrow {
      color: var(--gray);
      font-size: 0.75rem;
      flex-shrink: 0;
    }
    .arch-step-row.active .arch-step-arrow { color: var(--accent-text); }

    .arch-step-desc {
      font-size: 1rem;
      overflow-wrap: anywhere;
      color: var(--gray);
      line-height: 1.4;
    }
    .arch-step-row.active .arch-step-desc { color: var(--light-gray); }

    /* Detail panel */
    .arch-detail {
      background: var(--near-black);
      border: 1px solid var(--mid);
      border-radius: 4px;
      padding: 1.5rem;
      font-family: var(--mono);
      font-size: 0.875rem;
      line-height: 1.7;
      color: var(--gray);
      align-self: start;
      position: sticky;
      top: 2rem;
      min-height: 200px;
      min-width: 0;
    }

    @media (max-width: 1000px) {
      .arch-container { grid-template-columns: 1fr; }
      .arch-detail { position: static; }
    }

    @media (max-width: 600px) {
      .arch-step-row { grid-template-columns: 2rem minmax(0, 1fr); }
      .arch-step-num { grid-row: span 2; }
      .arch-step-desc { grid-column: 2; }
    }

    /* ========= ROLES SECTION ========= */
    .roles-section {
      background: var(--black);
      padding: 6rem 2rem;
    }

    .roles-grid {
      max-width: 1000px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }

    .role-card {
      background: var(--near-black);
      border: 1px solid var(--mid);
      border-radius: 4px;
      padding: 2rem 1.5rem;
      cursor: pointer;
      transition: all 0.3s;
      position: relative;
      overflow: hidden;
    }
    .role-card:hover, .role-card[open] {
      border-color: var(--accent);
      background: var(--dark);
    }

    .role-icon {
      font-size: 1.5rem;
    }

    .role-title {
      font-size: 1.125rem;
      font-weight: 600;
      color: var(--white);
    }

    .role-teaser {
      font-size: 1rem;
      color: var(--gray);
      line-height: 1.5;
      margin-bottom: 0;
    }

    .role-steps {
      margin-top: 1.25rem;
    }

    .role-step {
      display: flex;
      gap: 0.75rem;
      margin-bottom: 0.75rem;
      align-items: flex-start;
    }

    .role-step-num {
      font-family: var(--sans);
      font-size: 0.875rem;
      color: var(--accent-text);
      font-weight: 500;
      flex-shrink: 0;
      padding-top: 0.125rem;
    }

    .role-step-text {
      font-size: 1rem;
      color: var(--light-gray);
      line-height: 1.5;
    }
    .role-step-text code {
      font-family: var(--mono);
      font-size: 0.75rem;
      background: var(--mid);
      padding: 0.125rem 0.375rem;
      border-radius: 2px;
      color: var(--off-white);
    }

    .role-footer {
      font-family: var(--sans);
      font-size: 0.9375rem;
      color: var(--accent-text);
      margin-top: 0.5rem;
    }

    /* ========= STANDARDS STACK ========= */
    .standards-section {
      background: var(--near-black);
      padding: 5rem 2rem;
    }

    .stack-table {
      max-width: 1000px;
      margin: 0 auto 2.5rem;
    }

    .stack-row {
      display: grid;
      grid-template-columns: 5rem 13rem minmax(0, 1fr);
      gap: 0.75rem;
      align-items: center;
      padding: 1rem 0.75rem;
      border-bottom: 1px solid var(--mid);
    }
    .stack-row:last-child { border-bottom: none; }

    .stack-row.stack-fora {
      background: rgba(79, 109, 245, 0.08);
      border: 1px solid rgba(79, 109, 245, 0.25);
      border-radius: 4px;
      margin: 0.25rem -0.25rem;
      padding: 0.625rem 1rem;
    }

    .stack-layer {
      font-family: var(--sans);
      font-size: 0.875rem;
      color: var(--gray);
      text-transform: uppercase;
    }

    .stack-name {
      font-size: 1rem;
      font-weight: 600;
      color: var(--off-white);
    }
    .stack-fora .stack-name {
      color: var(--accent-text);
    }

    .stack-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.375rem;
      align-items: center;
    }

    .standard-tag {
      font-family: var(--sans);
      font-size: 0.9375rem;
      color: var(--light-gray);
      padding: 0.2rem 0.5rem;
      background: var(--dark);
      border-radius: 2px;
      white-space: nowrap;
    }

    .standard-tag.fora-tag {
      background: var(--accent);
      color: #fff;
      font-weight: 500;
    }

    .stack-note {
      font-size: 0.9375rem;
      color: var(--accent-text);
      font-style: italic;
    }

    .standards-feeds {
      max-width: 1000px;
      margin: 0 auto;
      text-align: center;
    }

    .feeds-row {
      display: flex;
      justify-content: center;
      gap: 2rem;
      flex-wrap: wrap;
      margin-bottom: 1.5rem;
    }

    .feeds-group {
      text-align: center;
    }

    .feeds-label {
      font-family: var(--sans);
      font-size: 0.875rem;
      color: var(--gray);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 0.5rem;
    }

    .standard-tag.feed-tag {
      background: transparent;
      border: 1px solid var(--mid);
      color: var(--light-gray);
    }

    .feeds-link {
      font-family: var(--sans);
      font-size: 1rem;
      color: var(--accent-text);
      text-decoration: none;
    }
    .feeds-link:hover { text-decoration: underline; }

    @media (max-width: 768px) {
      .stack-row { grid-template-columns: 1fr; gap: 0.25rem; }
      .feeds-row { flex-direction: column; gap: 1.25rem; }
    }

    /* ========= CTA ========= */
    .cta-section {
      background: var(--black);
      padding: 6rem 2rem;
      text-align: center;
    }

    .cta-section h2 {
      font-size: clamp(1.5rem, 3vw, 2.25rem);
      font-weight: 700;
      color: var(--white);
      letter-spacing: -0.02em;
      margin-bottom: 1rem;
    }

    .cta-section p {
      color: var(--gray);
      font-size: 1rem;
      margin-bottom: 2rem;
      max-width: 520px;
      margin-left: auto;
      margin-right: auto;
      line-height: 1.6;
    }

    .cta-buttons {
      display: flex;
      gap: 1rem;
      justify-content: center;
      flex-wrap: wrap;
    }

    /* ========= FOOTER ========= */
    .site-footer {
      background: var(--near-black);
      border-top: 1px solid var(--mid);
      padding: 2.5rem 2rem;
      text-align: center;
    }

    .footer-logo {
      font-family: var(--sans);
      font-size: 1rem;
      font-weight: 600;
      letter-spacing: -0.03em;
      color: var(--off-white);
      text-transform: lowercase;
      margin-bottom: 0.5rem;
    }

    .footer-tagline {
      font-size: 0.8125rem;
      color: var(--gray);
      margin-bottom: 0.75rem;
    }

    .footer-license {
      font-size: 0.6875rem;
      color: var(--gray);
      max-width: 600px;
      margin: 0 auto;
      line-height: 1.6;
    }
    .footer-license a {
      color: var(--accent-text);
      text-decoration: underline;
    }

    /* ========= RESPONSIVE ========= */
    @media (max-width: 768px) {
      .hero-nav { padding: 1rem 1.5rem; }
      .nav-links { display: none; }
      .hero-content { padding: 3rem 1.5rem; }
      .flow-container { grid-template-columns: 1fr; }
      .flow-json { position: static; }
      .nxm-grid { grid-template-columns: 1fr; }
      .roles-grid { grid-template-columns: 1fr; }
      .role-card { padding: 1.5rem; }
    }

    /* ========= ANIMATIONS ========= */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .animate-in {
      animation: fadeUp 0.6s ease both;
    }

    .delay-1 { animation-delay: 0.1s; }
    .delay-2 { animation-delay: 0.2s; }
    .delay-3 { animation-delay: 0.3s; }
    .delay-4 { animation-delay: 0.4s; }

    :is(a, button, summary):focus-visible {
      outline: 2px solid var(--accent-text);
      outline-offset: 5px;
    }

    .nxm-section .section-label { color: #555568; }
    .role-card summary {
      display: grid;
      grid-template-columns: 1.5rem minmax(0, 1fr);
      align-items: center;
      column-gap: 0.5rem;
      row-gap: 0.75rem;
      list-style: none;
      cursor: pointer;
    }
    .role-title, .role-teaser { display: block; }
    .role-step-text { min-width: 0; overflow-wrap: anywhere; }
    .role-card summary::marker { content: ''; }
    .role-card summary::-webkit-details-marker { display: none; }
    .role-card summary .role-teaser { grid-column: 1 / -1; }
    .flow-container > * { min-width: 0; }
    .payload-code { white-space: pre-wrap; overflow-wrap: anywhere; }
    .payload-label, .payload-link, .payload-desc { font-family: var(--sans); }
    .payload-label {
      display: block;
      color: var(--light-gray);
      font-size: 0.875rem;
      font-weight: 600;
      margin-bottom: 1rem;
    }
    .payload-desc { font-size: 1rem; color: var(--light-gray); margin-bottom: 1rem; }
    .payload-link {
      display: block;
      margin-top: 1rem;
      padding-top: 0.75rem;
      border-top: 1px solid var(--mid);
      font-size: 0.9375rem;
      color: var(--accent-text);
    }
    .arch-transfer {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 1.5rem;
    }
    .arch-transfer .arch-party { padding: 0.75rem; white-space: normal; }
    .transfer-line { flex: 1; min-width: 1rem; height: 2px; background: var(--mid); }
    .transfer-line::after {
      content: '';
      display: block;
      width: 100%;
      height: 2px;
      background: var(--accent-text);
      transform-origin: left;
      animation: transfer 0.6s ease-out both;
    }
    @keyframes transfer { from { transform: scaleX(0); } to { transform: scaleX(1); } }

    @media (max-width: 768px) {
      .arch-detail { padding: 1rem; }
      .arch-step-row { padding: 0.75rem; }
      .stack-row { gap: 0.75rem; }
      .standards-feeds .stack-tags { justify-content: center; }
    }
    @media (max-width: 400px) {
      .arch-section, .flow-section, .roles-section, .standards-section, .nxm-section { padding-left: 1rem; padding-right: 1rem; }
      .nxm-panel { padding: 1rem 0.5rem; }
    }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after { animation: none !important; transition: none !important; }
    }
  </style>
</head>
<body>

  <!-- HERO -->
  <section class="hero">
    <nav class="hero-nav">
      <a href="/" class="logo">fora protocol</a>
      <ul class="nav-links">
        <li><a href="/getting-started/what-is-fora/">Docs</a></li>
        <li><a href="/protocol/transaction-flow/">Protocol</a></li>
        <li><a href="https://github.com/FORA-Protocol/protocol">GitHub</a></li>
      </ul>
    </nav>

    <div class="hero-content">
      <div class="hero-badge">Open Protocol · Apache 2.0</div>
      <h1 class="animate-in delay-1">AI agents consume content.<br><em>Nobody gets paid.</em></h1>
      <p class="hero-sub animate-in delay-2">FORA is the open transaction protocol that turns blocked bots into paying customers. Discover, price, transact, deliver, verify — one protocol for any content.</p>
      <div class="hero-buttons animate-in delay-3">
        <a href="/getting-started/what-is-fora/" class="btn btn-primary">Read the Docs</a>
        <a href="https://github.com/FORA-Protocol/protocol" class="btn btn-ghost">View on GitHub</a>
      </div>
    </div>
  </section>

  <!-- ARCHITECTURE FLOW (scenarios) -->
  <section class="arch-section">
    <div class="section-header">
      <div class="section-label">How FORA Works</div>
      <h2>Multiple scenarios. Same protocol. Click each step.</h2>
    </div>

    <div class="arch-tabs">
      <button class="arch-tab active" aria-pressed="true" id="archTab0" onclick="switchScenario(0)">Web article access</button>
      <button class="arch-tab" aria-pressed="false" id="archTab1" onclick="switchScenario(1)">Music sample licensing</button>
    </div>

    <div class="arch-story" id="archStory"></div>

    <div class="arch-container">
      <div class="arch-steps-list" id="archStepsList"></div>
      <div class="arch-detail" id="archDetail">
        <div class="arch-detail-inner" id="archDetailInner"></div>
      </div>
    </div>
  </section>

  <!-- TRANSACTION FLOW -->
  <section class="flow-section">
    <div class="section-header">
      <div class="section-label">How It Works</div>
      <h2>Six steps. One protocol.</h2>
      <p>Every FORA transaction follows the same flow — regardless of content type, pricing model, or Exchange.</p>
    </div>

    <div class="flow-container">
      <div class="flow-steps" id="flowSteps">
        <div class="flow-step active" data-step="0">
          <div class="step-indicator">
            <div class="step-dot"></div>
            <div class="step-line"></div>
          </div>
          <div class="step-content">
            <div class="step-num">Step 1</div>
            <button type="button" class="step-title" aria-controls="flowJson">Discover</button>
            <div class="step-desc">Agent checks <code>/.well-known/fora.json</code> — finds the Exchange endpoint for this publisher.</div>
            <a class="step-link" href="/protocol/discovery-paths/">Discovery Paths →</a>
          </div>
        </div>
        <div class="flow-step" data-step="1">
          <div class="step-indicator">
            <div class="step-dot"></div>
            <div class="step-line"></div>
          </div>
          <div class="step-content">
            <div class="step-num">Step 2</div>
            <button type="button" class="step-title" aria-controls="flowJson">Query</button>
            <div class="step-desc">Agent calls <code>DiscoverResources</code> — Exchange returns signed Offers with pricing, attestations, and previews.</div>
            <a class="step-link" href="/protocol/transaction-flow/">Transaction Flow →</a>
          </div>
        </div>
        <div class="flow-step" data-step="2">
          <div class="step-indicator">
            <div class="step-dot"></div>
            <div class="step-line"></div>
          </div>
          <div class="step-content">
            <div class="step-num">Step 3</div>
            <button type="button" class="step-title" aria-controls="flowJson">Transact</button>
            <div class="step-desc">Agent commits via <code>ExecuteTransaction</code> — gets a signed delivery URL and <code>billing_id</code>.</div>
            <a class="step-link" href="/protocol/transaction-flow/#rpc-2-executetransaction">ExecuteTransaction →</a>
          </div>
        </div>
        <div class="flow-step" data-step="3">
          <div class="step-indicator">
            <div class="step-dot"></div>
            <div class="step-line"></div>
          </div>
          <div class="step-content">
            <div class="step-num">Step 4</div>
            <button type="button" class="step-title" aria-controls="flowJson">Deliver</button>
            <div class="step-desc">Agent fetches from CDN via signed URL. Time-limited, identity-bound, <code>content_hash</code> verifiable.</div>
            <a class="step-link" href="/protocol/content-attestation/">Content Attestation →</a>
          </div>
        </div>
        <div class="flow-step" data-step="4">
          <div class="step-indicator">
            <div class="step-dot"></div>
            <div class="step-line"></div>
          </div>
          <div class="step-content">
            <div class="step-num">Step 5</div>
            <button type="button" class="step-title" aria-controls="flowJson">Report</button>
            <div class="step-desc">Agent calls <code>ReportUsage</code> — reports actual consumption: tokens, pages, minutes, records.</div>
            <a class="step-link" href="/protocol/transaction-flow/#rpc-3-reportusage">ReportUsage →</a>
          </div>
        </div>
        <div class="flow-step" data-step="5">
          <div class="step-indicator">
            <div class="step-dot"></div>
          </div>
          <div class="step-content">
            <div class="step-num">Step 6</div>
            <button type="button" class="step-title" aria-controls="flowJson">Dispute</button>
            <div class="step-desc">If content doesn't match — <code>DisputeTransaction</code> triggers automated 3-tier resolution.</div>
            <a class="step-link" href="/protocol/dispute-resolution/">Dispute Resolution →</a>
          </div>
        </div>
      </div>

      <div class="flow-json" id="flowJson"></div>
    </div>
  </section>

  <!-- N×M vs N+M -->
  <section class="nxm-section">
    <div class="section-header" style="color: var(--near-black);">
      <div class="section-label">The Problem FORA Solves</div>
      <h2 style="color: var(--near-black);">Publishers locked behind walled gardens vs. open access</h2>
      <p style="color: #777;">Today, publishers are gated behind exclusive platform deals. Agents need separate integrations for each. FORA opens the market.</p>
    </div>

    <div class="nxm-grid">
      <!-- Without FORA -->
      <div class="nxm-panel without" id="nxmWithout">
        <div class="nxm-label">Today — walled gardens</div>
        <div class="nxm-diagram" id="diagramWithout" style="display:flex;justify-content:space-between;align-items:center;gap:0;padding:1.5rem 0;position:relative;">
          <div style="display:flex;flex-direction:column;gap:8px;flex-shrink:0;">
            <div class="nxm-node agent" data-nxm="a" style="padding:0.3rem 0.5rem;font-size:0.625rem;">A1</div>
            <div class="nxm-node agent" data-nxm="a" style="padding:0.3rem 0.5rem;font-size:0.625rem;">A2</div>
            <div class="nxm-node agent" data-nxm="a" style="padding:0.3rem 0.5rem;font-size:0.625rem;">A3</div>
          </div>
          <div style="display:flex;flex-direction:column;gap:10px;flex-shrink:0;">
            <div class="nxm-node" style="background:#e74c3c;color:#fff;font-weight:600;font-size:0.625rem;padding:0.3rem 0.75rem;" data-nxm="p">TollBit</div>
            <div class="nxm-node" style="background:#e74c3c;color:#fff;font-weight:600;font-size:0.625rem;padding:0.3rem 0.75rem;" data-nxm="p">PCM</div>
            <div class="nxm-node" style="background:#e74c3c;color:#fff;font-weight:600;font-size:0.625rem;padding:0.3rem 0.75rem;" data-nxm="p">Dappier</div>
          </div>
          <div style="display:flex;flex-direction:column;gap:6px;flex-shrink:0;">
            <div class="nxm-node" style="background:#f5f5f5;color:#888;font-size:0.75rem;border:1px dashed #ccc;padding:0.35rem 0.75rem;font-weight:500;" data-nxm="pub">NYT</div>
            <div class="nxm-node" style="background:#f5f5f5;color:#888;font-size:0.75rem;border:1px dashed #ccc;padding:0.35rem 0.75rem;font-weight:500;" data-nxm="pub">Reuters</div>
            <div class="nxm-node" style="background:#f5f5f5;color:#888;font-size:0.75rem;border:1px dashed #ccc;padding:0.35rem 0.75rem;font-weight:500;" data-nxm="pub">AP</div>
            <div class="nxm-node" style="background:#f5f5f5;color:#888;font-size:0.75rem;border:1px dashed #ccc;padding:0.35rem 0.75rem;font-weight:500;" data-nxm="pub">WSJ</div>
            <div class="nxm-node" style="background:#f5f5f5;color:#888;font-size:0.75rem;border:1px dashed #ccc;padding:0.35rem 0.75rem;font-weight:500;" data-nxm="pub">Nature</div>
          </div>
          <canvas id="canvasWithout"></canvas>
        </div>
        <div class="nxm-stat">Walled gardens</div>
        <div class="nxm-caption">Publishers locked behind exclusive platform deals. Each agent needs a separate proprietary integration. Publishers can't switch. Agents can't compare.</div>
      </div>

      <!-- With FORA -->
      <div class="nxm-panel with" id="nxmWith">
        <div class="nxm-label">With FORA — open market</div>
        <div class="nxm-diagram" id="diagramWith" style="display:flex;justify-content:space-between;align-items:center;gap:0;padding:1.5rem 0;position:relative;">
          <div style="display:flex;flex-direction:column;gap:8px;flex-shrink:0;">
            <div class="nxm-node agent" data-nxm="a2" style="padding:0.3rem 0.5rem;font-size:0.625rem;">A1</div>
            <div class="nxm-node agent" data-nxm="a2" style="padding:0.3rem 0.5rem;font-size:0.625rem;">A2</div>
            <div class="nxm-node agent" data-nxm="a2" style="padding:0.3rem 0.5rem;font-size:0.625rem;">A3</div>
          </div>
          <div style="flex-shrink:0;">
            <div class="nxm-node fora-hub" data-nxm="fora" style="padding:0.5rem 1rem;font-size:0.75rem;">FORA</div>
          </div>
          <div style="display:flex;flex-direction:column;gap:8px;flex-shrink:0;">
            <div class="nxm-node" style="background:#4f6df5;color:#fff;font-size:0.6rem;font-weight:500;padding:0.25rem 0.5rem;" data-nxm="ex">Ex 1</div>
            <div class="nxm-node" style="background:#4f6df5;color:#fff;font-size:0.6rem;font-weight:500;padding:0.25rem 0.5rem;" data-nxm="ex">Ex 2</div>
            <div class="nxm-node" style="background:#4f6df5;color:#fff;font-size:0.6rem;font-weight:500;padding:0.25rem 0.5rem;" data-nxm="ex">Ex 3</div>
          </div>
          <div style="display:flex;flex-direction:column;gap:5px;flex-shrink:0;">
            <div class="nxm-node" style="background:#f0f5ff;color:#4f6df5;font-size:0.75rem;border:1px solid #c0d0ff;padding:0.35rem 0.75rem;font-weight:500;" data-nxm="pub2">NYT</div>
            <div class="nxm-node" style="background:#f0f5ff;color:#4f6df5;font-size:0.75rem;border:1px solid #c0d0ff;padding:0.35rem 0.75rem;font-weight:500;" data-nxm="pub2">Reuters</div>
            <div class="nxm-node" style="background:#f0f5ff;color:#4f6df5;font-size:0.75rem;border:1px solid #c0d0ff;padding:0.35rem 0.75rem;font-weight:500;" data-nxm="pub2">AP</div>
            <div class="nxm-node" style="background:#f0f5ff;color:#4f6df5;font-size:0.75rem;border:1px solid #c0d0ff;padding:0.35rem 0.75rem;font-weight:500;" data-nxm="pub2">WSJ</div>
            <div class="nxm-node" style="background:#f0f5ff;color:#4f6df5;font-size:0.75rem;border:1px solid #c0d0ff;padding:0.35rem 0.75rem;font-weight:500;" data-nxm="pub2">Nature</div>
          </div>
          <canvas id="canvasWith"></canvas>
        </div>
        <div class="nxm-stat">Open market</div>
        <div class="nxm-caption">Publishers choose Exchanges. Exchanges compete. Agents access any publisher through any Exchange — one protocol.</div>
      </div>
    </div>
  </section>

  <!-- PICK YOUR ROLE -->
  <section class="roles-section">
    <div class="section-header">
      <div class="section-label">Get Started</div>
      <h2>Pick your role</h2>
      <p>Three roles, three deployment paths. Click to see yours.</p>
    </div>

    <div class="roles-grid">
      <details class="role-card" name="roles">
        <summary>
          <span class="role-icon">&#9881;</span>
          <span class="role-title">I'm a Publisher</span>
          <span class="role-teaser">Stop losing revenue to AI scrapers. Monetize every bot visit without changing your CMS.</span>
        </summary>
        <div class="role-steps">
          <div class="role-step">
            <div class="role-step-num">01</div>
            <div class="role-step-text">Drop <code>rsl.txt</code> on your domain — declare your pricing and usage terms.</div>
          </div>
          <div class="role-step">
            <div class="role-step-num">02</div>
            <div class="role-step-text">Drop <code>fora.json</code> at <code>/.well-known/</code> — declare which Exchanges can sell your content.</div>
          </div>
          <div class="role-step">
            <div class="role-step-num">03</div>
            <div class="role-step-text">Deploy the edge function on your CDN. One function, &lt;2ms overhead. Bots get redirected to your Exchange.</div>
          </div>
          <div class="role-step">
            <div class="role-step-num">04</div>
            <div class="role-step-text">Done. Blocked bots become paying customers. No CMS changes. No new infrastructure.</div>
          </div>
          <div class="role-footer">Two files and one function &rarr;</div>
        </div>
      </details>

      <details class="role-card" name="roles">
        <summary>
          <span class="role-icon">&#9881;</span>
          <span class="role-title">I Run AI Agents</span>
          <span class="role-teaser">Access premium content legally with one protocol. No scraping, no legal risk, any Exchange.</span>
        </summary>
        <div class="role-steps">
          <div class="role-step">
            <div class="role-step-num">01</div>
            <div class="role-step-text">Add the FORA SDK or MCP server to your agent. One dependency.</div>
          </div>
          <div class="role-step">
            <div class="role-step-num">02</div>
            <div class="role-step-text">Query Exchanges with <code>DiscoverResources</code>. Compare offers by <code>unit_cost</code> across providers.</div>
          </div>
          <div class="role-step">
            <div class="role-step-num">03</div>
            <div class="role-step-text">Execute, fetch, report — one protocol for articles, images, data, streams. Priced per unit, flat, or free.</div>
          </div>
          <div class="role-step">
            <div class="role-step-num">04</div>
            <div class="role-step-text">If content doesn't match, <code>DisputeTransaction</code> triggers automatic resolution. Cryptographic evidence, not arguments.</div>
          </div>
          <div class="role-footer">One API, any Exchange &rarr;</div>
        </div>
      </details>

      <details class="role-card" name="roles">
        <summary>
          <span class="role-icon">&#9881;</span>
          <span class="role-title">I Run an Exchange</span>
          <span class="role-teaser">Aggregate provider catalogs. Handle transactions. Earn a margin on every access.</span>
        </summary>
        <div class="role-steps">
          <div class="role-step">
            <div class="role-step-num">01</div>
            <div class="role-step-text">Implement <code>ExchangeService</code> — 4 RPCs: Discover, Transact, Report, Dispute.</div>
          </div>
          <div class="role-step">
            <div class="role-step-num">02</div>
            <div class="role-step-text">Ingest provider catalogs from <code>rsl.txt</code>. Build your resource catalog with pricing and restrictions.</div>
          </div>
          <div class="role-step">
            <div class="role-step-num">03</div>
            <div class="role-step-text">Serve signed offers. Ed25519 signatures prevent intermediary tampering. Stateless verification.</div>
          </div>
          <div class="role-step">
            <div class="role-step-num">04</div>
            <div class="role-step-text">Plug in your billing adapter — Stripe, x402, or custom. FORA handles the transaction; you handle settlement.</div>
          </div>
          <div class="role-footer">Like an ad exchange, but for content &rarr;</div>
        </div>
      </details>
    </div>
  </section>

  <!-- STANDARDS STACK -->
  <section class="standards-section">
    <div class="section-header">
      <div class="section-label">Standards Interoperability</div>
      <h2>FORA doesn't replace anything. It connects everything.</h2>
      <p>Every building block is an existing open standard. FORA is the transaction layer that was missing.</p>
    </div>

    <div class="stack-table">
      <div class="stack-row">
        <div class="stack-layer">Layer 5</div>
        <div class="stack-name">Orchestration</div>
        <div class="stack-tags">
          <span class="standard-tag">LangGraph</span>
          <span class="standard-tag">CrewAI</span>
          <span class="standard-tag">OpenAI Agents</span>
        </div>
      </div>
      <div class="stack-row stack-fora">
        <div class="stack-layer">Layer 4</div>
        <div class="stack-name">Transaction &amp; Metering</div>
        <div class="stack-tags">
          <span class="standard-tag fora-tag">FORA Protocol</span>
          <span class="stack-note">← this layer was empty</span>
        </div>
      </div>
      <div class="stack-row">
        <div class="stack-layer">Layer 3</div>
        <div class="stack-name">Payment Rails</div>
        <div class="stack-tags">
          <span class="standard-tag">Stripe</span>
          <span class="standard-tag">x402</span>
          <span class="standard-tag">L402</span>
        </div>
      </div>
      <div class="stack-row">
        <div class="stack-layer">Layer 2</div>
        <div class="stack-name">Identity &amp; Auth</div>
        <div class="stack-tags">
          <span class="standard-tag">GNAP</span>
          <span class="standard-tag">OAuth 2.0</span>
          <span class="standard-tag">WebBotAuth</span>
          <span class="standard-tag">JWT</span>
        </div>
      </div>
      <div class="stack-row">
        <div class="stack-layer">Layer 1</div>
        <div class="stack-name">Communication</div>
        <div class="stack-tags">
          <span class="standard-tag">MCP</span>
          <span class="standard-tag">A2A</span>
          <span class="standard-tag">NLWeb</span>
        </div>
      </div>
      <div class="stack-row">
        <div class="stack-layer">Layer 0</div>
        <div class="stack-name">Transport</div>
        <div class="stack-tags">
          <span class="standard-tag">HTTP/2</span>
          <span class="standard-tag">gRPC</span>
          <span class="standard-tag">WebSocket</span>
        </div>
      </div>
    </div>

    <div class="standards-feeds">
      <div class="feeds-row">
        <div class="feeds-group">
          <div class="feeds-label">FORA ingests</div>
          <div class="stack-tags">
            <span class="standard-tag feed-tag">RSL 1.0</span>
            <span class="standard-tag feed-tag">TDMRep</span>
            <span class="standard-tag feed-tag">C2PA</span>
            <span class="standard-tag feed-tag">CoMP</span>
          </div>
        </div>
        <div class="feeds-group">
          <div class="feeds-label">FORA signs with</div>
          <div class="stack-tags">
            <span class="standard-tag feed-tag">Ed25519</span>
