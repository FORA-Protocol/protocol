---
// Landing page — overrides Starlight's default index.
// The protocol detail (six-step flow, worked scenarios, standards stack) is on
// /protocol/, built from the blocks that used to live here.
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { BUILD_LINKS } from '../consts';
import '../styles/brand.css';
import '../styles/landing.css';

const SERVER_URL = BUILD_LINKS[BUILD_LINKS.length - 1].url;

// The two worked examples in "If you can write it in a contract". One switch
// shows either; both tables have the same rows, so they line up.
// The track is the music demo (/getting-started/live-demo-music/, Harmonia
// Records); the article is an example.
const EXAMPLES = [
  {
    id: 'article',
    tab: 'An article',
    title: 'One article, three uses',
    cols: ['Search and citation', 'AI answer input', 'AI training'],
    rows: [
      { label: 'Price', cells: ['Free', '$0.05 per fetch', 'Not offered'], price: true },
      { label: 'Who may buy', cells: ['Any identified agent', 'Any identified agent', '—'] },
      { label: 'Allowed', cells: ['Search index, citation', 'Input to an AI answer', '—'] },
      { label: 'Not allowed', cells: ['AI training', 'AI training', '—'] },
      { label: 'Obligations', cells: ['Attribution', 'Attribution; usage report', '—'] },
    ],
    note: 'An example. You set your own prices and uses.',
    offer: {
      name: 'AI answer input',
      fields: [
        ['who may buy', 'any identified agent'],
        ['allowed', 'ai-input'],
        ['not allowed', 'ai-train'],
        ['where', 'worldwide'],
        ['for how long', 'one answer'],
        ['price', 'USD 0.05 per fetch'],
        ['obligations', 'attribution, usage report'],
        ['license', 'news.example/license.txt'],
      ],
      digest: 'license sha256:4c1f9a07…',
      note: 'An example offer for one article.',
    },
  },
  {
    id: 'track',
    tab: 'A track',
    title: 'One track, three licenses',
    cols: ['Online Creator', 'Broadcast', 'Advertising'],
    rows: [
      { label: 'Price', cells: ['€29', '€450', '€1,200'], price: true },
      { label: 'Who may buy', cells: ['Individuals', 'Broadcasters, companies', 'Companies'] },
      { label: 'Allowed', cells: ['Personal video, online', 'Sync, broadcast, streaming', 'Sync, advertising, broadcast, streaming'] },
      { label: 'Not allowed', cells: ['Commercial use, AI training', 'Advertising, AI training', 'Editorial, AI training'] },
      { label: 'Obligations', cells: ['Attribution', 'One production; cue sheet through the broadcaster', 'One ad; placement records; cue sheet for TV'] },
    ],
    note: 'The three licenses of the music demo. Fictional licenses, test money, no real rights.',
    offer: {
      name: 'Online Creator',
      fields: [
        ['who may buy', 'individual'],
        ['allowed', 'sync, stream'],
        ['not allowed', 'ai-train, advertising, broadcast'],
        ['where', 'worldwide'],
        ['for how long', 'perpetual, 1 production'],
        ['price', 'EUR 29, once'],
        ['obligations', 'attribution'],
        ['license', 'music-v0.1.txt'],
      ],
      digest: 'license sha256:bfab2a18…',
      note: 'From the music demo. Fictional license, test money.',
    },
  },
];

const FAQ = [
  {
    q: 'Does FORA bring me buyers?',
    a: 'No, and neither does your online store. It makes sure that when an agent comes looking, it can find you, understand your terms and pay, instead of hitting a 403 or scraping you.',
  },
  {
    q: 'Who can see my catalog and metadata?',
    a: 'No one anonymously. Every request comes from an identified agent. You decide what an agent sees before it buys and what it gets only with a license. If you prefer, search runs on your own servers and your index never leaves.',
  },
  {
    q: 'Do I have to give up my existing deals?',
    a: 'No. Keep them. Support for running existing deals and subscriptions over FORA is on the roadmap.',
  },
  {
    q: 'What about AI training?',
    a: "Training is a separate permission, and it is off unless you offer it. A paid fetch doesn't include it.",
  },
  {
    q: 'What does it cost?',
    a: 'The protocol and FORA Server are free and open source. Run it yourself, or <a href="/getting-started/publisher-onboarding/">have it hosted for you</a>.',
  },
  {
    q: 'Is this a standard?',
    a: 'It is an open protocol with no central registry. It builds on the standards each industry already uses: IAB Tech Lab CoMP, RSL and Web Bot Auth for the web, and DDEX, ISRC, ISWC and IPI for music.',
  },
];
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta property="og:image" content="https://fora-protocol.org/brand/fora-social-card.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <title>FORA — Every AI agent is a customer. FORA is your storefront.</title>
  <meta name="description" content="FORA lets any AI agent find your pages or tracks, read your license, pay, and get a signed receipt. You decide every term. An open protocol, Apache 2.0." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style is:global>
    /* ========= SHARED ON THIS PAGE ========= */
    .band {
      padding: 6rem 2rem;
      position: relative;
    }
    .band-black { background: var(--black); }
    .band-near { background: var(--near-black); }
    .wrap { max-width: 1100px; margin: 0 auto; }
    .kicker {
      font-family: var(--mono);
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--accent-text);
      margin-bottom: 0.5rem;
    }
    .text-link {
      color: var(--accent-text);
      font-size: 0.9375rem;
      font-weight: 500;
      text-decoration: none;
    }
    .text-link:hover { text-decoration: underline; }
    .split-head h2 {
      font-size: clamp(1.75rem, 3.4vw, 2.5rem);
      font-weight: 700;
      letter-spacing: -0.03em;
      line-height: 1.12;
      color: var(--white);
    }

    /* ========= HERO EXTRAS ========= */
    .hero h1 { max-width: 15em; }
    .hero-resources a.is-server {
      border-color: var(--accent);
      color: var(--white);
    }
    .hero-resources a.is-server small {
      color: var(--gray);
      font-size: 0.8125rem;
      font-weight: 400;
    }

    /* ========= 2. STOREFRONT ========= */
    .story {
      display: grid;
      grid-template-columns: 5fr 7fr;
      gap: 4rem;
      align-items: start;
    }
    .story-body p {
      color: var(--gray);
      font-size: 1.125rem;
      line-height: 1.7;
      margin-bottom: 1.25rem;
    }
    .story-body p:last-child { margin-bottom: 0; }
    .story-body .story-turn {
      color: var(--light-gray);
      padding-left: 1.25rem;
      border-left: 2px solid var(--accent);
    }
    .story-body strong { color: var(--white); font-weight: 600; }

    /* ========= 3. BLOCK, ALLOW, OR LICENSE ========= */
    .options-grid {
      display: grid;
      grid-template-columns: 1fr 1fr 1.25fr;
      gap: 1.25rem;
      align-items: stretch;
    }
    .option {
      background: var(--black);
      border: 1px solid var(--mid);
      border-radius: 10px;
      padding: 1.75rem 1.5rem;
    }
    .option .kicker { color: var(--gray); }
    .option h3 {
      font-size: 1.375rem;
      font-weight: 600;
      letter-spacing: -0.02em;
      color: var(--off-white);
      margin-bottom: 0.75rem;
    }
    .option p { color: var(--gray); font-size: 1rem; line-height: 1.6; }
    .option-fora {
      border: 1px solid var(--accent);
      background:
        radial-gradient(ellipse 90% 80% at 50% 0%, var(--accent-glow) 0%, transparent 70%),
        var(--dark);
    }
    .option-fora .kicker { color: var(--accent-text); }
    .option-fora h3 { color: var(--white); }
    .option-fora p { color: var(--light-gray); }
    .free-note {
      margin-top: 1.5rem;
      padding: 1.25rem 1.5rem;
      border: 1px dashed var(--mid);
      border-radius: 10px;
      color: var(--gray);
      font-size: 1rem;
      line-height: 1.6;
      text-align: center;
    }
    .free-note strong { color: var(--white); font-weight: 600; }

    /* ========= 4. TERMS (light band) ========= */
    .terms-section {
      background: var(--bg-light);
      color: var(--near-black);
      padding: 6rem 2rem;
    }
    .terms-section .section-label { color: #555568; }
    .terms-section .split-head h2 { color: var(--black); }
    .terms-top {
      display: grid;
      grid-template-columns: 1fr minmax(0, 420px);
      gap: 4rem;
      align-items: center;
      margin-bottom: 4rem;
    }
    .terms-copy h2 { margin-bottom: 1.5rem; }
    .terms-copy p {
      color: #444456;
      font-size: 1.0625rem;
      line-height: 1.7;
      margin-bottom: 1rem;
    }
    .terms-copy p:last-child { margin-bottom: 0; }
    .terms-copy strong { color: var(--black); font-weight: 600; }

    .offer-card {
      background: var(--black);
      border-radius: 10px;
      padding: 1.5rem;
      font-family: var(--mono);
      font-size: 0.8125rem;
      color: var(--gray);
      box-shadow: 0 24px 60px -24px rgba(10, 10, 15, 0.45);
    }
    .offer-card-head {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      padding-bottom: 0.875rem;
      margin-bottom: 0.875rem;
      border-bottom: 1px solid var(--mid);
      color: var(--off-white);
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }
    .offer-card-head span:last-child { color: var(--gray); }
    .offer-card dl {
      display: grid;
      grid-template-columns: max-content 1fr;
      gap: 0.5rem 1rem;
    }
    .offer-card dt { color: var(--gray); }
    .offer-card dd { color: var(--off-white); }
    .offer-card dd.price { color: var(--white); font-weight: 500; }
    .offer-sig {
      margin-top: 0.875rem;
      padding-top: 0.875rem;
      border-top: 1px solid var(--mid);
      color: var(--accent-text);
      overflow-wrap: anywhere;
    }
    [data-examples]:not(.js) [data-example] + [data-example] { margin-top: 1.5rem; }
    .offer-card-note {
      margin-top: 0.75rem;
      font-family: var(--sans);
      font-size: 0.8125rem;
      color: #6b6b80;
      text-align: center;
    }

    .sync-quote {
      max-width: 820px;
      margin: 0 auto 4rem;
      text-align: center;
      font-size: clamp(1.125rem, 2vw, 1.375rem);
      line-height: 1.55;
      color: #2a2a3a;
      letter-spacing: -0.01em;
    }
    .sync-quote strong { color: var(--black); font-weight: 600; }

    .table-card {
      background: #fff;
      border: 1px solid #e4e4ec;
      border-radius: 10px;
      padding: 1.5rem;
      min-width: 0;
    }
    .table-card h3 {
      font-size: 1.125rem;
      font-weight: 600;
      letter-spacing: -0.01em;
      color: var(--black);
      margin-bottom: 1rem;
    }
    .table-scroll { overflow-x: auto; }
    .table-card table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.9375rem;
      line-height: 1.45;
    }
    .example-table { table-layout: fixed; min-width: 560px; }
    .example-table .col-label { width: 8.5rem; }
    .example-switch {
      display: flex;
      gap: 0.25rem;
      width: fit-content;
      margin: 0 auto 1rem;
      padding: 0.25rem;
      border: 1px solid #dcdce6;
      border-radius: 999px;
      background: #fff;
    }
    .example-switch button {
      font: 600 0.875rem var(--sans);
      color: #444456;
      background: transparent;
      border: 0;
      border-radius: 999px;
      padding: 0.45rem 1.1rem;
      cursor: pointer;
    }
    .example-switch button[aria-pressed='true'] { background: var(--accent-dark); color: #fff; }
    .example-switch button:focus-visible { outline: 2px solid var(--accent-dark); outline-offset: 2px; }
    [data-examples].js [data-example][hidden] { display: none; }
    .terms-live {
      margin-top: 2.5rem;
      text-align: center;
      color: #444456;
      font-weight: 500;
    }
    .terms-live + .terms-links { margin-top: 0.75rem; }
    .table-card th,
    .table-card td {
      text-align: left;
      vertical-align: top;
      padding: 0.625rem 0.75rem;
      border-top: 1px solid #ececf2;
    }
    .table-card thead th,
    .table-card thead td {
      border-top: 0;
      font-family: var(--mono);
      font-size: 0.75rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--accent-dark);
    }
    .table-card tr > :first-child { padding-left: 0; }
    .table-card tbody th {
      font-weight: 600;
      color: var(--black);
      white-space: nowrap;
      padding-left: 0;
    }
    .table-card td { color: #444456; }
    .table-card tr.price td {
      font-weight: 700;
      font-size: 1.125rem;
      color: var(--black);
    }
    .table-note {
      margin-top: 1rem;
      font-size: 0.8125rem;
      color: #6b6b80;
      line-height: 1.5;
    }
    .terms-links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem 2rem;
      justify-content: center;
      margin-top: 2.5rem;
    }
    .terms-links a {
      color: var(--accent-dark);
      font-weight: 600;
      text-decoration: none;
    }
    .terms-links a:hover { text-decoration: underline; }
    .terms-section :is(a):focus-visible { outline-color: var(--accent-dark); }

    /* ========= 5. HOW A SALE WORKS ========= */
    .sale-steps {
      list-style: none;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
      counter-reset: sale;
    }
    .sale-steps li {
      counter-increment: sale;
      position: relative;
      padding-top: 3.25rem;
    }
    .sale-steps li::before {
      content: counter(sale, decimal-leading-zero);
      position: absolute;
      top: 0;
      left: 0;
      width: 2.25rem;
      height: 2.25rem;
      display: grid;
      place-items: center;
      border-radius: 50%;
      border: 1px solid var(--accent);
      background: var(--black);
      color: var(--accent-text);
      font-family: var(--mono);
      font-size: 0.8125rem;
      z-index: 1;
    }
    .sale-steps li:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 1.125rem;
      left: 2.75rem;
      right: -1.5rem;
      height: 1px;
      background: linear-gradient(90deg, var(--accent), var(--mid));
    }
    .sale-steps h3 {
      font-size: 1.25rem;
      font-weight: 600;
      color: var(--white);
      margin-bottom: 0.5rem;
    }
    .sale-steps p { color: var(--gray); line-height: 1.6; }
    .center-link { text-align: center; margin-top: 3rem; }

    /* ========= 6. BUILT FOR WHAT YOU HAVE ========= */
    .have-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
    .have-card {
      display: flex;
      flex-direction: column;
      background: var(--black);
      border: 1px solid var(--mid);
      border-top: 2px solid var(--accent);
      border-radius: 10px;
      padding: 1.75rem 1.5rem;
    }
    .have-card h3 {
      font-size: 1.25rem;
      font-weight: 600;
      letter-spacing: -0.02em;
      line-height: 1.3;
      color: var(--white);
      margin-bottom: 1rem;
    }
    .have-card p {
      color: var(--light-gray);
      font-size: 0.9375rem;
      line-height: 1.6;
      margin-bottom: 0.875rem;
    }
    .have-card .text-link { margin-top: auto; padding-top: 0.5rem; }

    /* ========= 7. FAQ ========= */
    .faq-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0 3rem;
    }
    .faq-item {
      padding: 1.5rem 0;
      border-top: 1px solid var(--mid);
    }
    .faq-item h3 {
      font-size: 1.125rem;
      font-weight: 600;
      color: var(--white);
      margin-bottom: 0.5rem;
    }
    .faq-item p { color: var(--gray); line-height: 1.65; }
    .faq-item a { color: var(--accent-text); text-decoration: underline; text-underline-offset: 3px; }
    .faq-item a:hover { color: var(--white); }

    /* ========= 8. THE STACK ========= */
    .stack-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }
    .piece {
      background: var(--black);
      border: 1px solid var(--mid);
      border-radius: 10px;
      padding: 1.5rem 1.25rem;
    }
    .piece h3 {
      font-size: 1.0625rem;
      font-weight: 600;
      color: var(--white);
      margin-bottom: 0.5rem;
    }
    .piece p { color: var(--gray); font-size: 0.9375rem; line-height: 1.55; }
    .piece-full {
      border-color: var(--accent);
      background:
        radial-gradient(ellipse 100% 80% at 50% 0%, var(--accent-glow) 0%, transparent 75%),
        var(--dark);
    }
    .piece-full p { color: var(--light-gray); }
    .toggle {
      display: inline-flex;
      margin-bottom: 0.75rem;
      border: 1px solid var(--mid);
      border-radius: 999px;
      font-family: var(--mono);
      font-size: 0.6875rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      overflow: hidden;
    }
    .toggle span { padding: 0.2rem 0.6rem; color: var(--gray); }
    .toggle span:first-child { background: var(--accent-dark); color: #fff; }
    .stack-buttons {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      justify-content: center;
      margin-top: 2.5rem;
    }

    /* ========= 9. OPEN NETWORK ========= */
    .net {
      display: grid;
      grid-template-columns: 1fr 1.1fr;
      gap: 4rem;
      align-items: center;
    }
    .net-copy h2 { margin-bottom: 1.5rem; }
    .net-copy p {
      color: var(--gray);
      font-size: 1.0625rem;
      line-height: 1.7;
      margin-bottom: 1rem;
    }
    .net-panel {
      background: var(--near-black);
      border: 1px solid var(--mid);
      border-radius: 10px;
      padding: 1.5rem;
    }
    .net-diagram {
      position: relative;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem 0;
    }
    .net-diagram canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
    }
    .net-col {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      position: relative;
      z-index: 1;
    }
    .net-col-label {
      font-family: var(--mono);
      font-size: 0.625rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--gray);
      text-align: center;
      margin-bottom: 0.25rem;
    }
    .net-node {
      font-family: var(--mono);
      font-size: 0.6875rem;
      padding: 0.35rem 0.6rem;
      border-radius: 3px;
      white-space: nowrap;
      text-align: center;
    }
    .net-node.agent { background: var(--dark); color: var(--off-white); border: 1px solid var(--mid); }
    .net-node.hub {
      background: var(--accent);
      color: #fff;
      font-family: var(--sans);
      font-weight: 600;
      font-size: 0.8125rem;
      padding: 0.6rem 0.9rem;
      line-height: 1.3;
    }
    .net-node.hub small { display: block; font-weight: 400; font-size: 0.625rem; opacity: 0.85; }
    .net-node.ex { background: var(--black); color: var(--accent-text); border: 1px solid var(--accent-dark); }
    .net-node.cat { background: var(--black); color: var(--light-gray); border: 1px solid var(--mid); }
    .net-caption {
      margin-top: 1rem;
      padding-top: 1rem;
      border-top: 1px solid var(--mid);
      color: var(--gray);
      font-size: 0.875rem;
      line-height: 1.55;
    }

    /* ========= 10. THE OTHER SIDE ========= */
    .side-grid {
      max-width: 1000px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
    .side-card {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      background: var(--black);
      border: 1px solid var(--mid);
      border-radius: 10px;
      padding: 2rem 1.75rem;
      text-decoration: none;
      transition: border-color 0.2s, background 0.2s;
    }
    .side-card:hover { border-color: var(--accent); background: var(--dark); }
    .side-card h3 { font-size: 1.25rem; font-weight: 600; color: var(--white); }
    .side-card p { color: var(--gray); line-height: 1.6; }
    .side-card .text-link { margin-top: auto; }

    /* ========= 11. CLOSE ========= */
    .built-on {
      background: var(--black);
      border-top: 1px solid var(--mid);
      border-bottom: 1px solid var(--mid);
      padding: 1.5rem 2rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem 1.5rem;
      align-items: center;
      justify-content: center;
      text-align: center;
    }
    .built-on-label {
      font-size: 0.8125rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--light-gray);
    }
    .built-on-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      justify-content: center;
      list-style: none;
    }
    .built-on-list li {
      font-family: var(--mono);
      font-size: 0.8125rem;
      color: var(--off-white);
      padding: 0.3rem 0.7rem;
      border: 1px solid var(--mid);
      border-radius: 3px;
      background: var(--near-black);
    }
    .cta-section h2 { font-size: clamp(1.75rem, 3.6vw, 2.75rem); letter-spacing: -0.03em; margin-bottom: 2rem; }

    /* ========= RESPONSIVE ========= */
    @media (max-width: 960px) {
      .story, .terms-top, .net { grid-template-columns: 1fr; gap: 2.5rem; }
      .options-grid, .have-grid { grid-template-columns: 1fr; max-width: 640px; margin: 0 auto; }
      .stack-grid { grid-template-columns: 1fr 1fr; }
      .offer-card-wrap { max-width: 460px; }
    }
    @media (max-width: 768px) {
      .band, .terms-section { padding: 4.5rem 1.5rem; }
      .sale-steps { grid-template-columns: 1fr; gap: 1.75rem; }
      .sale-steps li { padding-top: 0; padding-left: 3.25rem; }
      .sale-steps li:not(:last-child)::after {
        top: 2.75rem; bottom: -1.25rem; left: 1.125rem; right: auto;
        width: 1px; height: auto;
        background: linear-gradient(180deg, var(--accent), var(--mid));
      }
      .faq-grid, .side-grid { grid-template-columns: 1fr; }
      .table-card { padding: 1.25rem 1rem; }
    }
    @media (max-width: 560px) {
      .stack-grid { grid-template-columns: 1fr; }
      .net-panel { padding: 1rem 0.75rem; }
      .net-node { font-size: 0.625rem; padding: 0.3rem 0.4rem; }
      .net-node.hub { font-size: 0.75rem; padding: 0.5rem 0.6rem; }
    }
    @media (max-width: 400px) {
      .band, .terms-section { padding-left: 1rem; padding-right: 1rem; }
    }
  </style>
</head>
<body>

  <!-- 1. HERO -->
  <section class="hero">
    <SiteNav />

    <div class="hero-content">
      <div class="hero-badge">Open protocol · Apache 2.0</div>
      <h1 class="animate-in delay-1">Every AI agent is a customer.<br><em>FORA is your storefront.</em></h1>
      <p class="hero-sub animate-in delay-2">People are starting to search, research and buy through AI agents instead of websites. FORA lets any agent find your pages or tracks, read your license, pay, and get a signed receipt. You decide every term.</p>
      <div class="hero-buttons animate-in delay-3">
        <a href="/publishers/onboarding/" class="btn btn-primary">Check your website</a>
        <a href="/getting-started/live-demo-music/" class="btn btn-ghost">See a track licensed</a>
      </div>
      <nav class="hero-resources" aria-labelledby="hero-resources-label">
        <p class="hero-resources-label" id="hero-resources-label">Build with FORA</p>
        {BUILD_LINKS.map((p) => (
          <a
            target="_blank"
            rel="noopener noreferrer"
            title="Opens in a new tab"
            href={p.url}
            class={p.url === SERVER_URL ? 'is-server' : undefined}
          ><img src={p.icon} alt="" width="20" height="20" />{p.label}{p.url === SERVER_URL && <small>the full stack</small>}</a>
        ))}
      </nav>
    </div>
  </section>

  <!-- 2. AGENTS ARE THE NEW CUSTOMERS -->
  <section class="band band-black">
    <div class="wrap story">
      <div class="split-head">
        <div class="section-label">Why now</div>
        <h2>Agents are the new customers</h2>
      </div>
      <div class="story-body">
        <p>You don't care what the website of the shop that sells you cables looks like. You go where one interface covers every store, and that is why marketplaces won.</p>
        <p>AI agents are becoming that interface for everything: articles, music, data, files. Twenty years ago, “should we sell online?” was a real question. Today nobody asks it. Being readable and buyable by agents is going the same way.</p>
        <p class="story-turn">Until now, that kind of convenience came with a company in the middle that owned the customer, the ranking and the margin. <strong>FORA gives you the convenience without the middleman.</strong> It is an open protocol, so no single company owns the shelf, and your terms travel with your content.</p>
      </div>
    </div>
  </section>

  <!-- 3. BLOCK, ALLOW, OR LICENSE -->
  <section class="band band-near">
    <div class="wrap">
      <div class="section-header">
        <div class="section-label">Your options</div>
        <h2>Block, allow, or license</h2>
        <p>Agents already reach your content. Until now there were two options, and both were bad.</p>
      </div>
      <div class="options-grid">
        <article class="option">
          <div class="kicker">Option 1</div>
          <h3>Block them</h3>
          <p>You disappear from the place people now look.</p>
        </article>
        <article class="option">
          <div class="kicker">Option 2</div>
          <h3>Let them scrape</h3>
          <p>You lose any say in how your work is used.</p>
        </article>
        <article class="option option-fora">
          <div class="kicker">Option 3</div>
          <h3>License with FORA</h3>
          <p>Every request meets your terms. Agents find you, pay or attribute you, and every use is on record.</p>
        </article>
      </div>
      <p class="free-note"><strong>Free is a price too.</strong> Charge nothing and your terms still apply: attribution, permitted uses, and no AI training unless you offer it.</p>
    </div>
  </section>

  <!-- 4. CONTRACT → AGENT -->
  <section class="terms-section" data-examples>
    <div class="wrap">
      <div class="terms-top">
        <div class="terms-copy split-head">
          <div class="section-label">Your terms</div>
          <h2>If you can write it in a contract, an agent can read it</h2>
          <p>Licensing to AI usually breaks in one of two ways. Either the terms get simplified until a machine can follow them, or they stay in a PDF that no agent can act on.</p>
          <p>FORA turns your license into a signed offer that an agent understands: who may buy, for what use, where, for how long, at what price, and with which obligations. The agent still receives your full license document. <strong>Making terms machine-readable doesn't mean making them simpler.</strong></p>
        </div>
        <div class="offer-card-wrap">
          <div class="example-switch" role="group" aria-label="Example">
            {EXAMPLES.map((e, i) => (
              <button type="button" data-example-tab={e.id} aria-pressed={i === 0 ? 'true' : 'false'}>{e.tab}</button>
            ))}
          </div>
          {EXAMPLES.map((e) => (
            <div data-example={e.id}>
              <div class="offer-card" role="figure" aria-label={`An example signed offer for ${e.tab.toLowerCase()}, as an agent receives it`}>
                <div class="offer-card-head"><span>Signed offer</span><span>{e.offer.name}</span></div>
                <dl>
                  {e.offer.fields.map(([k, v]) => (
                    <><dt>{k}</dt><dd class={k === 'price' ? 'price' : undefined}>{v}</dd></>
                  ))}
                </dl>
                <div class="offer-sig">{e.offer.digest}<br />signed by the Exchange ✓</div>
              </div>
              <p class="offer-card-note">{e.offer.note}</p>
            </div>
          ))}
        </div>
      </div>

      <p class="sync-quote">That is why sync, the hardest kind of music licensing, still gets sold by email and rate-card PDF. Media, territory, term, cue sheets and exclusions are hard to express in a form a machine can act on. <strong>FORA expresses all of them.</strong></p>

      {EXAMPLES.map((e) => (
        <div class="table-card" data-example={e.id}>
          <h3>{e.title}</h3>
          <div class="table-scroll">
            <table class="example-table">
              <colgroup><col class="col-label" /><col /><col /><col /></colgroup>
              <thead>
                <tr><td></td>{e.cols.map((h) => <th scope="col">{h}</th>)}</tr>
              </thead>
              <tbody>
                {e.rows.map((r) => (
                  <tr class={r.price ? 'price' : undefined}>
                    <th scope="row">{r.label}</th>
                    {r.cells.map((c) => <td>{c}</td>)}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="table-note">{e.note}</p>
        </div>
      ))}

      <p class="terms-live">Both demos run on a live exchange. You can try them today.</p>
      <div class="terms-links">
        <a href="/getting-started/poc-walkthrough/">See what an agent gets for an article &rarr;</a>
        <a href="/getting-started/live-demo-music/">Watch an agent license a track &rarr;</a>
      </div>
    </div>
  </section>

  <!-- 5. HOW A SALE WORKS -->
  <section class="band band-black">
    <div class="wrap">
      <div class="section-header">
        <div class="section-label">How it works</div>
        <h2>How a sale works</h2>
      </div>
      <ol class="sale-steps">
        <li>
          <h3>Find</h3>
          <p>An agent searches across catalogs by what the content is about: topic, genre, mood, tempo, use.</p>
        </li>
        <li>
          <h3>License</h3>
          <p>It reads the offers, picks the one that fits the use, and pays through the Exchange.</p>
        </li>
        <li>
          <h3>Receive</h3>
          <p>It gets the file through a short-lived link bound to its identity. You both keep a signed receipt that anyone can verify later.</p>
        </li>
      </ol>
      <p class="center-link"><a class="text-link" href="/protocol/">See the full protocol flow &rarr;</a></p>
    </div>
  </section>

  <!-- 6. BUILT FOR WHAT YOU ALREADY HAVE -->
  <section class="band band-near">
    <div class="wrap">
      <div class="section-header">
        <div class="section-label">Ways in</div>
        <h2>Built for what you already have</h2>
      </div>
      <div class="have-grid">
        <article class="have-card">
          <div class="kicker">A website</div>
          <h3>Your pages, licensed</h3>
          <p>Set your terms in the publisher console and connect your CDN (Cloudflare or CloudFront). Your pages are imported from your sitemap. Nothing changes in your CMS, and readers see no difference.</p>
          <a class="text-link" href="/publishers/onboarding/">See what an agent gets for your page &rarr;</a>
        </article>
        <article class="have-card">
          <div class="kicker">A music catalog</div>
          <h3>All of your metadata, and the licenses you already sell</h3>
          <p>Personal, broadcast, advertising: whatever your rate card says, agents can now buy it. Your metadata comes through in the fields the industry uses (ISRC, ISWC, writers and publishers, PRO, mood, BPM, key, versions). Your own taxonomy comes through intact and searchable.</p>
          <p>The rights data a cue sheet needs travels with every license.</p>
          <a class="text-link" href="/getting-started/live-demo-music/">Watch an agent license a track &rarr;</a>
        </article>
        <article class="have-card">
          <div class="kicker">A marketplace you already run</div>
          <h3>It stays yours</h3>
          <p>Your catalog, search, ranking and delivery stay where they are. You publish a feed. Agents reach you through the same SDKs and MCP endpoint they use for every other FORA catalog, so you write no client library.</p>
          <a class="text-link" href="/getting-started/existing-marketplace/">Map your marketplace onto FORA &rarr;</a>
        </article>
      </div>
    </div>
  </section>

  <!-- 7. WHAT PEOPLE ASK -->
  <section class="band band-black">
    <div class="wrap">
      <div class="section-header">
        <div class="section-label">Questions</div>
        <h2>What people ask</h2>
      </div>
      <div class="faq-grid">
        {FAQ.map((f) => (
          <div class="faq-item">
            <h3>{f.q}</h3>
            <p set:html={f.a} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. THE WHOLE STACK, OR ONE PIECE -->
  <section class="band band-near">
    <div class="wrap">
      <div class="section-header">
        <div class="section-label">FORA Server</div>
        <h2>Use the whole stack, or one piece</h2>
        <p>FORA Server is not a sample app. It is a working stack: exchange, broker and search, identity and registration, content ingestion, an MCP endpoint, and edge protection. Launch it and you are selling.</p>
      </div>
      <div class="stack-grid">
        <article class="piece piece-full">
          <h3>Full stack</h3>
          <p>Everything above, ready to go.</p>
        </article>
        <article class="piece">
          <h3>Exchange only</h3>
          <p>Sell and settle through FORA. Keep your own storage and delivery.</p>
        </article>
        <article class="piece">
          <h3>Your own delivery</h3>
          <p>Serve files from your own node and CDN.</p>
        </article>
        <article class="piece">
          <h3>Edge enforcement</h3>
          <div class="toggle" aria-hidden="true"><span>On</span><span>Off</span></div>
          <p>Turn it on to point every unlicensed agent to your offer. Leave it off to rely on the terms alone.</p>
        </article>
      </div>
      <div class="stack-buttons">
        <a class="btn btn-primary" href={SERVER_URL}>Run FORA Server</a>
        <a class="btn btn-ghost" href="/architecture/deployment-models/">Deployment options</a>
      </div>
    </div>
  </section>

  <!-- 9. OPEN NETWORK -->
  <section class="band band-black">
    <div class="wrap net">
      <div class="net-copy split-head">
        <div class="section-label">Open network</div>
        <h2>Open means it gets better with every catalog</h2>
        <p>One SDK or one MCP connection lets an agent browse every FORA exchange and catalog. An agent registers and pays per exchange, but discovery works everywhere.</p>
        <p>Every new catalog makes FORA more useful to agents. Every new agent makes your catalog worth more. Existing marketplaces that speak FORA get the SDKs and interoperability for free, because the protocol is the same.</p>
      </div>
      <figure class="net-panel">
        <div class="net-diagram" id="netDiagram">
          <div class="net-col">
            <div class="net-col-label">Agents</div>
            <div class="net-node agent" data-net="agent">A1</div>
            <div class="net-node agent" data-net="agent">A2</div>
            <div class="net-node agent" data-net="agent">A3</div>
          </div>
          <div class="net-col">
            <div class="net-node hub" data-net="hub">FORA<small>SDK · MCP</small></div>
          </div>
          <div class="net-col">
            <div class="net-col-label">Exchanges</div>
            <div class="net-node ex" data-net="ex">Ex 1</div>
            <div class="net-node ex" data-net="ex">Ex 2</div>
            <div class="net-node ex" data-net="ex">Ex 3</div>
          </div>
          <div class="net-col">
            <div class="net-col-label">Catalogs</div>
            <div class="net-node cat" data-net="cat">News site</div>
            <div class="net-node cat" data-net="cat">Blog</div>
            <div class="net-node cat" data-net="cat">Label</div>
            <div class="net-node cat" data-net="cat">Music library</div>
            <div class="net-node cat" data-net="cat">Journal</div>
          </div>
          <canvas id="netCanvas" aria-hidden="true"></canvas>
        </div>
        <figcaption class="net-caption">One connection reaches every catalog. No deal to negotiate per buyer, and no integration to build per catalog.</figcaption>
      </figure>
    </div>
  </section>

  <!-- 10. THE OTHER SIDE -->
  <section class="band band-near">
    <div class="section-header">
      <div class="section-label">The other side</div>
      <h2>Building agents or running an Exchange?</h2>
    </div>
    <div class="side-grid">
      <a class="side-card" href="/getting-started/for-ai-agents/">
        <h3>I build AI agents</h3>
        <p>One integration covers every catalog. Content is licensed, signed and verifiable from any Exchange.</p>
        <span class="text-link">Agent quickstart &rarr;</span>
      </a>
      <a class="side-card" href="/getting-started/for-exchange-operators/">
        <h3>I run an Exchange</h3>
        <p>Aggregate catalogs, handle transactions, and earn a margin on every sale.</p>
        <span class="text-link">Exchange operator guide &rarr;</span>
      </a>
    </div>
  </section>

  <!-- 11. CLOSE -->
  <div class="built-on">
    <span class="built-on-label">Built on open standards</span>
    <ul class="built-on-list">
      <li>IAB Tech Lab CoMP</li>
      <li>RSL</li>
      <li>Web Bot Auth</li>
      <li>C2PA</li>
      <li>DDEX</li>
      <li>ISRC</li>
      <li>ISWC</li>
    </ul>
    <a class="text-link" href="/protocol/#standards">Full standards landscape &rarr;</a>
  </div>

  <section class="cta-section">
    <h2>One storefront. Every agent.</h2>
    <div class="cta-buttons">
      <a href="/publishers/onboarding/" class="btn btn-primary">Check your website</a>
      <a href="/getting-started/live-demo-music/" class="btn btn-ghost">See a track licensed</a>
    </div>
  </section>

  <SiteFooter />

  <script is:inline>
    // Lines between the network diagram's nodes, drawn from their real positions.
    function drawNet() {
      const box = document.getElementById('netDiagram');
      const canvas = document.getElementById('netCanvas');
      if (!box || !canvas) return;
      const dpr = window.devicePixelRatio || 1;
      canvas.width = box.offsetWidth * dpr;
      canvas.height = box.offsetHeight * dpr;
      const ctx = canvas.getContext('2d');
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, box.offsetWidth, box.offsetHeight);
      const r0 = box.getBoundingClientRect();
      const at = (el) => {
        const r = el.getBoundingClientRect();
        return { l: r.left - r0.left - 3, r: r.right - r0.left + 3, y: r.top - r0.top + r.height / 2 };
      };
      const line = (a, b) => { ctx.beginPath(); ctx.moveTo(a.r, a.y); ctx.lineTo(b.l, b.y); ctx.stroke(); };
      const q = (k) => [...box.querySelectorAll(`[data-net="${k}"]`)].map(at);
      const hub = q('hub')[0];
      const exs = q('ex');
      const cats = q('cat');
      ctx.strokeStyle = '#4f6df5';
      ctx.lineWidth = 1.5;
      ctx.globalAlpha = 0.55;
      q('agent').forEach((a) => line(a, hub));
      exs.forEach((e) => line(hub, e));
      ctx.globalAlpha = 0.22;
      ctx.lineWidth = 1;
      exs.forEach((e) => cats.forEach((c) => line(e, c)));
      ctx.globalAlpha = 1;
    }
    // The article / track switch in "If you can write it in a contract".
    document.querySelectorAll('[data-examples]').forEach((root) => {
      root.classList.add('js');
      const show = (id) => {
        root.querySelectorAll('[data-example]').forEach((el) => { el.hidden = el.dataset.example !== id; });
        root.querySelectorAll('[data-example-tab]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.exampleTab === id)));
      };
      root.querySelectorAll('[data-example-tab]').forEach((b) => b.addEventListener('click', () => show(b.dataset.exampleTab)));
      show(root.querySelector('[data-example-tab]').dataset.exampleTab);
    });

    window.addEventListener('load', drawNet);
    window.addEventListener('resize', drawNet);
    if (document.fonts) document.fonts.ready.then(drawNet);
  </script>

</body>
</html>
