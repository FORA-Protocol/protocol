  <script is:inline>
    // Per-step JSON payloads
    // Syntax colors for the example payloads
    const K = 'color:#9cdcfe';       // key
    const S = 'color:#7ec8a0';       // string
    const N = 'color:#d4a56a';       // number
    const B = 'color:#a5a5b8';          // brace
    const C = 'color:#a5a5b8;font-style:italic'; // comment
    const SIG = 'color:#9aaeff';  // signature (accent)

    const k = (v) => `<span style="${K}">"${v}"</span>`;
    const s = (v) => `<span style="${S}">"${v}"</span>`;
    const n = (v) => `<span style="${N}">${v}</span>`;
    const b = (v) => `<span style="${B}">${v}</span>`;
    const c = (v) => `<span style="${C}">${v}</span>`;

    const stepPayloads = [
      {
        label: 'WellKnownManifest',
        link: '/protocol/discovery-paths/',
        linkText: 'Discovery Paths docs →',
        json: `${c('// GET /.well-known/fora.json')}
${b('{')}
  ${k('ver')}: ${s('1.1')},
  ${k('role')}: ${s('ROLE_PUBLISHER')},
  ${k('domain')}: ${s('example.com')},
  ${k('exchanges')}: ${b('[{')}
    ${k('domain')}: ${s('exchange.example.com')},
    ${k('endpoint')}: ${s('/fora/v1')},
    ${k('relationship')}: ${s('DIRECT')}
  ${b('}]')}
${b('}')}`
      },
      {
        label: 'ResourceResponse → Offer',
        link: '/protocol/transaction-flow/',
        linkText: 'Transaction Flow docs →',
        json: `${c('// POST ExchangeService/DiscoverResources')}
${b('{')}
  ${k('offer_id')}: ${s('offer-4921')},
  ${k('title')}: ${s('Solar Panel Efficiency 2026')},
  ${k('pricing')}: ${b('{')}
    ${k('model')}: ${s('PER_UNIT')},
    ${k('rate')}: ${n('0.05')},
    ${k('unit')}: ${s('accesses')}
  ${b('}')},
  ${k('signature')}: <span style="${SIG}">"ed25519:a4c9f2e8..."</span>
${b('}')}`
      },
      {
        label: 'TransactionResponse',
        link: '/protocol/transaction-flow/#rpc-2-executetransaction',
        linkText: 'ExecuteTransaction docs →',
        json: `${c('// POST ExchangeService/ExecuteTransaction')}
${b('{')}
  ${k('transaction_id')}: ${s('txn-93a7f2')},
  ${k('billing_id')}: ${s('bill-93a7f2-001')},
  ${k('cost')}: ${b('{')}
    ${k('amount')}: ${n('0.05')},
    ${k('currency')}: ${s('USD')}
  ${b('}')},
  ${k('delivery_method')}: ${s('INSTRUCTIONS')}
${b('}')}`
      },
      {
        label: 'Signed URL + Verification',
        link: '/protocol/content-attestation/',
        linkText: 'Content Attestation docs →',
        json: `${c('// CDN delivery with identity binding')}
${b('{')}
  ${k('url')}: ${s('https://cdn.example.com/solar')},
  ${k('expires_at')}: ${s('2026-04-07T16:35:00Z')},
  ${k('agent_identity_hash')}: ${s('sha256:b7d1...')},
  ${k('content_hash')}: ${s('sha256:a1b2c3...')}
${b('}')}`
      },
      {
        label: 'UsageReport',
        link: '/protocol/transaction-flow/#rpc-3-reportusage',
        linkText: 'ReportUsage docs →',
        json: `${c('// POST ExchangeService/ReportUsage')}
${b('{')}
  ${k('transaction_id')}: ${s('txn-93a7f2')},
  ${k('function')}: ${s('AI_INPUT')},
  ${k('consumed_quantity')}: ${n('3247')},
  ${k('consumed_unit')}: ${s('tokens')},
  ${k('used_at')}: ${s('2026-04-07T16:35:12Z')}
${b('}')}`
      },
      {
        label: 'DisputeRequest → auto-resolve',
        link: '/protocol/dispute-resolution/',
        linkText: 'Dispute Resolution docs →',
        json: `${c('// POST ExchangeService/DisputeTransaction')}
${b('{')}
  ${k('transaction_id')}: ${s('txn-93a7f2')},
  ${k('reason')}: ${s('CONTENT_MISMATCH')},
  ${k('received_hash')}: ${s('sha256:e5f6a7...')},
  ${k('report_id')}: ${s('rpt-xyz789')}
${b('}')}
${c('// → AUTO_RESOLVED in <1s')}
${c('// → RESOLUTION_TYPE_CREDIT applied')}`
      }
    ];

    const steps = document.querySelectorAll('.flow-step');
    const jsonPanel = document.getElementById('flowJson');
    function setActiveStep(index) {
      steps.forEach((step, i) => {
        step.classList.toggle('active', i === index);
        step.querySelector('button').setAttribute('aria-pressed', String(i === index));
      });
      const payload = stepPayloads[index];
      jsonPanel.innerHTML = `<span class="payload-label">${payload.label}</span><pre class="payload-code">${payload.json}</pre><a class="payload-link" href="${payload.link}">${payload.linkText}</a>`;
    }

    steps.forEach((step, i) => {
      step.addEventListener('click', (event) => {
        if (!event.target.closest('a')) setActiveStep(i);
      });
    });
    setActiveStep(0);

    // Draw lines between actual DOM node positions on canvas
    function drawLines() {
      drawDiagramWithout();
      drawDiagramWith();
    }

    function nodeCenter(el, container) {
      const cr = container.getBoundingClientRect();
      const nr = el.getBoundingClientRect();
      const pad = 3; // gap so lines don't touch node edges
      return {
        x: nr.left - cr.left + nr.width / 2,
        y: nr.top - cr.top + nr.height / 2,
        r: nr.right - cr.left + pad,
        l: nr.left - cr.left - pad
      };
    }

    function drawDiagramWithout() {
      const container = document.getElementById('diagramWithout');
      const canvas = document.getElementById('canvasWithout');
      if (!container || !canvas) return;
      canvas.width = container.offsetWidth;
      canvas.height = container.offsetHeight;
      canvas.style.position = 'absolute';
      canvas.style.top = '0';
      canvas.style.left = '0';
      const ctx = canvas.getContext('2d');
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      const agents = container.querySelectorAll('[data-nxm="a"]');
      const platforms = container.querySelectorAll('[data-nxm="p"]');
      const pubs = container.querySelectorAll('[data-nxm="pub"]');

      // Agents → Platforms (spaghetti — every agent to every platform)
      ctx.strokeStyle = '#ccc';
      ctx.lineWidth = 1;
      agents.forEach(a => {
        platforms.forEach(p => {
          const from = nodeCenter(a, container);
          const to = nodeCenter(p, container);
          ctx.beginPath();
          ctx.moveTo(from.r, from.y);
          ctx.lineTo(to.l, to.y);
          ctx.stroke();
        });
      });

      // Platforms → Publishers (locked, dashed)
      ctx.strokeStyle = '#ddd';
      ctx.setLineDash([3, 3]);
      // TollBit → NYT, Reuters, AP
      [0,1,2].forEach(i => {
        if (pubs[i]) {
          const from = nodeCenter(platforms[0], container);
          const to = nodeCenter(pubs[i], container);
          ctx.beginPath(); ctx.moveTo(from.r, from.y); ctx.lineTo(to.l, to.y); ctx.stroke();
        }
      });
      // MS PCM → WSJ, Nature
      [3,4].forEach(i => {
        if (pubs[i]) {
          const from = nodeCenter(platforms[1], container);
          const to = nodeCenter(pubs[i], container);
          ctx.beginPath(); ctx.moveTo(from.r, from.y); ctx.lineTo(to.l, to.y); ctx.stroke();
        }
      });
      // Dappier → BMJ, MarketData
      [5,6].forEach(i => {
        if (pubs[i]) {
          const from = nodeCenter(platforms[2], container);
          const to = nodeCenter(pubs[i], container);
          ctx.beginPath(); ctx.moveTo(from.r, from.y); ctx.lineTo(to.l, to.y); ctx.stroke();
        }
      });
      ctx.setLineDash([]);
    }

    function drawDiagramWith() {
      const container = document.getElementById('diagramWith');
      const canvas = document.getElementById('canvasWith');
      if (!container || !canvas) return;
      canvas.width = container.offsetWidth;
      canvas.height = container.offsetHeight;
      canvas.style.position = 'absolute';
      canvas.style.top = '0';
      canvas.style.left = '0';
      canvas.style.gridColumn = '1 / -1';
      canvas.style.gridRow = '1';
      const ctx = canvas.getContext('2d');
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      const agents = container.querySelectorAll('[data-nxm="a2"]');
      const fora = container.querySelector('[data-nxm="fora"]');
      const exchanges = container.querySelectorAll('[data-nxm="ex"]');

      if (!fora) return;
      const foraPos = nodeCenter(fora, container);

      // Agents → FORA
      ctx.strokeStyle = '#4f6df5';
      ctx.lineWidth = 1.5;
      ctx.globalAlpha = 0.4;
      agents.forEach(a => {
        const from = nodeCenter(a, container);
        ctx.beginPath();
        ctx.moveTo(from.r, from.y);
        ctx.lineTo(foraPos.l, foraPos.y);
        ctx.stroke();
      });

      // FORA → Exchanges
      ctx.globalAlpha = 0.5;
      exchanges.forEach(ex => {
        const to = nodeCenter(ex, container);
        ctx.beginPath();
        ctx.moveTo(foraPos.r, foraPos.y);
        ctx.lineTo(to.l, to.y);
        ctx.stroke();
      });

      // Exchanges → Publishers (all connected — open access)
      const pubs2 = container.querySelectorAll('[data-nxm="pub2"]');
      ctx.globalAlpha = 0.2;
      ctx.lineWidth = 1;
      exchanges.forEach(ex => {
        pubs2.forEach(pub => {
          const from = nodeCenter(ex, container);
          const to = nodeCenter(pub, container);
          ctx.beginPath();
          ctx.moveTo(from.r, from.y);
          ctx.lineTo(to.l, to.y);
          ctx.stroke();
        });
      });
      ctx.globalAlpha = 1;
    }

    // Draw on load and resize
    window.addEventListener('load', () => setTimeout(drawLines, 100));
    window.addEventListener('resize', drawLines);

    // Also draw when scrolled into view
    const nxmObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) drawLines();
      });
    }, { threshold: 0.2 });
    document.querySelectorAll('.nxm-panel').forEach(p => nxmObserver.observe(p));

    // ========= Architecture Flow =========
    const archDetailEl = document.getElementById('archDetailInner');
    const archStepsList = document.getElementById('archStepsList');
    let currentScenario = 0;

    function party(name, isEx) {
      return `<span class="arch-party${isEx ? ' exchange' : ''}">${name}</span>`;
    }
    const arrow = '<span class="arch-step-arrow" aria-hidden="true">→</span>';

    const scenarios = [
      { title: 'Web article access',
        story: 'An AI research assistant needs a New York Times article for a user query. It tries to fetch the URL directly but hits the provider\u2019s edge function, which returns a 403 with a redirect to the FORA Exchange. The agent discovers the article is available for $0.05, commits to the offer, receives a time-limited signed URL, fetches the full article from the provider\u2019s CDN, and reports how many tokens it consumed.',
        steps: [
        { from: 'Agent', to: 'Edge', exFrom: false, exTo: false, desc: '403 redirect to Exchange', link: '/protocol/discovery-paths/', linkText: 'Discovery Paths →',
          json: `${c('// Agent hits publisher URL, gets 403')}\n${c('// X-Content-Rules header → Exchange')}\n\n${b('{')}\n  ${k('status')}: ${n('403')},\n  ${k('header')}: ${s('X-Content-Rules')},\n  ${k('exchange')}: ${s('exchange.example.com')}\n${b('}')}`},
        { from: 'Agent', to: 'Exchange', exFrom: false, exTo: true, desc: 'DiscoverResources request', link: '/protocol/transaction-flow/', linkText: 'Transaction Flow →',
          json: `${c('// POST DiscoverResources')}\n\n${b('{')}\n  ${k('requester')}: ${b('{')}\n    ${k('domain')}: ${s('agent.acme.com')}\n  ${b('}')},\n  ${k('uris')}: [${s('https://nyt.com/article')}],\n  ${k('acceptable_restrictions')}: [${b('{')} ${k('axis')}: ${s('FUNCTION')}, ${k('values')}: [${s('ai-input')}] ${b('}')}]\n${b('}')}`},
        { from: 'Exchange', to: 'Agent', exFrom: true, exTo: false, desc: 'Signed offers with pricing', link: '/protocol/transaction-flow/', linkText: 'Offer Response →',
          json: `${c('// ResourceResponse')}\n\n${b('{')}\n  ${k('offer_id')}: ${s('offer-4921')},\n  ${k('pricing')}: ${b('{')}\n    ${k('rate')}: ${n('0.05')},\n    ${k('unit_cost')}: ${n('0.000015')}\n  ${b('}')},\n  ${k('signature')}: <span style="${SIG}">"ed25519:a4c9..."</span>\n${b('}')}`},
        { from: 'Agent', to: 'Exchange', exFrom: false, exTo: true, desc: 'ExecuteTransaction', link: '/protocol/transaction-flow/#rpc-2-executetransaction', linkText: 'ExecuteTransaction →',
          json: `${c('// Commit to offer (full signed Offer reflected back)')}\n\n${b('{')}\n  ${k('offer')}: ${b('{')}\n    ${k('offer_id')}: ${s('offer-4921')},\n    ${k('pricing')}: ${b('{')} ${k('rate')}: ${s('0.05')} ${b('}')},\n    ${k('signature')}: <span style="${SIG}">"ed25519:a4c9..."</span>\n  ${b('}')}\n${b('}')}`},
        { from: 'Exchange', to: 'Billing', exFrom: true, exTo: false, desc: 'Billing authorization', link: '/getting-started/how-money-flows/', linkText: 'How Money Flows →',
          json: `${c('// Billing adapter (Stripe, x402, etc)')}\n\n${b('{')}\n  ${k('billing_id')}: ${s('bill-93a7f2')},\n  ${k('amount')}: ${n('0.05')},\n  ${k('status')}: ${s('AUTHORIZED')}\n${b('}')}`},
        { from: 'Exchange', to: 'Agent', exFrom: true, exTo: false, desc: 'Signed URL + billing_id', link: '/protocol/content-attestation/', linkText: 'Content Attestation →',
          json: `${c('// TransactionResponse')}\n\n${b('{')}\n  ${k('transaction_id')}: ${s('txn-93a7f2')},\n  ${k('billing_id')}: ${s('bill-93a7f2')},\n  ${k('url')}: ${s('https://cdn.nyt.com/...?sig=...')},\n  ${k('content_hash')}: ${s('sha256:a1b2...')}\n${b('}')}`},
        { from: 'Agent', to: 'Provider', exFrom: false, exTo: false, desc: 'Fetch article via signed URL', link: '/protocol/transaction-flow/', linkText: 'Signed URL Delivery →',
          json: `${c('// CDN verifies signed URL natively')}\n${c('// 5-min TTL, identity-bound')}\n\n${b('{')}\n  ${k('status')}: ${n('200')},\n  ${k('content_type')}: ${s('text/html')},\n  ${k('content_hash')}: ${s('sha256:a1b2...')} ${c('✓ match')}\n${b('}')}`},
        { from: 'Agent', to: 'Exchange', exFrom: false, exTo: true, desc: 'ReportUsage', link: '/protocol/transaction-flow/#rpc-3-reportusage', linkText: 'ReportUsage →',
          json: `${c('// Post-usage report')}\n\n${b('{')}\n  ${k('transaction_id')}: ${s('txn-93a7f2')},\n  ${k('function')}: ${s('AI_INPUT')},\n  ${k('consumed_quantity')}: ${n('3247')},\n  ${k('consumed_unit')}: ${s('tokens')}\n${b('}')}`}
      ]},
      { title: 'Music sample licensing',
        story: 'An AI music production tool needs a funk sample for a user\u2019s track. A song has two separate rights: the master recording (owned by the label or distributor) and the composition (owned by the songwriter\u2019s publisher). Traditionally, clearing both requires weeks of emails and lawyers. With FORA, the Broker queries two Exchanges \u2014 one for masters, one for compositions \u2014 and returns both offers in one response. The agent licenses both for $0.03 total, fetches the audio file and the MIDI notation, and reports usage to each rights holder.',
        steps: [
        { from: 'Agent', to: 'Broker', exFrom: false, exTo: false, desc: 'Search: "funk loop 120bpm clearable for AI"', link: '/protocol/discovery-paths/', linkText: 'Discovery Paths →',
          json: `${c('// AI music tool needs a sample')}\n${c('// Two rights needed: master + composition')}\n\n${b('{')}\n  ${k('query')}: ${s('funk loop 120bpm clearable')},\n  ${k('search_filters')}: ${b('{')}\n    ${k('music.genre')}: ${s('funk')},\n    ${k('music.bpm_range')}: ${s('115-125')}\n  ${b('}')},\n  ${k('supported_profiles')}: [${s('fora-music-v1')}]\n${b('}')}`},
        { from: 'Broker', to: 'Exchanges', exFrom: false, exTo: true, desc: 'Fan-out: label catalog + publishing catalog', link: '/protocol/transaction-flow/', linkText: 'Transaction Flow →',
          json: `${c('// Broker queries two Exchanges:')}\n${c('// Exchange A = label/distributor (masters)')}\n${c('// Exchange B = publisher (compositions)')}\n\n${c('// → Exchange A (DistroKid catalog)')}\n${b('{')}\n  ${k('uris')}: [${s('isrc:USRC11700001')}],\n  ${k('acceptable_restrictions')}: [${b('{')} ${k('axis')}: ${s('FUNCTION')}, ${k('values')}: [${s('ai-input')}] ${b('}')}]\n${b('}')}\n\n${c('// → Exchange B (Songtrust catalog)')}\n${b('{')}\n  ${k('uris')}: [${s('iswc:T-070.237.108-8')}],\n  ${k('acceptable_restrictions')}: [${b('{')} ${k('axis')}: ${s('FUNCTION')}, ${k('values')}: [${s('ai-input')}] ${b('}')}]\n${b('}')}`},
        { from: 'Exchanges', to: 'Broker', exFrom: true, exTo: false, desc: 'Two offers: master recording + composition', link: '/protocol/transaction-flow/', linkText: 'Multi-Exchange Offers →',
          json: `${c('// Exchange A: master recording')}\n${b('{')}\n  ${k('offer_id')}: ${s('offer-master-4401')},\n  ${k('title')}: ${s('Funk Brothers - Get Up Loop')},\n  ${k('pricing')}: ${b('{')}\n    ${k('model')}: ${s('PER_UNIT')},\n    ${k('rate')}: ${n('0.02')},\n    ${k('unit')}: ${s('accesses')}\n  ${b('}')},\n  ${k('identity')}: ${b('{')}\n    ${k('canonical_url')}: ${s('isrc:USRC11700001')}\n  ${b('}')}\n${b('}')}\n\n${c('// Exchange B: composition')}\n${b('{')}\n  ${k('offer_id')}: ${s('offer-comp-8820')},\n  ${k('title')}: ${s('Get Up (Composition)')},\n  ${k('pricing')}: ${b('{')}\n    ${k('model')}: ${s('PER_UNIT')},\n    ${k('rate')}: ${n('0.01')},\n    ${k('unit')}: ${s('accesses')}\n  ${b('}')},\n  ${k('identity')}: ${b('{')}\n    ${k('canonical_url')}: ${s('iswc:T-070.237.108-8')}\n  ${b('}')}\n${b('}')}`},
        { from: 'Broker', to: 'Agent', exFrom: false, exTo: false, desc: 'Linked offers: $0.02 master + $0.01 composition', link: '/protocol/transaction-flow/', linkText: 'Offer Selection →',
          json: `${c('// Broker presents both as a bundle')}\n${c('// Agent sees total cost: $0.03')}\n\n${b('{')}\n  ${k('offers')}: [\n    ${b('{')}\n      ${k('title')}: ${s('Master: Funk Brothers Loop')},\n      ${k('rate')}: ${n('0.02')},\n      ${k('exchange')}: ${s('distrokid-exchange.com')}\n    ${b('}')},\n    ${b('{')}\n      ${k('title')}: ${s('Composition: Get Up')},\n      ${k('rate')}: ${n('0.01')},\n      ${k('exchange')}: ${s('songtrust-exchange.com')}\n    ${b('}')}\n  ],\n  ${k('total')}: ${n('0.03')}\n${b('}')}`},
        { from: 'Agent', to: 'Exchange A', exFrom: false, exTo: true, desc: 'ExecuteTransaction for master recording', link: '/protocol/transaction-flow/#rpc-2-executetransaction', linkText: 'ExecuteTransaction →',
          json: `${c('// Transaction 1: master recording')}\n\n${b('{')}\n  ${k('offer_id')}: ${s('offer-master-4401')},\n  ${k('transaction_id')}: ${s('txn-master-a1')},\n  ${k('cost')}: ${b('{')}\n    ${k('amount')}: ${n('0.02')},\n    ${k('currency')}: ${s('USD')}\n  ${b('}')}\n${b('}')}`},
        { from: 'Agent', to: 'Exchange B', exFrom: false, exTo: true, desc: 'ExecuteTransaction for composition', link: '/protocol/transaction-flow/#rpc-2-executetransaction', linkText: 'ExecuteTransaction →',
          json: `${c('// Transaction 2: composition rights')}\n\n${b('{')}\n  ${k('offer_id')}: ${s('offer-comp-8820')},\n  ${k('transaction_id')}: ${s('txn-comp-b2')},\n  ${k('cost')}: ${b('{')}\n    ${k('amount')}: ${n('0.01')},\n    ${k('currency')}: ${s('USD')}\n  ${b('}')}\n${b('}')}`},
        { from: 'Agent', to: 'CDN', exFrom: false, exTo: false, desc: 'Fetch audio (master) + notation (composition)', link: '/protocol/content-attestation/', linkText: 'Content Attestation →',
          json: `${c('// Two signed URLs, two fetches')}\n\n${c('// Master: audio/wav from label CDN')}\n${b('{')}\n  ${k('url')}: ${s('https://cdn.distrokid.com/...')},\n  ${k('content_type')}: ${s('audio/wav')},\n  ${k('content_hash')}: ${s('sha256:f1a2...')} ${c('✓')}\n${b('}')}\n\n${c('// Composition: MIDI from publisher')}\n${b('{')}\n  ${k('url')}: ${s('https://cdn.songtrust.com/...')},\n  ${k('content_type')}: ${s('audio/midi')},\n  ${k('content_hash')}: ${s('sha256:b3c4...')} ${c('✓')}\n${b('}')}`},
        { from: 'Agent', to: 'Exchanges', exFrom: false, exTo: true, desc: 'ReportUsage to both Exchanges', link: '/protocol/transaction-flow/#rpc-3-reportusage', linkText: 'ReportUsage →',
          json: `${c('// Usage report to each Exchange')}\n\n${c('// → Exchange A (master)')}\n${b('{')}\n  ${k('transaction_id')}: ${s('txn-master-a1')},\n  ${k('function')}: ${s('AI_INPUT')},\n  ${k('consumed_unit')}: ${s('seconds')},\n  ${k('consumed_quantity')}: ${n('8')}\n${b('}')}\n\n${c('// → Exchange B (composition)')}\n${b('{')}\n  ${k('transaction_id')}: ${s('txn-comp-b2')},\n  ${k('function')}: ${s('AI_INPUT')},\n  ${k('consumed_unit')}: ${s('bars')},\n  ${k('consumed_quantity')}: ${n('4')}\n${b('}')}`}
      ]}
    ];

    function renderArchSteps() {
      archStepsList.innerHTML = scenarios[currentScenario].steps.map((step, i) => `
        <button type="button" class="arch-step-row" aria-controls="archDetail" onclick="setArchStep(${i})">
          <span class="arch-step-num">${i + 1}</span>
          <span class="arch-step-parties">${party(step.from, step.exFrom)}${arrow}${party(step.to, step.exTo)}</span>
          <span class="arch-step-desc">${step.desc}</span>
        </button>`).join('');
    }

    function setArchStep(index) {
      const step = scenarios[currentScenario].steps[index];
      archStepsList.querySelectorAll('button').forEach((row, i) => {
        row.classList.toggle('active', i === index);
        row.setAttribute('aria-pressed', String(i === index));
      });
      archDetailEl.innerHTML = `
        <span class="payload-label">Step ${index + 1} — ${step.from} → ${step.to}</span>
        <div class="arch-transfer" aria-hidden="true">${party(step.from, step.exFrom)}<span class="transfer-line"></span>${party(step.to, step.exTo)}</div>
        <p class="payload-desc">${step.desc}</p>
        <pre class="payload-code">${step.json}</pre>
        <a class="payload-link" href="${step.link}">${step.linkText}</a>`;
    }

    function renderStory() {
      const scenario = scenarios[currentScenario];
      document.getElementById('archStory').innerHTML = scenario.story;
    }

    function switchScenario(idx) {
      currentScenario = idx;
      document.getElementById('archTab0').classList.toggle('active', idx === 0);
      document.getElementById('archTab1').classList.toggle('active', idx === 1);
      document.getElementById('archTab0').setAttribute('aria-pressed', String(idx === 0));
      document.getElementById('archTab1').setAttribute('aria-pressed', String(idx === 1));
      renderStory();
      renderArchSteps();
      setArchStep(0);
    }

    // Init
    renderStory();
    renderArchSteps();
    setArchStep(0);
  </script>

</body>
</html>
