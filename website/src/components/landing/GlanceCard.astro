---
// At a glance: the facts a reader acts on, as label and value pairs in
// groups, with the vendor and FORA side by side. The FORA heading is the only
// blue. A vendor page builds its groups with glanceGroups() from
// src/data/content-marketplaces.ts, so every vendor page has the same rows in
// the same order. A cell may hold inline HTML: a StatusTag (statusTag()), a
// citation marker (cite()), a link, <code>.
//
// It is a table, so screen readers get row and column headers. It sizes by
// its own width (a container query), not the window: below 640px of card
// width each row stacks into its label and two labelled values. Reads the
// band's colour variables, so it works on any tone.
//
//   <GlanceCard vendor="TollBit" groups={glanceGroups({ payer: ['…', FORA_CELLS.payer], … })} />
interface Props {
	vendor: string;
	groups: { name: string; rows: { label: string; cells: readonly [string, string] }[] }[];
	/** The table's accessible name. */
	label?: string;
}
const { vendor, groups, label = "At a glance" } = Astro.props;
---

<div class="glance">
	<div class="glance-card">
		<table aria-label={label}>
			<colgroup
				><col class="l"><col><col></colgroup
			>
			<thead>
				<tr
					><td></td><th scope="col">{vendor}</th><th scope="col" class="fora">FORA</th></tr
				>
			</thead>
			<tbody>
				{groups.map((g) => (
          <>
            <tr class="grp"><th colspan="3" scope="colgroup">{g.name}</th></tr>
            {g.rows.map((r) => (
              <tr>
                <th scope="row">{r.label}</th>
                <td data-col={vendor}><span class="v" set:html={r.cells[0]} /></td>
                <td data-col="FORA" class="fora"><span class="v" set:html={r.cells[1]} /></td>
              </tr>
            ))}
          </>
        ))}
			</tbody>
		</table>
	</div>
</div>

<style>
.glance {
	container-type: inline-size;
	margin-top: 2.5rem;
}
.glance-card {
	border: 1px solid var(--lp-rule);
	border-radius: 12px;
	background: var(--lp-surface);
	overflow: hidden;
}
table {
	width: 100%;
	border-collapse: collapse;
	table-layout: fixed;
	font-size: 0.9375rem;
	line-height: 1.5;
}
col.l {
	width: 21%;
}
thead th,
thead td {
	text-align: left;
	padding: 1rem 1.25rem 0.875rem;
	font-family: var(--mono);
	font-size: 0.75rem;
	font-weight: 500;
	text-transform: uppercase;
	letter-spacing: 0.08em;
	color: var(--lp-label);
	border-bottom: 1px solid var(--lp-rule);
}
thead th.fora {
	color: var(--lp-fora);
	box-shadow: inset 0 2px 0 var(--accent);
}
tbody th,
td {
	text-align: left;
	vertical-align: top;
	padding: 0.75rem 1.25rem;
	border-top: 1px solid var(--lp-rule);
}
tbody th {
	color: var(--lp-strong);
	font-weight: 600;
}
td {
	color: var(--lp-text);
}
.v {
	display: block;
	min-width: 0;
	overflow-wrap: break-word;
}
.v :global(.status-tag) {
	margin-right: 0.375rem;
}
.v :global(a) {
	color: var(--lp-link);
}
.v :global(code) {
	font-family: var(--mono);
	font-size: 0.875em;
	color: var(--lp-heading);
	overflow-wrap: anywhere;
}
tr.grp th {
	padding-top: 1.375rem;
	padding-bottom: 0.5rem;
	font-family: var(--mono);
	font-size: 0.75rem;
	font-weight: 500;
	letter-spacing: 0.1em;
	text-transform: uppercase;
	color: var(--lp-heading);
}
tr.grp + tr > * {
	border-top: 0;
}
tbody tr.grp:first-child th {
	border-top: 0;
}

@container (max-width: 640px) {
	table,
	tbody,
	tr,
	th,
	td {
		display: block;
		width: 100%;
	}
	thead,
	colgroup {
		display: none;
	}
	tbody tr {
		padding: 0.875rem 1.125rem;
		border-top: 1px solid var(--lp-rule);
	}
	tbody tr.grp {
		padding: 1.25rem 1.125rem 0.25rem;
	}
	tbody tr.grp:first-child {
		border-top: 0;
	}
	tbody tr.grp + tr {
		border-top: 0;
	}
	tbody th,
	td {
		border: 0;
		padding: 0;
	}
	tr.grp th {
		padding: 0;
		border: 0;
	}
	tbody th {
		margin-bottom: 0.375rem;
	}
	td {
		display: grid;
		grid-template-columns: 4.5rem minmax(0, 1fr);
		gap: 0.75rem;
		padding: 0.25rem 0;
	}
	td::before {
		content: attr(data-col);
		font-family: var(--mono);
		font-size: 0.6875rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--lp-label);
		padding-top: 0.2rem;
	}
	td.fora::before {
		color: var(--lp-fora);
	}
}
</style>
