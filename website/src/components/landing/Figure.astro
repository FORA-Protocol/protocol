---
// A hand-drawn figure: the image in a white frame (the drawings are on
// white, so they sit on any band), a caption with a bold title, and a
// "Text version" disclosure that holds the alt text, so every reader can get
// what the drawing says. Blue in a figure means FORA's path, and nothing else.
// The images are square PNGs under public/resources/<topic>/<page>/.
//
//   <Figure src="/resources/content-marketplaces/tollbit/tollbit-3.png"
//     title="Where the money goes, and who signs the license."
//     caption="TollBit pays you; the license is between you and the buyer."
//     alt="The buyer asks TollBit for a pass …" />
interface Props {
  src: string;
  /** The text version: the image's alt text, also shown in the disclosure. */
  alt: string;
  /** Bold, first in the caption. */
  title: string;
  /** Follows the title; may hold inline HTML. */
  caption?: string;
  width?: number;
  height?: number;
}
const { src, alt, title, caption, width = 1024, height = 1024 } = Astro.props;
---
<figure class="fig">
  <div class="fig-frame"><img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" /></div>
  <figcaption><b>{title}</b>{caption && <> <Fragment set:html={caption} /></>}</figcaption>
  <details>
    <summary>Text version</summary>
    <p>{alt}</p>
  </details>
</figure>

<style>
  .fig { margin: 0; min-width: 0; }
  .fig-frame { background: #fff; border: 1px solid var(--lp-rule); border-radius: 12px; padding: 0.75rem; }
  img { display: block; width: 100%; height: auto; border-radius: 6px; }
  figcaption { margin-top: 0.875rem; color: var(--lp-text); font-size: 0.9375rem; line-height: 1.5; }
  figcaption b { color: var(--lp-strong); font-weight: 600; }
  details { margin-top: 0.625rem; }
  summary {
    cursor: pointer;
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--lp-link);
  }
  summary::-webkit-details-marker { display: none; }
  summary::before { content: '\25B8'; transition: transform 0.15s; }
  details[open] summary::before { transform: rotate(90deg); }
  details p { margin-top: 0.625rem; padding-left: 0.875rem; border-left: 1px solid var(--lp-rule); color: var(--lp-text); font-size: 0.9375rem; line-height: 1.6; }
</style>
