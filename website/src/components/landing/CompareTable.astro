---
// The comparison table of a vendor page: one row per question, a column for
// the vendor and one for FORA (the only blue heading). A vendor page builds
// its rows with compareRows() from src/data/content-marketplaces.ts, so every
// page asks the same eight questions in the same order. Cells may hold inline
// HTML: links, <code>, citation markers.
//
// Below 760px each row becomes a card titled with its question, its two
// answers labelled, so the page never scrolls sideways. For more than two
// columns, use Scorecard. Reads the band's variables.
//
//   <CompareTable vendor="TollBit" rows={compareRows([[…, …], …])} />
interface Props {
	vendor: string;
	rows: { q: string; cells: readonly [string, string] }[];
	/** The table's accessible name. */
	label?: string;
}
const { vendor, rows, label } = Astro.props;
---

<div class="cmp-wrap">
	<table class="cmp" aria-label={label ?? `${vendor} and FORA, question by question`}>
		<colgroup
			><col class="q"><col><col></colgroup
		>
		<thead>
			<tr
				><th scope="col">The question</th><th scope="col">{vendor}</th><th scope="col" class="fora">FORA</th></tr
			>
		</thead>
		<tbody>
			{rows.map((r) => (
        <tr>
          <th scope="row">{r.q}</th>
          <td data-col={vendor}><span set:html={r.cells[0]} /></td>
          <td data-col="FORA" class="fora"><span set:html={r.cells[1]} /></td>
        </tr>
      ))}
		</tbody>
	</table>
</div>

<style>
.cmp-wrap {
	margin-top: 2.5rem;
}
.cmp {
	width: 100%;
	border-collapse: collapse;
	font-size: 0.9375rem;
	line-height: 1.5;
	table-layout: fixed;
}
col.q {
	width: 22%;
}
th,
td {
	text-align: left;
	vertical-align: top;
	padding: 0.875rem 1rem 0.875rem 0;
	border-top: 1px solid var(--lp-rule);
}
thead th {
	border-top: 0;
	font-family: var(--mono);
	font-size: 0.75rem;
	font-weight: 500;
	text-transform: uppercase;
	letter-spacing: 0.06em;
	color: var(--lp-label);
	padding-bottom: 0.625rem;
}
thead th.fora {
	color: var(--lp-fora);
}
tbody th {
	font-weight: 600;
	color: var(--lp-strong);
	padding-right: 1.5rem;
}
td {
	color: var(--lp-text);
	overflow-wrap: break-word;
}
td :global(a) {
	color: var(--lp-link);
}
td :global(code) {
	font-family: var(--mono);
	font-size: 0.875em;
	color: var(--lp-heading);
	overflow-wrap: anywhere;
}

@media (max-width: 760px) {
	.cmp,
	tbody,
	tr,
	th,
	td {
		display: block;
		width: 100%;
	}
	thead,
	colgroup {
		display: none;
	}
	tr {
		border: 1px solid var(--lp-rule);
		border-radius: 12px;
		background: var(--lp-surface);
		padding: 1rem 1.125rem;
		margin-bottom: 0.75rem;
	}
	tbody th {
		border-top: 0;
		padding: 0 0 0.5rem;
		font-size: 1.0625rem;
	}
	td {
		border-top: 1px solid var(--lp-rule);
		padding: 0.625rem 0 0.375rem;
	}
	td::before {
		content: attr(data-col);
		display: block;
		font-family: var(--mono);
		font-size: 0.6875rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--lp-label);
		margin-bottom: 0.25rem;
	}
	td.fora::before {
		color: var(--lp-fora);
	}
}
</style>
