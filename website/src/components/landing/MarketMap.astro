---
// The market map of the content-marketplaces hub (/resources/content-marketplaces/):
// one table, every player in the same columns, grouped by category of
// channel. FORA's row is pinned first and is the only blue. Column heads are
// the reader's questions. Cells hold inline HTML: citation markers (cite()),
// status tags (statusTag()), links.
//
// Wide, it is a table that runs a little wider than the band, up to 1320px,
// and scrolls inside its own box if the window is narrower than the table's
// minimum. Below 760px each row becomes a card titled with the player, its
// fields labelled with the column heads in order, so the page never scrolls
// sideways. Reads the band's variables.
//
//   <MarketMap columns={['Player', …]} fora={{ player: 'FORA', cells: […] }}
//     groups={[{ name: '1. Bot paywalls at your CDN', rows: [{ player: 'TollBit', cells: […] }] }]} />
interface Row {
  player: string;
  /** One HTML cell per column after the first. */
  cells: string[];
}
interface Props {
  /** Every column head, the player column first. */
  columns: string[];
  fora: Row;
  groups: { name: string; rows: Row[] }[];
  /** The table's accessible name. */
  label: string;
}
const { columns, fora, groups, label } = Astro.props;
const heads = columns.slice(1);
---
<div class="mm">
  <div class="mm-scroll">
    <table aria-label={label}>
      <colgroup>
        <col class="c-player" />
        {heads.map(() => <col />)}
      </colgroup>
      <thead>
        <tr>{columns.map((c) => <th scope="col">{c}</th>)}</tr>
      </thead>
      <tbody>
        <tr class="fora">
          <th scope="row">{fora.player}</th>
          {fora.cells.map((c, i) => <td data-col={heads[i]}><span class="v" set:html={c} /></td>)}
        </tr>
        {groups.map((g) => (
          <>
            <tr class="grp"><th colspan={columns.length} scope="colgroup">{g.name}</th></tr>
            {g.rows.map((r) => (
              <tr>
                <th scope="row">{r.player}</th>
                {r.cells.map((c, i) => <td data-col={heads[i]}><span class="v" set:html={c} /></td>)}
              </tr>
            ))}
          </>
        ))}
      </tbody>
    </table>
  </div>
</div>

<style>
  .mm { margin-top: 2.5rem; }
  /* Wider than the band where the window allows; 6rem of margin leaves room
     for a classic scrollbar, so the page never scrolls sideways. */
  @media (min-width: 1200px) {
    .mm {
      --mm-w: min(calc(100vw - 6rem), 1320px);
      width: var(--mm-w);
      margin-left: calc(50% - var(--mm-w) / 2);
    }
  }
  .mm-scroll { overflow-x: auto; border: 1px solid var(--lp-rule); border-radius: 12px; background: var(--lp-surface); }
  table { width: 100%; min-width: 1040px; border-collapse: collapse; table-layout: fixed; font-size: 0.8125rem; line-height: 1.45; }
  col.c-player { width: 11%; }
  th, td { text-align: left; vertical-align: top; padding: 0.75rem 0.625rem; border-top: 1px solid var(--lp-rule); }
  th:first-child { padding-left: 1rem; }
  th:last-child, td:last-child { padding-right: 1rem; }
  thead th {
    border-top: 0;
    padding-top: 1rem;
    padding-bottom: 0.75rem;
    font-family: var(--mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--lp-label);
    vertical-align: bottom;
  }
  tbody th { color: var(--lp-strong); font-weight: 600; font-size: 0.875rem; overflow-wrap: normal; hyphens: manual; }
  td { color: var(--lp-text); }
  .v { display: block; min-width: 0; overflow-wrap: break-word; }
  .v :global(a) { color: var(--lp-link); }
  .v :global(code) { font-family: var(--mono); font-size: 0.875em; color: var(--lp-heading); overflow-wrap: anywhere; }
  .v :global(.status-tag) { margin-right: 0.25rem; }

  /* FORA's row: pinned first, the only blue. */
  tr.fora > * { background: color-mix(in srgb, var(--accent) 9%, transparent); border-top: 0; }
  tr.fora th { color: var(--lp-fora); box-shadow: inset 3px 0 0 var(--accent); }

  tr.grp th {
    padding-top: 1.25rem;
    padding-bottom: 0.5rem;
    font-family: var(--mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--lp-heading);
  }
  tr.grp + tr > * { border-top: 0; }

  @media (max-width: 760px) {
    .mm-scroll { overflow: visible; border: 0; border-radius: 0; background: none; }
    table { min-width: 0; }
    table, tbody, tr, th, td { display: block; width: 100%; }
    thead, colgroup { display: none; }
    tbody tr { border: 1px solid var(--lp-rule); border-radius: 12px; background: var(--lp-surface); padding: 1rem 1.125rem; margin-bottom: 0.75rem; }
    tbody tr.fora { border-color: var(--accent); }
    tr.fora > * { background: none; }
    tr.fora th { box-shadow: none; }
    tbody tr.grp { border: 0; background: none; padding: 1.5rem 0 0.25rem; margin: 0; }
    th, td, th:first-child, th:last-child, td:last-child { padding-left: 0; padding-right: 0; }
    tbody th { border-top: 0; padding: 0 0 0.5rem; font-size: 1.0625rem; }
    tr.grp th { padding: 0; font-size: 0.75rem; }
    td { border-top: 1px solid var(--lp-rule); padding: 0.625rem 0 0.375rem; font-size: 0.9375rem; }
    tr.grp + tr > td { border-top: 1px solid var(--lp-rule); }
    td::before {
      content: attr(data-col);
      display: block;
      font-family: var(--mono);
      font-size: 0.6875rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--lp-label);
      margin-bottom: 0.25rem;
    }
  }
</style>
