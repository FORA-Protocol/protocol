---
// The AI rules generator: three choices in, the publisher's robots.txt block,
// response headers, HTML tags and manual steps out. The rules come from
// src/lib/ai-rules.ts, which renders the default here and every change in the
// browser, so the page reads right without scripts too.
import { buildRules, DEFAULT_CHOICES } from '../../lib/ai-rules';

const initial = buildRules(DEFAULT_CHOICES);
---
<div class="gen" data-gen>
  <fieldset class="gen-choices">
    <legend>Your choices</legend>
    <label><input type="checkbox" data-opt="visible" checked={DEFAULT_CHOICES.visible} /> <span><b>Stay visible in AI search and answers.</b> Let ChatGPT search, Claude, Perplexity and Copilot index and cite your pages.</span></label>
    <label><input type="checkbox" data-opt="contract" checked={DEFAULT_CHOICES.contract} /> <span><b>Attach the search-only contract.</b> Free search, and a fee for every other access.</span></label>
    <label><input type="checkbox" data-opt="eu" checked={DEFAULT_CHOICES.eu} /> <span><b>Add the EU reservation signals.</b> TDMRep and Content Signals: a machine-readable reservation of text and data mining.</span></label>
  </fieldset>

  <div class="gen-out">
    <section>
      <div class="gen-head"><h3>robots.txt</h3><button type="button" class="gen-copy" data-copy="robots">Copy</button></div>
      <p>Add it to the file at the root of your site. A crawler combines every group that names it, so this works next to the groups you already have.</p>
      <pre data-out="robots">{initial.robots}</pre>
    </section>
    <section>
      <div class="gen-head"><h3>Response headers</h3><button type="button" class="gen-copy" data-copy="headers">Copy</button></div>
      <p>Set them on every page, at your origin or on your CDN. Or use the HTML tags below instead.</p>
      <pre data-out="headers">{initial.headers}</pre>
    </section>
    <section>
      <div class="gen-head"><h3>HTML tags</h3><button type="button" class="gen-copy" data-copy="html">Copy</button></div>
      <p>The same signals, in the <code>&lt;head&gt;</code> of every page.</p>
      <pre data-out="html">{initial.html}</pre>
    </section>
    <section>
      <div class="gen-head"><h3>By hand</h3></div>
      <ul data-out="steps">{initial.steps.map((s) => <li set:html={s} />)}</ul>
    </section>
  </div>
</div>

<style>
  .gen { display: grid; grid-template-columns: minmax(0, 320px) minmax(0, 1fr); gap: 2.5rem; margin-top: 2.5rem; align-items: start; }
  .gen-choices { border: 1px solid var(--mid); border-radius: 12px; padding: 1.25rem; display: grid; gap: 1rem; background: var(--near-black); position: sticky; top: 1.5rem; }
  legend { padding: 0 0.5rem; color: var(--white); font-weight: 600; }
  label { display: grid; grid-template-columns: auto 1fr; gap: 0.75rem; color: var(--light-gray); line-height: 1.5; cursor: pointer; }
  label b { color: var(--white); font-weight: 600; display: block; }
  input[type='checkbox'] { width: 1.125rem; height: 1.125rem; margin-top: 0.2rem; accent-color: var(--accent); }
  .gen-out { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.75rem; min-width: 0; }
  .gen-head { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 0.375rem; }
  h3 { color: var(--white); font-size: 1.125rem; font-weight: 600; }
  .gen-out p { color: var(--light-gray); line-height: 1.55; margin-bottom: 0.75rem; }
  .gen-out code { font-family: var(--mono); font-size: 0.9em; }
  pre {
    margin: 0;
    padding: 1rem 1.25rem;
    border: 1px solid var(--mid);
    border-radius: 10px;
    background: var(--black);
    color: #7ec8a0;
    font-family: var(--mono);
    font-size: 0.8125rem;
    line-height: 1.65;
    overflow-x: auto;
    white-space: pre;
  }
  ul { list-style: none; display: grid; gap: 0.625rem; }
  ul :global(li) { color: var(--light-gray); line-height: 1.55; padding-left: 1.25rem; position: relative; }
  ul :global(li)::before { content: '→'; position: absolute; left: 0; color: var(--accent-text); }
  ul :global(a) { color: var(--accent-text); }
  .gen-copy {
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    padding: 0.35rem 0.75rem;
    border-radius: 6px;
    border: 1px solid var(--mid);
    background: var(--near-black);
    color: var(--off-white);
    cursor: pointer;
  }
  .gen-copy:hover { border-color: var(--accent-text); color: var(--white); }
  .gen-copy:focus-visible, input:focus-visible { outline: 2px solid var(--accent-text); outline-offset: 2px; }
  @media (max-width: 900px) {
    .gen { grid-template-columns: minmax(0, 1fr); }
    .gen-choices { position: static; }
  }
</style>

<script>
  import { buildRules } from '../../lib/ai-rules';

  document.querySelectorAll<HTMLElement>('[data-gen]').forEach((root) => {
    const opt = (k: string) => root.querySelector<HTMLInputElement>(`[data-opt="${k}"]`)!.checked;
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;

    const render = () => {
      const rules = buildRules({ visible: opt('visible'), contract: opt('contract'), eu: opt('eu') });
      out('robots').textContent = rules.robots;
      out('headers').textContent = rules.headers;
      out('html').textContent = rules.html;
      // The steps are fixed strings from ai-rules.ts, not user input.
      out('steps').innerHTML = rules.steps.map((s) => `<li>${s}</li>`).join('');
    };

    root.querySelectorAll<HTMLInputElement>('[data-opt]').forEach((i) => i.addEventListener('change', render));
    root.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
      b.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(out(b.dataset.copy!).textContent ?? '');
          b.textContent = 'Copied';
          setTimeout(() => { b.textContent = 'Copy'; }, 1500);
        } catch {
          // Clipboard blocked: the text stays selectable.
        }
      }),
    );
    render();
  });
</script>
