---
// A row of "read more" links at the end of a section.
interface Props {
  links: { href: string; text: string }[];
}
const { links } = Astro.props;
---
<div class="links">
  {links.map((l) => <a href={l.href}>{l.text} &rarr;</a>)}
</div>

<style>
  .links { display: flex; flex-wrap: wrap; gap: 0.75rem 2rem; margin-top: 2rem; }
  a { color: var(--lp-link); font-weight: 600; text-decoration: none; }
  a:hover { text-decoration: underline; }
</style>
