---
// A row of "read more" links at the end of a section. `stacked` sets them as
// a short list, one per line (the series navigation).
interface Props {
	links: { href: string; text: string }[];
	stacked?: boolean;
}
const { links, stacked = false } = Astro.props;
---

<div class:list={['links', { stacked }]}> {links.map((l) => <a href={l.href}>{l.text} &rarr;</a>)} </div>

<style>
.links {
	display: flex;
	flex-wrap: wrap;
	gap: 0.75rem 2rem;
	margin-top: 2rem;
}
.stacked {
	flex-direction: column;
	align-items: flex-start;
	gap: 0.625rem;
	margin-top: 1rem;
}
a {
	color: var(--lp-link);
	font-weight: 600;
	text-decoration: none;
}
a:hover {
	text-decoration: underline;
}
</style>
