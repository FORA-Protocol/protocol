---
// "Follow one article, side by side": what a publisher can see at each step
// after its article is used in an AI answer, in a pool today and in a
// collective on FORA. The money takes the same path in both columns; the left
// column's boxes are closed and the right column's are open. It is a real
// table, so the text needs no separate equivalent: a grid on a wide screen,
// one card per step on a narrow one. Drawn for a light band. Used on
// /resources/transparent-collective/.
interface Cell {
  /** The line in bold. */
  main: string;
  /** A second, lighter line. */
  sub?: string;
}
interface Props {
  /** The event the table follows, shown above it. */
  title: string;
  /** The two column heads: today, then FORA. */
  columns: [string, string];
  /** What the publisher puts in, before the steps. */
  input: { label: string; today: Cell; fora: Cell };
  steps: { label: string; today: Cell; fora: Cell }[];
  /** The key: the closed box, then the open box. */
  legend: [string, string];
  caption?: string;
}
const { title, columns, input, steps, legend, caption } = Astro.props;
---
<figure class="aj">
  <p class="aj-title">{title}</p>
  <table>
    <thead>
      <tr>
        <th scope="col"><span class="sr">Step</span></th>
        <th scope="col" class="h-today">{columns[0]}</th>
        <th scope="col" class="h-fora">{columns[1]}</th>
      </tr>
    </thead>
    <tbody>
      <tr class="aj-input">
        <th scope="row"><span class="aj-step">{input.label}</span></th>
        <td data-col={columns[0]}><div class="box plain"><b>{input.today.main}</b>{input.today.sub && <span>{input.today.sub}</span>}</div></td>
        <td data-col={columns[1]}><div class="box plain"><b>{input.fora.main}</b>{input.fora.sub && <span>{input.fora.sub}</span>}</div></td>
      </tr>
      {steps.map((s, i) => (
        <tr>
          <th scope="row"><span class="aj-num" aria-hidden="true">{i + 1}</span><span class="aj-step">{s.label}</span></th>
          <td data-col={columns[0]}><div class="box closed"><b>{s.today.main}</b>{s.today.sub && <span>{s.today.sub}</span>}</div></td>
          <td data-col={columns[1]}><div class="box open"><b>{s.fora.main}</b>{s.fora.sub && <span>{s.fora.sub}</span>}</div></td>
        </tr>
      ))}
    </tbody>
  </table>
  <p class="aj-key">
    <span><i class="k-closed"></i>{legend[0]}</span>
    <span><i class="k-open"></i>{legend[1]}</span>
  </p>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .aj {
    --aj-ink: #12121a;
    --aj-muted: #4a4a5c;
    --aj-rule: #d9d9e4;
    --aj-closed: #12121a;
    --aj-closed-text: #f5f5fa;
    --aj-closed-sub: #c0c0d0;
    --aj-open: #1f7a4d;
    --aj-open-soft: #f1faf5;
    margin: 2.5rem 0 0;
    color: var(--aj-ink);
  }
  .aj-title { font: 600 0.875rem var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--aj-muted); margin: 0 0 1.25rem; }
  table { width: 100%; border-collapse: collapse; display: block; }
  thead, tbody { display: block; }
  tr { display: grid; grid-template-columns: 9rem minmax(0, 1fr) minmax(0, 1fr); gap: 0 1.25rem; align-items: stretch; }
  th, td { display: block; padding: 0; text-align: left; font-weight: 400; }
  thead th { padding-bottom: 0.875rem; font-size: 1.25rem; font-weight: 700; letter-spacing: -0.01em; color: var(--aj-ink); }
  thead .h-fora { color: var(--aj-open); }
  tbody th { display: flex; align-items: center; gap: 0.625rem; padding-bottom: 1.25rem; }
  .aj-step { font-size: 1.0625rem; font-weight: 700; line-height: 1.3; color: var(--aj-ink); }
  .aj-num { flex: none; display: inline-grid; place-items: center; width: 1.75rem; height: 1.75rem; border-radius: 50%; background: #e6e6ee; font: 500 0.875rem var(--mono); color: var(--aj-ink); }
  /* Each cell holds its box and, under it, the line the money follows to the next step. */
  td { position: relative; padding-bottom: 1.25rem; }
  td::after { content: ''; position: absolute; left: 2rem; bottom: 0; width: 2px; height: 1.25rem; background: var(--aj-rule); }
  tbody tr:last-child th, tbody tr:last-child td { padding-bottom: 0; }
  tbody tr:last-child td::after { content: none; }
  .box { height: 100%; display: grid; align-content: center; gap: 0.2rem; padding: 0.875rem 1rem 0.875rem 3rem; border-radius: 10px; position: relative; font-size: 1rem; line-height: 1.4; }
  .box b { font-size: 1.0625rem; font-weight: 600; }
  .box::before { position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); width: 1.25rem; height: 1.25rem; border-radius: 3px; display: grid; place-items: center; font-size: 0.875rem; font-weight: 700; line-height: 1; }
  .box.closed { background: var(--aj-closed); color: var(--aj-closed-text); }
  .box.closed span { color: var(--aj-closed-sub); }
  .box.closed::before { content: ''; background: #4a4a5c; }
  .box.open { background: var(--aj-open-soft); border: 2px solid var(--aj-open); color: var(--aj-ink); }
  .box.open span { color: var(--aj-muted); }
  .box.open::before { content: '✓'; border: 2px solid var(--aj-open); color: var(--aj-open); background: #fff; }
  .box.plain { padding-left: 1rem; background: #fff; border: 1px dashed #a5a5b8; color: var(--aj-ink); }
  .box.plain b { font-weight: 500; font-size: 1rem; }
  .aj-key { display: flex; flex-wrap: wrap; gap: 0.5rem 1.75rem; margin: 1.5rem 0 0 10.25rem; font-size: 1rem; color: var(--aj-muted); }
  .aj-key span { display: inline-flex; align-items: center; gap: 0.5rem; }
  .aj-key i { display: inline-block; width: 1rem; height: 1rem; border-radius: 3px; }
  .k-closed { background: var(--aj-closed); }
  .k-open { background: #fff; border: 2px solid var(--aj-open); }
  figcaption { margin: 0.75rem 0 0 10.25rem; max-width: 44rem; font-size: 1rem; line-height: 1.6; color: var(--aj-muted); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  /* One card per step: today above, FORA below. */
  @media (max-width: 760px) {
    thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    tr { display: block; margin-bottom: 1rem; padding: 1rem; border: 1px solid var(--aj-rule); border-radius: 12px; background: #fff; }
    tbody tr:last-child { margin-bottom: 0; }
    tbody th, tbody tr:last-child th { padding-bottom: 0.75rem; }
    .aj-step { font-size: 1.125rem; }
    td { padding-bottom: 0.75rem; }
    td:last-child { padding-bottom: 0; }
    td::after { content: none; }
    td::before { content: attr(data-col); display: block; margin-bottom: 0.375rem; font: 500 0.875rem var(--mono); letter-spacing: 0.04em; text-transform: uppercase; color: var(--aj-muted); }
    td:last-child::before { color: var(--aj-open); }
    .box { height: auto; font-size: 0.9375rem; }
    .box b { font-size: 1rem; }
    .aj-key, figcaption { margin-left: 0; }
  }
</style>
