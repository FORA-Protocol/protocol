---
// A checked list of points, each a bold lead-in and a sentence.
interface Props {
  items: { title: string; text: string }[];
}
const { items } = Astro.props;
---
<ul class="points">
  {items.map((it) => (
    <li><span><b>{it.title}</b> {it.text}</span></li>
  ))}
</ul>

<style>
  .points { list-style: none; margin-top: 1.75rem; display: grid; gap: 0.875rem; }
  li { display: grid; grid-template-columns: auto 1fr; gap: 0.75rem; color: var(--lp-text); line-height: 1.55; }
  li::before { content: '✓'; color: var(--accent-text); font-weight: 700; }
  b { color: var(--lp-strong); font-weight: 600; }
</style>
