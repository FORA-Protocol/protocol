---
// A checked list of points, each a bold lead-in and a sentence. The text may
// hold inline HTML (a link, <code>, a citation marker). `numbered` makes it a
// checklist of tasks: numbered square boxes instead of ticks. Reads the
// band's variables, so it works on any tone.
//
// The ticks are blue, because blue means FORA: use the default for FORA's own
// points (what FORA does, what works today). `tone="neutral"` makes them grey
// for points that are a vendor's or nobody's in particular: where a vendor is
// ahead, a vendor's column, questions to ask. The numbered boxes are always
// grey.
//
//   <PointList tone="neutral" items={AHEAD} />
interface Props {
  /** A point may be text only, with no bold lead-in. */
  items: { title?: string; text: string }[];
  numbered?: boolean;
  tone?: 'fora' | 'neutral';
}
const { items, numbered = false, tone = 'fora' } = Astro.props;
const Tag = numbered ? 'ol' : 'ul';
---
<Tag class:list={['points', { numbered, neutral: tone === 'neutral' }]}>
  {items.map((it) => (
    <li><span>{it.title && <><b>{it.title}</b> </>}<Fragment set:html={it.text} /></span></li>
  ))}
</Tag>

<style>
  .points { list-style: none; margin-top: 1.75rem; display: grid; gap: 0.875rem; }
  li { display: grid; grid-template-columns: auto 1fr; gap: 0.75rem; color: var(--lp-text); line-height: 1.55; }
  li > span { min-width: 0; }
  li::before { content: '✓'; color: var(--lp-link); font-weight: 700; }
  .neutral li::before { color: var(--lp-label); }
  b { color: var(--lp-strong); font-weight: 600; }
  li :global(a) { color: var(--lp-link); }
  li :global(code) { font-family: var(--mono); font-size: 0.875em; color: var(--lp-heading); overflow-wrap: anywhere; }

  .numbered { counter-reset: ck; gap: 1rem; margin-top: 2rem; }
  .numbered li { counter-increment: ck; grid-template-columns: 1.75rem 1fr; gap: 0.875rem; line-height: 1.6; }
  .numbered li::before {
    content: counter(ck);
    width: 1.75rem;
    height: 1.75rem;
    display: grid;
    place-items: center;
    border: 1.5px solid var(--lp-label);
    border-radius: 4px;
    color: var(--lp-heading);
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 400;
    margin-top: 0.05rem;
  }
</style>
