---
// The Resources index: one card per topic, with its audience, its formats and
// the date it was last updated. The whole card is the link.
import type { Resource } from '../../data/resources';

interface Props {
  items: Resource[];
}
const { items } = Astro.props;
const fmt = (d: string) => new Date(`${d}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<ul class="cards">
  {items.map((r) => (
    <li>
      <a class="card" href={r.href}>
        <span class="card-audience">{r.audience}</span>
        <h3>{r.title}</h3>
        <p>{r.summary}</p>
        <span class="card-meta">
          <span class="card-formats">{r.formats.map((f) => <span>{f}</span>)}</span>
          <time datetime={r.updated}>{fmt(r.updated)}</time>
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .cards { list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 1rem; margin-top: 2.5rem; }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    height: 100%;
    padding: 1.5rem;
    border: 1px solid var(--mid);
    border-radius: 12px;
    background: var(--near-black);
    text-decoration: none;
    transition: border-color 0.15s ease;
  }
  .card:hover { border-color: var(--accent-text); }
  .card:focus-visible { outline: 2px solid var(--accent-text); outline-offset: 2px; }
  .card-audience { font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--accent-text); }
  h3 { color: var(--white); font-size: 1.25rem; font-weight: 700; letter-spacing: -0.01em; line-height: 1.3; }
  p { color: var(--light-gray); line-height: 1.6; flex: 1; }
  .card-meta { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.75rem; margin-top: 0.5rem; }
  .card-formats { display: flex; flex-wrap: wrap; gap: 0.375rem; }
  .card-formats span { font-family: var(--mono); font-size: 0.75rem; padding: 0.2rem 0.55rem; border-radius: 999px; border: 1px solid var(--mid); color: var(--off-white); }
  time { font-size: 0.8125rem; color: var(--gray); }
</style>
