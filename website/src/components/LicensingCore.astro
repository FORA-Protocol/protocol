const GROUPS = [...new Set(LICENSES.map((l) => l.group))];

// The term as an agent reads it, compact YAML with syntax colors.
const esc = (v: string) => v.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const k = (v: string) => `<span class="tk">${v}</span>`;
const e = (v: string) => `<span class="te">${esc(v)}</span>`;
const s = (v: string) => `<span class="ts">"${esc(v)}"</span>`;
const n = (v: string | number) => (typeof v === 'number' ? `<span class="tn">${v}</span>` : /^[0-9.]+$/.test(v) ? `<span class="ts">"${v}"</span>` : /^[A-Z_]+$/.test(v) ? e(v) : s(v));
const list = (xs: string[]) => `[${xs.map((x) => s(x)).join(', ')}]`;
function termYaml(t: Term): string {
  const out: string[] = [];
  out.push(`${k('semantics')}: ${e(t.semantics)}`);
  if (t.license) {
    out.push(`${k('license')}:`);
    for (const [key, v] of Object.entries(t.license)) out.push(`  ${k(key)}: ${s(v as string)}`);
  }
  if (t.scopes) out.push(`${k('scopes')}: ${list(t.scopes)}`);
  if (t.restrictions?.length) {
    out.push(`${k('restrictions')}:`);
    for (const r of t.restrictions) {
      out.push(`  - ${k('kind')}: ${e(r.kind)}`);
      if (r.permitted) out.push(`    ${k('permitted')}: ${list(r.permitted)}`);
      if (r.prohibited) out.push(`    ${k('prohibited')}: ${list(r.prohibited)}`);
    }
  }
  if (t.quotas?.length) {
    out.push(`${k('quotas')}:`);
    for (const q of t.quotas) out.push(`  - { ${k('metric')}: ${s(q.metric)}, ${k('limit')}: ${n(q.limit)}, ${k('window')}: ${e(q.window)} }`);
  }
  out.push(`${k('pricing')}:`);
  for (const [key, v] of Object.entries(t.pricing)) out.push(`  ${k(key)}: ${n(v)}`);
  if (t.obligations?.length) {
    out.push(`${k('obligations')}:`);
    for (const o of t.obligations) {
      out.push(`  - ${k('kind')}: ${e(o.kind)}`);
      out.push(`    ${k('trigger')}: ${e(o.trigger)}`);
      if (o.scope_license) out.push(`    ${k('scope_license')}: { ${k('id')}: ${s(o.scope_license)} }`);
      if (o.detail) out.push(`    ${k('detail')}: ${s(o.detail)}`);
      if (o.reporting) out.push(`    ${k('reporting')}: { ${k('window')}: ${s(o.reporting.window)}, ${k('required_fields')}: ${list(o.reporting.required_fields)} }`);
    }
  }
  return out.join('\n');
}

const SLIDES = [
  {
    title: 'Every license answers the same questions',
    text: 'Who may use it, for what, where, how much, at what price, for how long, and what they owe afterwards. Each question has a field, so one model fits an article, a track, a dataset or a design file.',
    kind: 'questions',
  },
  {
    title: 'One resource, many terms, one offer each',
    text: 'Attach as many terms as you sell: free for search, per fetch for AI answers, a subscription for one company. The agent gets one signed offer per term and buys the one it can honor. A subscription term is shown only to the subscriber\'s agents.',
    kind: 'offers',
  },
  {
    title: 'Fields when they can say it all, the document when they can\'t',
    text: 'An ENUMERATED term is complete in its fields. A REFERENCE_ONLY term makes your license document the authority, for agreements too conditional to list. Either way the price is machine-readable, and every field you state binds.',
    kind: 'semantics',
  },
  {
    title: 'Shared words, open to new ones',
    text: 'Uses, places and buyers come from shared vocabularies, so every agent reads them the same way. Common synonyms fold into one token. Anything else gets your own namespaced token. A restriction binds by default: an agent that cannot evaluate it must decline the term.',
    kind: 'vocab',
  },
  {
    title: 'Signed, with your document pinned',
    text: 'The Exchange signs each whole offer: the term, the price and the expiry. A Broker that relays it cannot change any of them. The license document travels by address with a sha256 digest, so anyone can tell whether the text they fetched is the text the offer was signed with.',
    kind: 'signed',
  },
];

const QUESTIONS = [
  ['Who may use it', 'restrictions · USER_TYPE', 'individual, academic, broadcaster…'],
  ['For what', 'restrictions · FUNCTION', 'ai-input, sync, editorial…'],
  ['Where', 'restrictions · GEOGRAPHY', '*, EU, GB, US…'],
  ['How much of it', 'quotas', '500,000 copies, 10 seats a month…'],
  ['Price and term', 'pricing', 'free, per unit, flat; months'],
  ['What they owe', 'obligations', 'attribution, notice, share-alike…'],
];
---
<section class="core-section" id="licensing-core">
  <div class="section-header">
    <div class="section-label">Universal Licensing Core</div>
    <h2>Any license, in one model an agent can act on</h2>
    <p>FORA doesn't ask you to fit a template. It breaks your license into the parts every license has, keeps your document as the reference, and signs the result.</p>
  </div>

  <div class="deck" data-deck>
    <div class="deck-viewport">
      <ol class="deck-track">
        {SLIDES.map((sl, i) => (
          <li class="slide" data-slide={i} aria-roledescription="slide" aria-label={`${i + 1} of ${SLIDES.length}`}>
            <div class="slide-copy">
              <span class="slide-num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{sl.title}</h3>
              <p>{sl.text}</p>
            </div>
            <div class="slide-art" aria-hidden="true">
              {sl.kind === 'questions' && (
                <div class="q-grid">
                  {QUESTIONS.map(([q, f, ex]) => (
                    <div class="q-card"><b>{q}</b><code>{f}</code><span>{ex}</span></div>
                  ))}
                </div>
              )}
              {sl.kind === 'offers' && (
                <div class="fan">
                  <div class="fan-node fan-res">One article</div>
                  <div class="fan-cols">
                    <div class="fan-col"><span class="fan-term">Term: search, free</span><span class="fan-arrow">↓</span><span class="fan-offer">Signed offer</span></div>
                    <div class="fan-col"><span class="fan-term">Term: AI answers, per fetch</span><span class="fan-arrow">↓</span><span class="fan-offer">Signed offer</span></div>
                    <div class="fan-col"><span class="fan-term fan-gated">Term: subscription<small>scope subscription:acme</small></span><span class="fan-arrow">↓</span><span class="fan-offer">Only for Acme's agents</span></div>
                  </div>
                </div>
              )}
              {sl.kind === 'semantics' && (
                <div class="sem">
                  <div class="sem-card"><code>ENUMERATED</code><p>The fields are the whole term. A link to your license text is optional.</p><span class="sem-bar"><i style="width:100%"></i></span><small>fields: complete</small></div>
                  <div class="sem-card"><code>REFERENCE_ONLY</code><p>The document is the authority. Price required; other fields optional.</p><span class="sem-bar"><i style="width:30%"></i></span><small>fields: price, plus what you choose</small></div>
                </div>
              )}
              {sl.kind === 'vocab' && (
                <div class="vocab">
                  <div><b>FUNCTION</b><span>ai-train</span><span>ai-input</span><span>search</span><span>sync</span><span>broadcast</span><span>editorial</span><span>manufacture</span><span class="v-more">+16</span></div>
                  <div><b>GEOGRAPHY</b><span>*</span><span>EU</span><span>EEA</span><span>GB</span><span>US</span><span class="v-more">any ISO code</span></div>
                  <div><b>USER_TYPE</b><span>individual</span><span>academic</span><span>non_profit</span><span>broadcaster</span><span class="v-more">+2</span></div>
                  <div><b>Your own</b><span class="v-vendor">vendor:productions</span><span class="v-vendor">vendor:podcast-ad</span></div>
                </div>
              )}
              {sl.kind === 'signed' && (
                <div class="sig">
                  <div class="sig-offer">
                    <span class="sig-head">Signed offer</span>
                    <span>term · restrictions, quotas, obligations</span>
                    <span>pricing · EUR 450, flat</span>
                    <span>expires_at · 2026-11-11T18:00Z</span>
                    <span class="sig-doc">license · uri + sha256:bfab…</span>
                    <span class="sig-by">signed by the Exchange ✓</span>
                  </div>
                </div>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
    <div class="deck-nav">
      <button type="button" class="deck-btn" data-deck-prev aria-label="Previous slide">←</button>
      <div class="deck-dots">
        {SLIDES.map((sl, i) => (
          <button type="button" class="deck-dot" data-deck-dot={i} aria-label={`Slide ${i + 1}: ${sl.title}`} aria-current={i === 0 ? 'true' : 'false'}></button>
        ))}
      </div>
      <button type="button" class="deck-btn" data-deck-next aria-label="Next slide">→</button>
    </div>
  </div>

  <div class="explorer" data-explorer>
    <div class="explorer-head">
      <h3>Try it on a license you know</h3>
      <p>Pick a license. Each clause goes to a field of one FORA term, or stays in the license document that the term pins.</p>
    </div>
    <div class="lic-picker" role="group" aria-label="License">
      {GROUPS.map((g) => (
        <div class="lic-group">
          <span class="lic-group-name">{g}</span>
          <div class="lic-chips">
            {LICENSES.filter((l) => l.group === g).map((l) => (
              <button type="button" class="lic-chip" data-lic-tab={l.id} aria-pressed={l.id === LICENSES[0].id ? 'true' : 'false'}>{l.name}</button>
            ))}
          </div>
        </div>
      ))}
    </div>

    {LICENSES.map((l) => (
      <div class="lic-panel" data-lic={l.id}>
        <div class="lic-map">
          <h4>{l.name}</h4>
          <p class="lic-blurb">{l.blurb}</p>
          <ul class="lic-rows">
            {l.rows.map((r) => (
              <li class={r.doc ? 'is-doc' : undefined}>
