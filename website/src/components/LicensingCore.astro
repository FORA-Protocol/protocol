---
// The Universal Licensing Core on /protocol/: five slides that explain the
// model, then a picker of familiar licenses, each mapped clause by clause to
// one LicenseTerm. The terms follow /protocol/licensing-terms/ and the vocab
// options in proto/fora/v1/fora.proto: registered tokens only, or a `vendor:`
// token where the registry has none. Digests are shortened placeholders.

type Restriction = { kind: string; permitted?: string[]; prohibited?: string[] };
type Obligation = {
  kind: string;
  trigger: string;
  detail?: string;
  scope_license?: string;
  reporting?: { window: string; required_fields: string[] };
};
type Term = {
  semantics: 'ENUMERATED' | 'REFERENCE_ONLY';
  license?: { id?: string; name?: string; uri?: string; uri_digest?: string };
  scopes?: string[];
  restrictions?: Restriction[];
  quotas?: { metric: string; limit: number; window: string }[];
  pricing: Record<string, string | number>;
  obligations?: Obligation[];
};
type Row = { says: string; goes: string; doc?: boolean };
type Lic = { id: string; group: string; name: string; blurb: string; rows: Row[]; term: Term; note?: string };

