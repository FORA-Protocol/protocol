          </ul>
          {l.note && <p class="lic-note">{l.note}</p>}
        </div>
        <div class="lic-term">
          <div class="lic-term-head"><span>LicenseTerm</span><span>{l.term.semantics}</span></div>
          <pre set:html={termYaml(l.term)} />
        </div>
      </div>
    ))}
    <p class="explorer-foot">Typical terms, simplified to show the mapping; each real license is the authority for itself. Digests are shortened. <a href="/protocol/licensing-terms/">The licensing terms specification &rarr;</a></p>
  </div>
</section>

