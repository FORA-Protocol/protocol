---
// The top navigation for the bespoke pages under src/pages/.
// Shared so the landing page and the onboarding preview cannot drift apart.
//
// `current` marks the entry for the page being rendered, which the publisher
// preview design calls for.
import { LANDING_PAGES, type LandingPageKey } from '../consts';

interface Props {
  current?: LandingPageKey;
}
const { current } = Astro.props;

// The landing pages come first; the docs and the code are set apart on the
// right, so a reader can tell "keep reading the story" from "go into the
// technical documentation".
---
<nav class="hero-nav" aria-label="Main">
  <a href="/" class="logo"><img src="/brand/fora-lockup-small-on-dark.svg" alt="FORA protocol, home" width="163" height="28" /></a>
  <button
    type="button"
    class="menu-btn"
    aria-label="Menu"
    aria-expanded="false"
    aria-controls="site-nav-links"
  >
    <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
      <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
    </svg>
  </button>
  <ul id="site-nav-links" class="nav-links">
    {LANDING_PAGES.map((p) => (
      <li>
        <a
          href={p.href}
          class={current === p.key ? 'on' : undefined}
          aria-current={current === p.key ? 'page' : undefined}
        >{p.label}</a>
      </li>
    ))}
    <li class="nav-sep" aria-hidden="true"></li>
    <li><a href="/getting-started/what-is-fora/" class="nav-docs">Docs <span aria-hidden="true">&rarr;</span></a></li>
    <li>
      <a href="https://github.com/FORA-Protocol/protocol" class="nav-gh" aria-label="GitHub">
        <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
        <span class="nav-gh-label">GitHub</span>
      </a>
    </li>
  </ul>
</nav>
<div class="nav-spacer" aria-hidden="true"></div>

<style>
  .hero-nav {
    position: relative;
    /* Above page content (the home hero uses 10), so the mobile menu covers it. */
    z-index: 20;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem clamp(16px, 4vw, 40px);
    max-width: 1100px;
    margin: 0 auto;
    width: 100%;
    /* Own line height, so a page's body line-height cannot shift the nav. */
    line-height: 1.25;
  }

  .logo {
    font-family: var(--sans);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    text-decoration: none;
    color: var(--off-white);
    text-transform: lowercase;
    display: inline-flex;
  }
  .logo img { display: block; height: 28px; width: auto; }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
    list-style: none;
  }
  .nav-sep {
    width: 1px;
    height: 1.25rem;
    margin-inline: -0.5rem;
    background: rgba(255, 255, 255, 0.16);
  }
  .nav-links a.nav-docs {
    padding: 0.45rem 0.95rem;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 999px;
    color: var(--off-white);
  }
  .nav-links a.nav-docs:hover { border-color: var(--accent-text); color: var(--white); }
  .nav-links a.nav-gh { display: inline-flex; align-items: center; gap: 0.5rem; margin-left: -0.75rem; }
  .nav-gh-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .nav-links a {
    color: var(--gray);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--off-white); }
  .nav-links a.on { color: var(--off-white); }

  .menu-btn, .nav-spacer { display: none; }

  /* Narrow screens. Without the script, the links move to their own row under
     the logo and wrap if they do not fit, so every destination stays reachable.
     The script sets data-menu, which turns the links into a menu behind the
     button. */
  @media (max-width: 768px) {
    .hero-nav {
      flex-wrap: wrap;
      row-gap: 0.75rem;
      padding-block: 1rem;
    }
    .nav-links {
      flex-wrap: wrap;
      gap: 0.25rem 1rem;
      width: 100%;
    }
    /* Taller tap targets for touch. */
    .nav-links a { display: inline-block; padding-block: 0.25rem; }

    /* The menu bar stays at the top while the page scrolls, so the menu
       can be opened from anywhere. The spacer keeps its place in the page. */
    .hero-nav[data-menu] {
      position: fixed;
      inset: 0 0 auto 0;
      height: 4.5rem;
      padding-block: 0;
      background: rgba(10, 10, 15, 0.85);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }
    .hero-nav[data-menu] + .nav-spacer {
      display: block;
      flex-shrink: 0;
      height: 4.5rem;
    }
    /* In-page anchors must not end up under the fixed bar. */
    :global(html:has(.hero-nav[data-menu])) { scroll-padding-top: 4.5rem; }

    .hero-nav[data-menu] .menu-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      padding: 0;
      background: none;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 6px;
      color: var(--off-white);
      cursor: pointer;
    }
    .hero-nav[data-menu] .menu-btn:focus-visible {
      outline: 2px solid var(--off-white);
      outline-offset: 2px;
    }
    .hero-nav[data-menu] .nav-links {
      position: absolute;
      top: 100%;
      left: clamp(16px, 4vw, 40px);
      right: clamp(16px, 4vw, 40px);
      width: auto;
      flex-direction: column;
      gap: 0;
      padding: 0.5rem;
      background: var(--dark);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 8px;
    }
    .hero-nav[data-menu='closed'] .nav-links { display: none; }
    .hero-nav[data-menu] .nav-links { align-items: stretch; text-align: left; }
    .hero-nav[data-menu] .nav-sep { width: auto; height: 1px; margin: 0.25rem 0.75rem; }
    .hero-nav[data-menu] .nav-links a.nav-docs { border: 0; border-radius: 0; padding: 0.75rem; }
    .hero-nav[data-menu] .nav-links a.nav-gh { margin-left: 0; display: flex; }
    .hero-nav[data-menu] .nav-gh-label { position: static; width: auto; height: auto; overflow: visible; clip: auto; }
    .hero-nav[data-menu] .nav-links a {
      display: block;
      padding: 0.75rem;
      font-size: 1rem;
    }
  }
</style>

<script>
  // Mobile menu. The button and the dropdown styles apply only at the mobile
  // breakpoint, so this has no effect on desktop.
  const nav = document.querySelector<HTMLElement>('.hero-nav');
  const btn = nav?.querySelector<HTMLButtonElement>('.menu-btn');
  if (nav && btn) {
    const setOpen = (open: boolean) => {
      nav.dataset.menu = open ? 'open' : 'closed';
      btn.setAttribute('aria-expanded', String(open));
    };
    setOpen(false);

    btn.addEventListener('click', () => setOpen(nav.dataset.menu !== 'open'));
    nav.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.dataset.menu === 'open') {
        setOpen(false);
        btn.focus();
      }
    });
    // Close when keyboard focus moves out of the nav, or on a click outside it.
    nav.addEventListener('focusout', (e) => {
      if (e.relatedTarget && !nav.contains(e.relatedTarget as Node)) setOpen(false);
    });
    document.addEventListener('click', (e) => {
      if (!nav.contains(e.target as Node)) setOpen(false);
    });
    // A menu left open on a narrow window must not stay "expanded" on desktop.
    matchMedia('(min-width: 769px)').addEventListener('change', () => setOpen(false));
  }
</script>
