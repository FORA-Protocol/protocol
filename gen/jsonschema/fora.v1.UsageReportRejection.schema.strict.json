{
  "$id": "fora.v1.UsageReportRejection.schema.strict.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "UsageReportRejection — a usage report could not be accepted.",
  "properties": {
    "reason": {
      "anyOf": [
        {
          "enum": [
            "USAGE_REPORT_REJECTION_REASON_TRANSACTION_NOT_FOUND",
            "USAGE_REPORT_REJECTION_REASON_DUPLICATE",
            "USAGE_REPORT_REJECTION_REASON_WINDOW_EXPIRED",
            "USAGE_REPORT_REJECTION_REASON_MISSING_REQUIRED_FIELDS",
            "USAGE_REPORT_REJECTION_REASON_MALFORMED"
          ],
          "type": "string"
        },
        {
          "maximum": 5,
          "minimum": 1,
          "type": "integer"
        }
      ],
      "description": "The rejection reason (defined-only, non-zero)",
      "title": "Usage Report Rejection Reason"
    }
  },
  "required": [
    "reason"
  ],
  "title": "Usage Report Rejection",
  "type": "object"
}
