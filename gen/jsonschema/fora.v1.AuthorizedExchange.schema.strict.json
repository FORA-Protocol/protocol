{
  "$id": "fora.v1.AuthorizedExchange.schema.strict.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "AuthorizedExchange — A Exchange authorized to sell this provider's resources.",
  "properties": {
    "domain": {
      "description": "Canonical domain of the Exchange, in the shape \"Request recipient\" defines\n in the file header.",
      "maxLength": 260,
      "pattern": "^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)*(:(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5][0-9]{4}|[1-9][0-9]{0,3}))?$",
      "type": "string"
    },
    "endpoint": {
      "default": "",
      "description": "FORA ExchangeService endpoint URL.",
      "type": "string"
    },
    "ext": {
      "description": "Extension point",
      "type": "object"
    },
    "ext_critical": {
      "description": "Critical extension keys (COSE crit pattern, RFC 9052).\n Lists keys within ext that the consumer MUST understand.\n Unknown keys in this list → reject with UNKNOWN_CRITICAL_EXTENSION.\n Empty (default) → all ext keys are safe to ignore.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "relationship": {
      "anyOf": [
        {
          "enum": [
            "PROVIDER_RELATIONSHIP_DIRECT",
            "PROVIDER_RELATIONSHIP_RESELLER"
          ],
          "type": "string"
        },
        {
          "maximum": 2147483647,
          "minimum": -2147483648,
          "type": "integer"
        }
      ],
      "description": "Relationship type (mirrors ads.txt DIRECT/RESELLER).",
      "title": "Provider Relationship"
    }
  },
  "required": [
    "domain",
    "relationship"
  ],
  "title": "Authorized Exchange",
  "type": "object"
}
